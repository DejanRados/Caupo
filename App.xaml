<Application x:Class="Caupo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusionskin ="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:local="clr-namespace:Caupo.Helpers"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/" 
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
       <ResourceDictionary>
            <Color x:Key="PrimaryButtonColor">#FF2FA4A9</Color>
            <Color x:Key="PrimaryButtonHoverColor">#FF35B5BA</Color>
            <Color x:Key="PrimaryButtonPressedColor">#FF279297</Color>
            <SolidColorBrush x:Key="PrimaryButtonBrush"    Color="{StaticResource PrimaryButtonColor}" />
            <SolidColorBrush x:Key="PrimaryButtonHoverBrush"  Color="{StaticResource PrimaryButtonHoverColor}" />
            <SolidColorBrush x:Key="PrimaryButtonPressedBrush"     Color="{StaticResource PrimaryButtonPressedColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3366FF66"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3366FF66"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#dedede"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ababab"/>

            <Color x:Key="PrimaryColor">#2FA4A9</Color>
            <!-- teal -->
            <Color x:Key="AccentColor">#3B82F6</Color>
            <!-- blue -->
            <Color x:Key="SuccessColor">#22C55E</Color>
            <!-- kasa -->
            <Color x:Key="WarningColor">#F59E0B</Color>
            <!-- analiza -->
            <Color x:Key="NeutralBorder">#CBD5E1</Color>
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="HoverFill">#0F172A0A</Color>
            <!-- 4% -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="NeutralBorderBrush" Color="{StaticResource NeutralBorder}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="HoverFillBrush" Color="{StaticResource HoverFill}"/>



            <!-- ========================================================= -->
            <!-- BUTTON COLORS                                             -->
            <!-- ========================================================= -->

            <Color x:Key="SecondaryButtonColor">#4F7F82</Color>
            <Color x:Key="SecondaryButtonHoverColor">#5D9194</Color>
            <Color x:Key="SecondaryButtonPressedColor">#416B6E</Color>

            <Color x:Key="CancelButtonColor">#6C757D</Color>
            <Color x:Key="CancelButtonHoverColor">#7B848C</Color>
            <Color x:Key="CancelButtonPressedColor">#565E64</Color>

            <Color x:Key="DestructiveButtonColor">#7B1E3B</Color>
            <Color x:Key="DestructiveButtonHoverColor">#96304F</Color>
            <Color x:Key="DestructiveButtonPressedColor">#5F162D</Color>

            <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}"/>
            <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{StaticResource SecondaryButtonHoverColor}"/>
            <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="{StaticResource SecondaryButtonPressedColor}"/>

            <SolidColorBrush x:Key="CancelButtonBrush" Color="{StaticResource CancelButtonColor}"/>
            <SolidColorBrush x:Key="CancelButtonHoverBrush" Color="{StaticResource CancelButtonHoverColor}"/>
            <SolidColorBrush x:Key="CancelButtonPressedBrush" Color="{StaticResource CancelButtonPressedColor}"/>

            <SolidColorBrush x:Key="DestructiveButtonBrush" Color="{StaticResource DestructiveButtonColor}"/>
            <SolidColorBrush x:Key="DestructiveButtonHoverBrush" Color="{StaticResource DestructiveButtonHoverColor}"/>
            <SolidColorBrush x:Key="DestructiveButtonPressedBrush" Color="{StaticResource DestructiveButtonPressedColor}"/>


            <!-- ========================================================= -->
            <!-- BASE ACTION BUTTON                                        -->
            <!-- ========================================================= -->

            <Style x:Key="BaseActionButtonStyle" TargetType="Button">
                
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>


            <!-- ========================================================= -->
            <!-- PRIMARY BUTTON                                            -->
            <!-- Spremi, Dodaj, U redu, Potvrdi                            -->
            <!-- ========================================================= -->

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryButtonHoverBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryButtonPressedBrush}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryButtonPressedBrush}"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- SECONDARY BUTTON                                          -->
            <!-- Izmijeni, Dodatne opcije                                  -->
            <!-- ========================================================= -->

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#154A6FA5"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SecondaryButtonHoverBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#254A6FA5"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SecondaryButtonPressedBrush}"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- CANCEL BUTTON                                             -->
            <!-- Otkaži, Odustani                                          -->
            <!-- ========================================================= -->

            <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource CancelButtonBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CancelButtonBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#156C757D"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CancelButtonHoverBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#256C757D"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CancelButtonPressedBrush}"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- DESTRUCTIVE BUTTON                                        -->
            <!-- Obriši, Storniraj, Deaktiviraj                            -->
            <!-- ========================================================= -->

            <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DestructiveButtonBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource DestructiveButtonBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource DestructiveButtonHoverBrush}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DestructiveButtonHoverBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource DestructiveButtonPressedBrush}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DestructiveButtonPressedBrush}"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- GHOST / HOME BUTTON                                       -->
            <!-- ========================================================= -->

            <Style x:Key="HomeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#182FA4A9"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#302FA4A9"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- ARTICLE BUTTON                                            -->
            <!-- ========================================================= -->

            <Style x:Key="ArticleButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="Background" Value="#182FA4A9"/>
                <Setter Property="BorderBrush" Value="#882FA4A9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#302FA4A9"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- TABLE BUTTON                                              -->
            <!-- ========================================================= -->

            <Style x:Key="TableButtonStyle" TargetType="{x:Type local:TableButton}">
                <Setter Property="Foreground" Value="#2D2D30"/>
                <Setter Property="Background" Value="#F7F8FA"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:TableButton}">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">

                                <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TableName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="5"
                                   HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Waiter}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="5"
                                   HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Total}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#EAF5F5"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#D5EBEC"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- SIDEBAR BUTTON                                            -->
            <!-- ========================================================= -->

            <Style x:Key="SidebarBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Width="28"
                                   VerticalAlignment="Center"/>

                                    <TextBlock Text="{TemplateBinding Content}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#302FA4A9"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#552FA4A9"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- NUMERIC / KEYPAD BUTTON                                   -->
            <!-- ========================================================= -->

            <Style x:Key="ModernNumericButtonStyle" TargetType="Button">
                <Setter Property="Margin">
                    <Setter.Value>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}" ConverterParameter="0.012">
                            <Binding.Converter>
                                <local:MultiplyConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Setter.Value>
                </Setter>

                <Setter Property="FontSize">
                    <Setter.Value>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" ConverterParameter="0.4">
                            <Binding.Converter>
                                <local:MultiplyConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Setter.Value>
                </Setter>

                <Setter Property="Background" Value="#552FA4A9"/>
                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="BorderBrush" Value="#553A3A42"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                                <Border.CornerRadius>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </Border.CornerRadius>

                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#302FA4A9"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#552FA4A9"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ========================================================= -->
            <!-- CLOSE BUTTON BASE                                         -->
            <!-- ========================================================= -->

            <Style x:Key="BaseCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="50"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="Red"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="35"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">

                                <TextBlock Text="{TemplateBinding Tag}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="Red"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#DBDBDB"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#FFCCCCCC"/>
                                    <Setter Property="Foreground" Value="DarkRed"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>




            <!-- ========================================================= -->
            <!-- CLOSE WINDOW                                              -->
            <!-- ========================================================= -->

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseCloseButtonStyle}">
                <Setter Property="Tag" Value="&#xE72B;"/>
            </Style>


            <!-- ========================================================= -->
            <!-- CLOSE APPLICATION                                         -->
            <!-- ========================================================= -->

            <Style x:Key="CloseAppButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseCloseButtonStyle}">
                <Setter Property="Tag" Value="&#xE8BB;"/>
            </Style>


            <!-- ========================================================= -->
            <!-- LEGACY ALIASES                                            -->
            <!-- Ostaju zbog postojećeg XAML-a                             -->
            <!-- ========================================================= -->

            <Style x:Key="OKButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

            <Style x:Key="CButtonStyle" TargetType="Button" BasedOn="{StaticResource DestructiveButtonStyle}"/>




            <Style x:Key="CategoryToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#2FA4A9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#2FA4A9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
