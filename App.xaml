                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlobalFontColor}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    Padding="2"
                    SnapsToDevicePixels="True"
                    Background="{TemplateBinding Background}"
                    HorizontalAlignment="Stretch">
                                <DataGridCellsPresenter x:Name="DataGridCellsPresenter" VerticalAlignment="Stretch"  HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>

