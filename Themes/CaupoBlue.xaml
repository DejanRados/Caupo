<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- CAUPO BLUE THEME                                      -->
    <!-- ===================================================== -->

    <!-- OSNOVA -->
    <SolidColorBrush x:Key="GlobalBackgroundColor" Color="#E5E9EC"/>
    <SolidColorBrush x:Key="HeaderBackgroundColor" Color="#35424D"/>
    <SolidColorBrush x:Key="GlobalFontColor" Color="#2D3943"/>
    <SolidColorBrush x:Key="GlobalBorderColor" Color="#992D3943"/>

    <!-- PRIMARY -->
    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="#356A7A"/>
    <SolidColorBrush x:Key="ThemePrimaryHoverBrush" Color="#427F90"/>
    <SolidColorBrush x:Key="ThemePrimaryPressedBrush" Color="#2C5967"/>
    <SolidColorBrush x:Key="ThemePrimaryForegroundBrush" Color="#FAFAFA"/>

    <!-- SECONDARY -->
    <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="#6FAFC0"/>
    <SolidColorBrush x:Key="ThemeSecondaryHoverBrush" Color="#83BECD"/>
    <SolidColorBrush x:Key="ThemeSecondaryPressedBrush" Color="#5C98A8"/>

    <!-- ACCENT -->
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#20B8D2"/>

    <!-- CANCEL -->
    <SolidColorBrush x:Key="ThemeCancelBrush" Color="#6C757D"/>
    <SolidColorBrush x:Key="ThemeCancelHoverBrush" Color="#7B848C"/>
    <SolidColorBrush x:Key="ThemeCancelPressedBrush" Color="#565E64"/>

    <!-- SELECTION -->
    <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#6FAFC0"/>
    <SolidColorBrush x:Key="ThemeSelectionHoverBrush" Color="#556FAFC0"/>

    <!-- SEMANTIČKE BOJE -->
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ThemeNeutralBorderBrush" Color="#CBD5E1"/>

    <!-- SJENA -->
    <Color x:Key="ThemeShadowColor">#26343D</Color>

    <!-- POVRŠINE I KONTROLE -->
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#F1F4F6"/>
    <SolidColorBrush x:Key="ThemeControlBrush" Color="#D7E0E6"/>
    <SolidColorBrush x:Key="ThemeMutedForegroundBrush" Color="#667A89"/>

    <!-- ARTIKLI -->
    <SolidColorBrush x:Key="ThemeArticleBrush" Color="#DCE5EA"/>
    <SolidColorBrush x:Key="ThemeArticleHoverBrush" Color="#CAD9E1"/>

    <!-- HEADER I OKVIRI -->
    <SolidColorBrush x:Key="ThemeHeaderForegroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ThemeOutlineBrush" Color="#8AA4B2"/>

    <!-- POSEBNE POVRŠINE -->
    <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#E0E7EC"/>
    <SolidColorBrush x:Key="ThemeReceiptBrush" Color="#F8FAFB"/>
    <SolidColorBrush x:Key="ThemeInputBrush" Color="#F8FAFB"/>
    <SolidColorBrush x:Key="ThemePopupBrush" Color="#F8FAFB"/>
    <SolidColorBrush x:Key="ThemeHeaderTextBrush" Color="#FAFAFA"/>

    <!-- KUHINJA - UNDO NOTIFIKACIJE -->
    <SolidColorBrush x:Key="ThemeKitchenUndoHeaderBrush" Color="#A5353B"/>
    <SolidColorBrush x:Key="ThemeKitchenUndoStampBrush" Color="#C62828"/>

</ResourceDictionary>
