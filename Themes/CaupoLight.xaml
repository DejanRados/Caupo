<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- CAUPO LIGHT THEME                                     -->
    <!-- ===================================================== -->

    <!-- OSNOVA -->
    <SolidColorBrush x:Key="GlobalBackgroundColor" Color="#F4F3EF"/>
    <SolidColorBrush x:Key="HeaderBackgroundColor" Color="#292724"/>
    <SolidColorBrush x:Key="GlobalFontColor" Color="#181B1B"/>

    <!-- PRIMARY -->
    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="#275A62"/>
    <SolidColorBrush x:Key="ThemePrimaryHoverBrush" Color="#326E77"/>
    <SolidColorBrush x:Key="ThemePrimaryPressedBrush" Color="#204B52"/>
    <!-- LIGHT -->
    <SolidColorBrush x:Key="ThemePrimaryForegroundBrush" Color="#FAFAFA"/>

    <!-- SECONDARY -->
    <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="#7BCFE0"/>
    <SolidColorBrush x:Key="ThemeSecondaryHoverBrush" Color="#91DAE8"/>
    <SolidColorBrush x:Key="ThemeSecondaryPressedBrush" Color="#63B8C9"/>

    <!-- ACCENT -->
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#16B5D4"/>

    <!-- CANCEL -->
    <SolidColorBrush x:Key="ThemeCancelBrush" Color="#6C757D"/>
    <SolidColorBrush x:Key="ThemeCancelHoverBrush" Color="#7B848C"/>
    <SolidColorBrush x:Key="ThemeCancelPressedBrush" Color="#565E64"/>

    <!-- SELECTION -->
    <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#7BCFE0"/>
    <SolidColorBrush x:Key="ThemeSelectionHoverBrush" Color="#557BCFE0"/>

    <!-- SEMANTIČKE BOJE -->
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ThemeNeutralBorderBrush" Color="#CBD5E1"/>

    <Color x:Key="ThemeShadowColor">#000000</Color>



</ResourceDictionary>