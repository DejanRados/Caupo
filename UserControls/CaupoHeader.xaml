<UserControl x:Class="Caupo.UserControls.CaupoHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="HeaderControl">

    <Grid Background="{DynamicResource HeaderBackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Image Source="pack://application:,,,/Images/dsoftlogosmall.png" Width="50" Height="50" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>

        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="{Binding Title, ElementName=HeaderControl}" Foreground="#FAFAFA" FontSize="25" Padding="5,0" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="SubtitleSeparator" Text="•" Foreground="#777777" FontSize="18" Margin="5,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=HeaderControl}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=HeaderControl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding Subtitle, ElementName=HeaderControl}" Foreground="#FAFAFA" FontSize="18" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Label x:Name="lblUlogovaniKorisnik" Grid.Column="1" Foreground="#FAFAFA" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <Button Style="{StaticResource CloseButtonStyle}" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="0" Margin="1" Click="CloseButton_Click"/>
    </Grid>

</UserControl>