<UserControl x:Class="Caupo.UserControls.TableFloatingMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="500"
             Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">

    <UserControl.Resources>
        <Style x:Key="TableFloatingMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0,12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemePopupBrush}"
            BorderBrush="{DynamicResource GlobalBorderColor}"
            BorderThickness="1" CornerRadius="12" Margin="10" >
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="10" ShadowDepth="5" Opacity="0.28"/>
        </Border.Effect>

        <StackPanel>
            <!-- ZAGLAVLJE: POVLAČENJE MENIJA OSTAJE AKTIVNO -->
            <Border x:Name="TitleBar" Height="76" Background="{DynamicResource ThemePrimaryBrush}"
                    CornerRadius="11,11,0,0" Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid Margin="17,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UREĐIVANJE STOLA" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                        <TextBlock x:Name="TableNameText" Text="Sto" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="⠿" FontSize="24" Opacity="0.65"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- PREIMENUJ STO -->
            <Button Style="{StaticResource TableFloatingMenuButtonStyle}" Click="RenameButton_Click">
                <Grid>
                    <TextBlock Text="Preimenuj sto" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RenameArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="RenamePanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Novi naziv stola" FontSize="13" Margin="0,0,0,8"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <TextBox x:Name="TableNameInput" Style="{StaticResource TextBoxCustom}"
                         Height="42" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="42" Style="{StaticResource CancelButtonStyle}"
                            Click="CloseSubMenuButton_Click">
                        <TextBlock Text="Odustani"/>
                    </Button>
                    <Button Grid.Column="2" Height="42" Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveNameButton_Click">
                        <TextBlock Text="Spremi"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- PROMIJENI VELIČINU -->
            <Button Style="{StaticResource TableFloatingMenuButtonStyle}" Click="ResizeButton_Click">
                <Grid>
                    <TextBlock Text="Promijeni veličinu" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="ResizeArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="ResizePanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Širina" FontSize="13" Margin="0,0,0,8"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <TextBox x:Name="WidthInput" Style="{StaticResource TextBoxCustom}"
                         Height="42" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>

                <TextBlock Text="Visina" FontSize="13" Margin="0,12,0,8"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <TextBox x:Name="HeightInput" Style="{StaticResource TextBoxCustom}"
                         Height="42" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>

                <TextBlock x:Name="ResizeErrorText"
                           Text="Širina i visina moraju biti između 40 i 500."
                           Foreground="#E53935" FontSize="11" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,9,0,0"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="42" Style="{StaticResource CancelButtonStyle}"
                            Click="CloseSubMenuButton_Click">
                        <TextBlock Text="Odustani"/>
                    </Button>
                    <Button Grid.Column="2" Height="42" Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveSizeButton_Click">
                        <TextBlock Text="Spremi"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- OBRIŠI STO -->
            <Button x:Name="DeleteButton" Style="{StaticResource TableFloatingMenuButtonStyle}"
                    Click="DeleteButton_Click">
                <Grid>
                    <TextBlock Text="Obriši sto" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="DeleteArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="DeletePanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Da li ste sigurni da želite obrisati ovaj sto?"
                           FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <TextBlock x:Name="DeleteTableNameText" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,14"
                           Foreground="{DynamicResource GlobalFontColor}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="42" Style="{StaticResource CancelButtonStyle}"
                            Click="CloseSubMenuButton_Click">
                        <TextBlock Text="Odustani"/>
                    </Button>
                    <Button Grid.Column="2" Height="42" Style="{StaticResource DestructiveButtonStyle}"
                            Click="ConfirmDeleteButton_Click">
                        <TextBlock Text="Obriši"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ZATVORI MENI -->
            <Button Style="{StaticResource CancelButtonStyle}" BorderThickness="1"
                    Height="44" Click="FinishButton_Click" Margin="12,14,12,12">
                <TextBlock Text="Zatvori meni" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
