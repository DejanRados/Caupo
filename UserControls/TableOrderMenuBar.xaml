<UserControl x:Class="Caupo.UserControls.TableOrderMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="500"
             Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">

    <UserControl.Resources>
        <Style x:Key="TableFloatingMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0,12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemePopupBrush}"
            BorderBrush="{DynamicResource GlobalBorderColor}"
            BorderThickness="1" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="12" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>

        <StackPanel >
            <!-- ZAGLAVLJE -->
            <Border x:Name="TitleBar" Height="76" Background="{DynamicResource ThemePrimaryBrush}"
                    CornerRadius="11,11,0,0">
                <Grid Margin="17,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NARUDŽBA" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                        <TextBlock x:Name="TableNameText" Text="Sto" FontSize="20" FontWeight="Bold"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PREBACI NA DRUGI STO -->
            <Button Style="{StaticResource TableFloatingMenuButtonStyle}" Click="MoveTableButton_Click">
                <Grid>
                    <TextBlock Text="Prebaci na drugi sto" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="MoveTableArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="MoveTablePanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Prebacivanje narudžbe na drugi sto." FontSize="13"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <Button Height="42" Style="{StaticResource CancelButtonStyle}"
                        Click="CloseSubMenuButton_Click">
                    <TextBlock Text="Odustani"/>
                </Button>
            </StackPanel>

            <!-- SPOJI STOLOVE -->
            <Button Style="{StaticResource TableFloatingMenuButtonStyle}" Click="MergeTablesButton_Click">
                <Grid>
                    <TextBlock Text="Spoji stolove" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="MergeTablesArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="MergeTablesPanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Spajanje narudžbe sa drugim stolom." FontSize="13"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource GlobalFontColor}"/>
                <Button Height="42" Style="{StaticResource CancelButtonStyle}"
                        Click="CloseSubMenuButton_Click">
                    <TextBlock Text="Odustani"/>
                </Button>
            </StackPanel>

            <!-- PREBACI KONOBARU -->
            <Button Style="{StaticResource TableFloatingMenuButtonStyle}" Click="ChangeWaiterButton_Click">
                <Grid>
                    <TextBlock Text="Prebaci konobaru" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="ChangeWaiterArrowTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel x:Name="ChangeWaiterPanel" Visibility="Collapsed" Margin="15,12,15,14">
                <TextBlock Text="Odaberite konobara:" FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,10" Foreground="{DynamicResource GlobalFontColor}"/>

                <ItemsControl x:Name="WaitersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TableFloatingMenuButtonStyle}"
                                    Click="WaiterButton_Click">
                                <TextBlock Text="{Binding Radnik}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Height="42" Style="{StaticResource CancelButtonStyle}"
                        Click="CloseSubMenuButton_Click" Margin="0,12,0,0">
                    <TextBlock Text="Odustani"/>
                </Button>
            </StackPanel>

            <!-- ZATVORI MENI -->
            <Button Style="{StaticResource CancelButtonStyle}" BorderThickness="1"
                    Height="44" Click="FinishButton_Click" Margin="12,14,12,12">
                <TextBlock Text="Zatvori meni" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
