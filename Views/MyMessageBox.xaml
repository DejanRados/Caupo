<Window x:Class="Caupo.Views.MyMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        Title="MyMessageBox">

    <Grid Background="#663A3A40">
        <Border Width="440" MinHeight="270" MaxHeight="470" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource ThemePopupBrush}" BorderBrush="{DynamicResource GlobalBorderColor}"
                HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="18" ShadowDepth="5" Opacity="0.28"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ZAGLAVLJE -->
                <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryBrush}"
                        CornerRadius="11,11,0,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEA74;" FontSize="28" FontWeight="ExtraLight"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="MessageTitle" Grid.Column="1" Text="Obavijest"
                                   FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- PORUKA -->
                <ScrollViewer Grid.Row="1" Margin="22,22,22,14" MaxHeight="270"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                    </ScrollViewer.Resources>

                    <TextBlock x:Name="MessageText" Text="Obavijest" FontSize="15"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                               Cursor="Hand" MouseLeftButtonUp="MessageText_MouseLeftButtonUp"/>
                </ScrollViewer>

                <!-- AKCIJA -->
                <Button x:Name="OkButton" Grid.Row="2" Width="170" Height="48"
                        HorizontalAlignment="Center" Margin="0,4,0,22"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="19"
                                   Margin="0,0,9,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                        <TextBlock Text="U redu" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
