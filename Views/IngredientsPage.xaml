<UserControl x:Class="Caupo.Views.IngredientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="IngredientsCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="IngredientsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="IngredientsSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="IngredientDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IngredientDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IngredientEditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource GlobalBackgroundColor}">

        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <uc:CaupoHeader Grid.Row="0" Title="Caupo - Namirnice" Close="CloseButton_Click"/>

            <!-- GORNJA TRAKA -->
            <Grid Grid.Row="1" Margin="24,12,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <uc:CaupoSearchBar x:Name="IngredientSearchBar" Grid.Column="0" Margin="0,0,12,0"
                                    SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Suggestions="{Binding SearchSuggestions}"
                                    SuggestionSelected="IngredientSearchBar_SuggestionSelected"
                                    FirstCommand="{Binding FirstIngredientCommand}"
                                    PreviousCommand="{Binding PreviousIngredientCommand}"
                                    NextCommand="{Binding NextIngredientCommand}"
                                    LastCommand="{Binding LastIngredientCommand}"/>

                <Grid Grid.Column="2" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnAdd" Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="BtnAdd_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60000;" FontSize="21" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dodaj" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnEdit" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="BtnEdit_Click" IsEnabled="{Binding HasSelectedIngredient}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60019;" FontSize="21" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Izmijeni" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDelete" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="BtnDelete_Click" IsEnabled="{Binding HasSelectedIngredient}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60033;" FontSize="21" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Obriši" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExport" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="BtnExport_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#xEC28;" FontSize="21" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Izvoz" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnImport" Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="3" Click="BtnImport_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#xEC26;" FontSize="21" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Uvoz" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- TABELA I DETALJI -->
            <Grid Grid.Row="2" Margin="24,4,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LISTA NAMIRNICA -->
                <Border Grid.Column="0" Style="{StaticResource IngredientsCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Namirnice" Style="{StaticResource IngredientsSectionTitle}"/>
                                <TextBlock Text="Pregled namirnica, cijena i kala" Style="{StaticResource IngredientsSectionDescription}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ListaNamirnica" Grid.Row="1" ItemsSource="{Binding IngredientFilter}"
                                  SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                                  SelectionChanged="ListaNamirnica_SelectionChanged"
                                  PreviewMouseLeftButtonDown="ListaNamirnica_PreviewMouseLeftButtonDown"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                  GridLinesVisibility="None" RowHeight="35" SelectionMode="Single"
                                  Foreground="{DynamicResource GlobalFontColor}" Background="Transparent"
                                  BorderThickness="0" HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ClipToBounds="True">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Namirnica" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Repromaterijal}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="JM" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JedinicaMjereName}" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nabavna" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NabavnaCijena, StringFormat={}{0:F2}}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Planska" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PlanskaCijena, StringFormat={}{0:F2}}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Kalo %" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kalo, StringFormat={}{0:0.##}}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="Prikazano: " Style="{StaticResource IngredientsSectionDescription}"/>
                            <TextBlock Text="{Binding VisibleCount}" Style="{StaticResource IngredientsSectionDescription}"/>
                            <TextBlock Text=" / " Style="{StaticResource IngredientsSectionDescription}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource IngredientsSectionDescription}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DETALJI NAMIRNICE -->
                <Border Grid.Column="2" Style="{StaticResource IngredientsCard}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Odabrana namirnica" Style="{StaticResource IngredientsSectionTitle}"/>
                            <TextBlock Text="Detalji namirnice" Style="{StaticResource IngredientsSectionDescription}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Namirnica" Style="{StaticResource IngredientDetailLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedIngredient.Repromaterijal}" Style="{StaticResource IngredientDetailValue}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Jedinica mjere" Style="{StaticResource IngredientDetailLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedJedinicaMjere.JedinicaMjere}" Style="{StaticResource IngredientDetailValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Nabavna cijena" Style="{StaticResource IngredientDetailLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedIngredient.NabavnaCijena, StringFormat={}{0:F2}}" Style="{StaticResource IngredientDetailValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Planska cijena" Style="{StaticResource IngredientDetailLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedIngredient.PlanskaCijena, StringFormat={}{0:F2}}" Style="{StaticResource IngredientDetailValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Kalo" Style="{StaticResource IngredientDetailLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedIngredient.Kalo, StringFormat={}{0:0.##}%}" Style="{StaticResource IngredientDetailValue}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- DODAVANJE / UREĐIVANJE -->
        <Grid x:Name="IngredientEditGrid" Panel.ZIndex="1000" Background="#77000000" Visibility="Collapsed">
            <Border Width="650" MaxHeight="620" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource GlobalBackgroundColor}" BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5" CornerRadius="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EditorTitle}" Foreground="{DynamicResource GlobalFontColor}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EditorDescription}" Foreground="{DynamicResource GlobalFontColor}" FontSize="12" Opacity="0.65" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Naziv namirnice" Style="{StaticResource IngredientEditorLabel}"/>
                            <TextBox x:Name="EditorNameTextBox" Height="40" Style="{StaticResource TextBoxCustom}"
                                     Text="{Binding EditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                            <TextBlock Text="Jedinica mjere" Style="{StaticResource IngredientEditorLabel}"/>
                            <ComboBox Height="40" ItemsSource="{Binding JediniceMjere}" SelectedItem="{Binding EditorUnit, Mode=TwoWay}"
                                      DisplayMemberPath="JedinicaMjere" VerticalContentAlignment="Center"
                                      Foreground="{DynamicResource GlobalFontColor}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Nabavna cijena" Style="{StaticResource IngredientEditorLabel}"/>
                            <TextBox Height="40" Style="{StaticResource TextBoxCustom}" HorizontalContentAlignment="Right"
                                     Text="{Binding EditorPurchasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Planska cijena" Style="{StaticResource IngredientEditorLabel}"/>
                            <TextBox Height="40" Style="{StaticResource TextBoxCustom}" HorizontalContentAlignment="Right"
                                     Text="{Binding EditorPlannedPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0">
                            <TextBlock Text="Kalo (%)" Style="{StaticResource IngredientEditorLabel}"/>
                            <TextBox Height="40" Style="{StaticResource TextBoxCustom}" HorizontalContentAlignment="Right"
                                     Text="{Binding EditorKalo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Negativna vrijednost označava povećanje mase, npr. kuhanjem riže."
                                       Foreground="{DynamicResource GlobalFontColor}" Opacity="0.65"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnIngredientEditCancel" Grid.Column="0" Height="44"
                                Style="{StaticResource CancelButtonStyle}" Click="BtnIngredientEditCancel_Click">
                            <TextBlock Text="Odustani" Foreground="{DynamicResource GlobalFontColor}"/>
                        </Button>

                        <Button x:Name="BtnIngredientEditSave" Grid.Column="2" Height="44"
                                Style="{StaticResource PrimaryButtonStyle}" Click="BtnIngredientEditSave_Click">
                            <TextBlock Text="Spremi" Foreground="#F5F5F5"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
