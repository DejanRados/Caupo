<UserControl x:Class="Caupo.Views.LicenseWizardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource GlobalBackgroundColor}"
             Foreground="{DynamicResource GlobalFontColor}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="WizardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="WizardInput" TargetType="TextBox" BasedOn="{StaticResource TextBoxCustom}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NASLOV -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CAUPO · LICENCIRANJE" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeAccentBrush}"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- POČETAK -->
            <StackPanel Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Dobro došli u Caupo" FontSize="26" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="Kupite licencu ili aktivirajte postojeću."
                           FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="Kupi licencu" Style="{StaticResource PrimaryButtonStyle}"
                        Height="52" Margin="0,0,0,12" Click="Purchase_Click" IsEnabled="{Binding NotBusy}"/>
                <Button Content="Aktiviraj licencu" Style="{StaticResource SecondaryButtonStyle}"
                        Height="52" Click="Activation_Click" IsEnabled="{Binding NotBusy}"/>
            </StackPanel>

            <!-- IZBOR LICENCE -->
            <ScrollViewer Visibility="{Binding IsPlans, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Width="900" HorizontalAlignment="Center" Margin="0,15,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="760"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Odaberite licencu" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,24"/>

                        <TextBlock Text="Plan licenciranja" Style="{StaticResource WizardLabel}"/>
                        <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                                  DisplayMemberPath="Name" Height="46" FontSize="16" Margin="0,0,0,22"/>

                        <TextBlock Text="Broj licenci" Style="{StaticResource WizardLabel}"/>
                        <TextBox Style="{StaticResource WizardInput}" Margin="0,0,0,22"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Način plaćanja" Style="{StaticResource WizardLabel}"/>
                        <ComboBox SelectedIndex="{Binding RenewalSelection, Mode=TwoWay}"
                                  Height="46" FontSize="16">
                            <ComboBoxItem Content="Pretplata"/>
                            <ComboBoxItem Content="Bez pretplate"/>
                        </ComboBox>

                        <TextBlock Text="{Binding RenewalDescription}" FontSize="14"
                                   TextWrapping="Wrap" Height="50" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeMutedForegroundBrush}"
                                   Margin="0,10,0,18"/>

                        <Border Background="{DynamicResource ThemeControlBrush}" CornerRadius="9" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Ukupna cijena odabranog perioda" FontSize="14"
                                           Foreground="{DynamicResource ThemeMutedForegroundBrush}"/>
                                <TextBlock Text="{Binding PriceDescription}" FontSize="23"
                                           FontWeight="SemiBold" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                            <Button Content="Nazad" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="135" Height="46" Margin="0,0,12,0" Click="Back_Click"/>
                            <Button Content="Dalje" Style="{StaticResource PrimaryButtonStyle}"
                                    Width="155" Height="46" Click="Next_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- PODACI KUPCA -->
            <ScrollViewer Visibility="{Binding IsCustomer, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="900" HorizontalAlignment="Center" Margin="0,8,0,20">
                    <TextBlock Text="Podaci firme" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Sva polja su obavezna." FontSize="14" Margin="0,0,0,22"
                               Foreground="{DynamicResource ThemeMutedForegroundBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="435"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="435"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,19">
                            <TextBlock Text="Naziv firme" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,19">
                            <TextBlock Text="Ime i prezime kontakt osobe" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.ContactName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,19">
                            <TextBlock Text="E-mail" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,19">
                            <TextBlock Text="Telefon" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,19">
                            <TextBlock Text="Adresa" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.Address, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,19">
                            <TextBlock Text="Grad / mjesto" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.City, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,19">
                            <TextBlock Text="Poštanski broj" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.PostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,19">
                            <TextBlock Text="Država" Style="{StaticResource WizardLabel}"/>
                            <ComboBox SelectedValue="{Binding CountryCode, Mode=TwoWay}"
                                      SelectedValuePath="Tag" Height="44" FontSize="16">
                                <ComboBoxItem Content="Odaberite državu" Tag="" IsEnabled="False"/>
                                <ComboBoxItem Content="Bosna i Hercegovina" Tag="BA"/>
                                <ComboBoxItem Content="Hrvatska" Tag="HR"/>
                                <ComboBoxItem Content="Srbija" Tag="RS"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,19">
                            <TextBlock Text="Poreski broj / JIB / OIB / PIB" Style="{StaticResource WizardLabel}"/>
                            <TextBox Style="{StaticResource WizardInput}"
                                     Text="{Binding Customer.TaxNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10"
                                    Visibility="{Binding ShowBiHFiscalRegion, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Entitet / fiskalna regija" Style="{StaticResource WizardLabel}"/>
                            <ComboBox SelectedValue="{Binding SelectedFiscalRegion, Mode=TwoWay}"
                                      SelectedValuePath="Tag" Height="44" FontSize="16">
                                <ComboBoxItem Content="Federacija Bosne i Hercegovine" Tag="FederacijaBiH"/>
                                <ComboBoxItem Content="Republika Srpska" Tag="RepublikaSrpska"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Nazad" Style="{StaticResource SecondaryButtonStyle}"
                                Width="135" Height="46" Margin="0,0,12,0" Click="Back_Click"/>
                        <Button Content="Dalje" Style="{StaticResource PrimaryButtonStyle}"
                                Width="155" Height="46" Click="Next_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PREGLED NARUDŽBE -->
            <StackPanel Width="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Provjerite podatke prije plaćanja" FontSize="22"
                           FontWeight="SemiBold" Margin="0,0,0,28"/>
                <TextBlock Text="{Binding SelectedPlanDescription}" FontSize="19" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding Customer.CompanyName}" FontSize="17" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Customer.Email}" FontSize="16" Margin="0,0,0,24"/>
                <Border Background="{DynamicResource ThemeControlBrush}" CornerRadius="9" Padding="20">
                    <TextBlock Text="{Binding PriceDescription}" FontSize="24" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding RenewalDescription}" TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource ThemeMutedForegroundBrush}" Margin="0,18,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button Content="Nazad" Style="{StaticResource SecondaryButtonStyle}"
                            Width="135" Height="46" Margin="0,0,12,0" Click="Back_Click"/>
                    <Button Content="Nastavi na plaćanje" Style="{StaticResource PrimaryButtonStyle}"
                            Width="210" Height="46" Click="Checkout_Click" IsEnabled="{Binding NotBusy}"/>
                </StackPanel>
            </StackPanel>

            <!-- PADDLE CHECKOUT -->
            <Grid Visibility="{Binding IsCheckout, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,8,0,12" Padding="20" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{DynamicResource ThemeAccentBrush}">
                        <wv2:WebView2 x:Name="PaddleWebView" Height="700"/>
                    </Border>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Nazad na pregled"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="180" Height="44" Click="CheckoutBack_Click"/>
                    <TextBlock Grid.Column="1" Text="Plaćanje obrađuje Paddle. Licencu izdaje Caupo server."
                               VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"
                               Margin="18,0,0,0" FontSize="13"
                               Foreground="{DynamicResource ThemeMutedForegroundBrush}"/>
                </Grid>
            </Grid>

            <!-- RUČNA AKTIVACIJA -->
            <StackPanel Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsActivation, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Unesite licencni ključ" FontSize="19" FontWeight="SemiBold"
                           Margin="0,0,0,16"/>
                <TextBox Style="{StaticResource WizardInput}"
                         Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,26"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Nazad" Style="{StaticResource SecondaryButtonStyle}"
                            Width="135" Height="46" Margin="0,0,12,0" Click="Back_Click"/>
                    <Button Content="Aktiviraj" Style="{StaticResource PrimaryButtonStyle}"
                            Width="155" Height="46" Click="ActivateLicense_Click"
                            IsEnabled="{Binding NotBusy}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeWarningBrush}"
                   HorizontalAlignment="Center" MinHeight="24" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
