<Window x:Class="Caupo.Views.SizeInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        UseLayoutRounding="True">

    <Grid Background="#663A3A40">
        <Border Width="460" MinHeight="320" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource ThemePopupBrush}"
                BorderBrush="{DynamicResource GlobalBorderColor}"
                HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="18" ShadowDepth="5" Opacity="0.28"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ZAGLAVLJE -->
                <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryBrush}"
                        CornerRadius="11,11,0,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE744;"
                                   FontSize="28" FontWeight="ExtraLight"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="SizeInputTitle" Grid.Column="1" Text="NOVE DIMENZIJE STOLA"
                                   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DIMENZIJE -->
                <Grid Grid.Row="1" Margin="24,28,24,24" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Širina" FontSize="14"
                               Foreground="{DynamicResource GlobalFontColor}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Visina" FontSize="14"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                    <TextBox x:Name="InputTextWidth" Grid.Row="2" Grid.Column="0"
                             Height="48" FontSize="20" Padding="8"
                             Style="{StaticResource TextBoxCustom}"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             PreviewMouseLeftButtonDown="InputText_PreviewMouseLeftButtonDown"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Background="Transparent" Foreground="{DynamicResource GlobalFontColor}"
                             CaretBrush="{DynamicResource GlobalFontColor}"
                             BorderBrush="{DynamicResource GlobalBorderColor}" BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="InputTextHeight" Grid.Row="2" Grid.Column="2"
                             Height="48" FontSize="20" Padding="8"
                             Style="{StaticResource TextBoxCustom}"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             PreviewMouseLeftButtonDown="InputText_PreviewMouseLeftButtonDown"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Background="Transparent" Foreground="{DynamicResource GlobalFontColor}"
                             CaretBrush="{DynamicResource GlobalFontColor}"
                             BorderBrush="{DynamicResource GlobalBorderColor}" BorderThickness="0,0,0,1"/>
                </Grid>

                <!-- AKCIJE -->
                <Grid Grid.Row="2" Margin="22,0,22,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton" Grid.Column="0" Height="48"
                            Style="{StaticResource CancelButtonStyle}" Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Text="&#60039;" FontSize="19" Margin="0,0,9,0"
                                       Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Odustani" FontSize="15"
                                       Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OKButton" Grid.Column="2" Height="48"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Text="&#xEAB2;" FontSize="19" Margin="0,0,9,0"
                                       Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="U redu" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="KeyboardHost" HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom" Background="Transparent"
                        Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</Window>
