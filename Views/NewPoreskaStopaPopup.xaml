<Window x:Class="Caupo.Views.NewPoreskaStopaPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poreska stopa"
                 WindowStartupLocation="CenterScreen"
 WindowStyle="None"
 WindowState="Maximized"
 AllowsTransparency="True"
 Background="Transparent"
>
    <Grid>
        <Border      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#33000000">
            <Border   Height="455" Width="420" CornerRadius="7"   HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0.5" BorderBrush="{DynamicResource GlobalFontColor}" Background="{DynamicResource GlobalBackgroundColor}">

                <Grid Margin="5">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- NASLOV -->

                    <TextBlock x:Name="PopupTitle"
                   Grid.Row="0"
                   Text="Nova poreska stopa"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource GlobalFontColor}"/>


                    <!-- POLJA -->

                    <Border Grid.Row="2"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>


                            <!-- ID -->

                            <Label Content="ID"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"
                       Grid.Row="0"
                       Grid.Column="0"/>

                            <Label x:Name="lblid"
                       Content="-"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"
                       Grid.Row="0"
                       Grid.Column="1"/>


                            <!-- OPIS -->

                            <Label Content="Opis"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"
                       Grid.Row="1"
                       Grid.Column="0"/>

                            <TextBox x:Name="txtOpis"
                         Style="{DynamicResource TextBoxCustom}"
                         Foreground="{DynamicResource GlobalFontColor}"
                         Background="Transparent"
                         Height="30"
                         Margin="5"
                         VerticalAlignment="Center"
                         BorderThickness="0,0,0,1"
                         Grid.Row="1"
                         Grid.Column="1"/>


                            <!-- POSTOTAK -->

                            <Label Content="Postotak"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"
                       Grid.Row="2"
                       Grid.Column="0"/>

                            <Grid Grid.Row="2"
                      Grid.Column="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtPostotak"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Height="30"
                             Margin="5"
                             VerticalAlignment="Center"
                             BorderThickness="0,0,0,1"
                             Grid.Column="0"/>

                                <TextBlock Text="%"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="5"
                               Grid.Column="1"/>

                            </Grid>


                            <!-- OZNAKA -->

                            <Label Content="Oznaka"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"
                       Grid.Row="3"
                       Grid.Column="0"/>

                            <TextBox x:Name="txtOznaka"
                         Style="{DynamicResource TextBoxCustom}"
                         Foreground="{DynamicResource GlobalFontColor}"
                         Background="Transparent"
                         Height="30"
                         Width="120"
                         Margin="5"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         BorderThickness="0,0,0,1"
                         Grid.Row="3"
                         Grid.Column="1"/>

                        </Grid>

                    </Border>


                    <!-- DUGMAD -->

                    <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">


                        <Button Width="110"
                    Height="42"
                    Margin="5"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE711;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                                <TextBlock Text="Otkaži"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                            </StackPanel>

                        </Button>


                        <Button Width="110"
                    Height="42"
                    Margin="5"
                    Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE74E;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                                <TextBlock Text="Spremi"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>
            </Border>
        </Border>
    </Grid>

</Window>