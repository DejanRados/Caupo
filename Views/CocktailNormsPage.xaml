<UserControl x:Class="Caupo.Views.CocktailNormsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <Grid x:Name="MainContent" Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                    -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0" Background="#323232">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="58"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   Margin="20,0,15,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock Text="Normativi koktela"
                           Foreground="#FAFAFA"
                           FontSize="21"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Sastav i količine pića u koktelu"
                           Foreground="#FAFAFA"
                           FontSize="11"
                           Opacity="0.70"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <Label x:Name="lblUlogovaniKorisnik"
                   Grid.Column="2"
                   Content="Ime i prezime"
                   Foreground="#FAFAFA"
                   FontSize="16"
                   Margin="10,0,15,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>

        </Grid>

        <!-- ========================================================= -->
        <!-- SADRŽAJ                                                   -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- IZBOR KOKTELA                                         -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0" Grid.Column="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="46"
                        Padding="5"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GlobalFontColor}"
                        Background="Transparent"
                        CornerRadius="10">

                    <DockPanel>

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60013;"
                                   Width="30"
                                   Margin="5,0"
                                   FontSize="22"
                                   FontWeight="ExtraLight"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxCustom}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 CaretBrush="{DynamicResource GlobalFontColor}"
                                 BorderBrush="Transparent"
                                 FontSize="15"
                                 Padding="5"
                                 VerticalContentAlignment="Center"
                                 GotFocus="TextBox_GotFocus"
                                 LostFocus="TextBox_LostFocus"/>

                    </DockPanel>

                </Border>

                <Popup IsOpen="{Binding IsSuggestionsOpen}"
                       PlacementTarget="{Binding ElementName=SearchTextBox}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Width="350">

                    <Border Background="{DynamicResource GlobalBackgroundColor}"
                            BorderBrush="{DynamicResource GlobalFontColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">

                        <ListBox ItemsSource="{Binding Suggestions}"
                                 MaxHeight="350"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 Background="{DynamicResource GlobalBackgroundColor}"
                                 BorderThickness="0"
                                 SelectionChanged="lstSuggestions_SelectionChanged"/>

                    </Border>

                </Popup>

                <Button x:Name="BtnFirst"
                        Grid.Column="1"
                        Width="46"
                        Height="46"
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Prethodni koktel"
                        Click="BtnFirst_Click">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               Text="&#60271;"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

                <Button x:Name="BtnLast"
                        Grid.Column="2"
                        Width="46"
                        Height="46"
                        Margin="8,0,0,0"
                        Padding="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Naredni koktel"
                        Click="BtnLast_Click">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               Text="&#60272;"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

            </Grid>

            <!-- ===================================================== -->
            <!-- PRETRAGA SASTOJAKA                                    -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0" Grid.Column="2">

                <Border Height="46"
                        Padding="5"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GlobalFontColor}"
                        Background="Transparent"
                        CornerRadius="10">

                    <DockPanel>

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60013;"
                                   Width="30"
                                   Margin="5,0"
                                   FontSize="22"
                                   FontWeight="ExtraLight"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchIngredientTextBox"
                                 Text="{Binding SearchTextIngredient, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxCustom}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 CaretBrush="{DynamicResource GlobalFontColor}"
                                 BorderBrush="Transparent"
                                 FontSize="15"
                                 Padding="5"
                                 VerticalContentAlignment="Center"
                                 GotFocus="TextBox_GotFocus"
                                 LostFocus="TextBox_LostFocus"/>

                    </DockPanel>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- PODACI O ODABRANOM KOKTELU                            -->
            <!-- ===================================================== -->

            <Border Grid.Row="2"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="12"
                    Padding="16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Odabrani koktel"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"/>

                        <TextBlock x:Name="lblPice"
                                   Text="{Binding SelectedPice.Artikl}"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <StackPanel Margin="20,0,0,0">

                            <TextBlock Text="Proizvodna cijena"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="{Binding ProizvodnaCijena, StringFormat={}{0:F2} KM}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <StackPanel Margin="24,0,0,0">

                            <TextBlock Text="Prodajna cijena"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="{Binding ProdajnaCijena, StringFormat={}{0:F2} KM}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <StackPanel Margin="24,0,0,0">

                            <TextBlock Text="Marža"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="{Binding Marza}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

            <Border Grid.Row="2"
                    Grid.Column="2"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="12"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="Sastojci"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Dvostrukim klikom dodaj sastojak u normativ koktela."
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="12"
                               Opacity="0.65"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <!-- ===================================================== -->
            <!-- NORMATIV KOKTELA                                      -->
            <!-- ===================================================== -->

            <Border Grid.Row="4"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="12"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Normativ koktela"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Dvostrukim klikom na stavku možeš promijeniti količinu."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <DataGrid x:Name="ListaNormativ"
                              Grid.Row="2"
                              ItemsSource="{Binding Norm}"
                              SelectedItem="{Binding SelectedNorm, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              MouseUp="ListaNormativ_MouseDoubleClick"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="None"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              BorderThickness="0"
                              BorderBrush="{DynamicResource GlobalFontColor}"
                              ClipToBounds="True"
                              SelectionMode="Single">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Sastojak" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Repromaterijal}"
                                                   TextWrapping="Wrap"
                                                   Padding="10"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Jed. mjere" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding JedinicaMjere}"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Cijena" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Cijena, StringFormat={}{0:F2}}"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Količina" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kolicina, StringFormat={}{0:F2}}"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Iznos" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Ukupno, StringFormat={}{0:F2}}"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="#" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                BorderBrush="#FF3232"
                                                BorderThickness="1"
                                                Width="40"
                                                Height="32"
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                       Text="&#xEA81;"
                                                       FontSize="18"
                                                       FontWeight="ExtraLight"
                                                       Foreground="{DynamicResource GlobalFontColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Button>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- ===================================================== -->
            <!-- RASPOLOŽIVI SASTOJCI                                  -->
            <!-- ===================================================== -->

            <Border Grid.Row="4"
                    Grid.Column="2"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="12"
                    Padding="10">

                <DataGrid x:Name="ListaNamirnica"
                          ItemsSource="{Binding IngredientFilter}"
                          SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          SelectionChanged="ListaNamirnica_SelectionChanged"
                          MouseUp="ListaNamirnica_MouseDoubleClick"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderThickness="0"
                          BorderBrush="{DynamicResource GlobalFontColor}"
                          ClipToBounds="True"
                          SelectionMode="Single">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Sastojak" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Artikl}"
                                               TextWrapping="Wrap"
                                               Padding="10"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Jed. mjere" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding JedinicaMjereName}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
