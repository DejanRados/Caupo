<UserControl x:Class="Caupo.Views.CocktailNormsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- COCKTAIL NORMS - COMMON STYLES                        -->
        <!-- ===================================================== -->

        <Style x:Key="CocktailNormsCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CocktailNormsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CocktailNormsSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent" Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <uc:CaupoHeader Grid.Row="0" Title="Caupo - Normativi koktela" Close="CloseButton_Click"/>

        <!-- ===================================================== -->
        <!-- TOP TOOLBAR                                           -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1" Margin="24,12,24,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- COCKTAIL SEARCH                                   -->
            <!-- ================================================= -->

            <Grid Grid.Column="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="48" Padding="5" BorderThickness="1" BorderBrush="#3F3F46" Background="Transparent" CornerRadius="6">

                    <DockPanel>

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60013;" Width="34" FontSize="22" FontWeight="ExtraLight"  Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxCustom}" Background="Transparent"  CaretBrush="{DynamicResource GlobalFontColor}" BorderBrush="Transparent" BorderThickness="0" FontSize="15" Padding="5,0" VerticalContentAlignment="Center" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>

                    </DockPanel>

                </Border>

                <Popup IsOpen="{Binding IsSuggestionsOpen}" PlacementTarget="{Binding ElementName=SearchTextBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="350">

                    <Border Background="{DynamicResource GlobalBackgroundColor}" BorderBrush="{DynamicResource GlobalFontColor}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <ListBox ItemsSource="{Binding Suggestions}" MaxHeight="350"  Background="{DynamicResource GlobalBackgroundColor}" BorderThickness="0" SelectionChanged="lstSuggestions_SelectionChanged"/>
                    </Border>

                </Popup>

                <Button x:Name="BtnFirst" Grid.Column="1" Width="48" Height="48" Margin="7,0,0,0" Padding="0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Prethodni koktel" Click="BtnFirst_Click">
                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60271;" FontSize="22" FontWeight="ExtraLight"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="BtnLast" Grid.Column="2" Width="48" Height="48" Margin="7,0,0,0" Padding="0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Naredni koktel" Click="BtnLast_Click">
                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60272;" FontSize="22" FontWeight="ExtraLight"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

            </Grid>

            <!-- ================================================= -->
            <!-- INGREDIENT SEARCH                                 -->
            <!-- ================================================= -->

            <Border Grid.Column="2" Height="48" Padding="5" BorderThickness="1" BorderBrush="#3F3F46" Background="Transparent" CornerRadius="6">

                <DockPanel>

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60013;" Width="34" FontSize="22" FontWeight="ExtraLight"  Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchIngredientTextBox" Text="{Binding SearchTextIngredient, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxCustom}" Background="Transparent"  CaretBrush="{DynamicResource GlobalFontColor}" BorderBrush="Transparent" BorderThickness="0" FontSize="15" Padding="5,0" VerticalContentAlignment="Center" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>

                </DockPanel>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2" Margin="24,4,24,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- COCKTAIL NORM                                     -->
            <!-- ================================================= -->

            <Border Grid.Column="0" Style="{StaticResource CocktailNormsCard}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ========================================= -->
                    <!-- SELECTED COCKTAIL                         -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="0" Margin="16,12,16,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                            <TextBlock Text="Odabrani koktel" Style="{StaticResource CocktailNormsSectionDescription}"/>

                            <TextBlock x:Name="lblPice" Text="{Binding SelectedPice.Artikl}"  FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="Proizvodna cijena" Style="{StaticResource CocktailNormsSectionDescription}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ProizvodnaCijena, StringFormat={}{0:F2} KM}"  FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Text="Prodajna cijena" Style="{StaticResource CocktailNormsSectionDescription}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ProdajnaCijena, StringFormat={}{0:F2} KM}"  FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Text="Marža" Style="{StaticResource CocktailNormsSectionDescription}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Marza}"  FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <!-- ========================================= -->
                    <!-- NORM LIST                                 -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,8,16,0">
                            <TextBlock Text="Normativ koktela" Style="{StaticResource CocktailNormsSectionTitle}"/>
                            <TextBlock Text="Dvostrukim klikom na stavku možeš promijeniti količinu." Style="{StaticResource CocktailNormsSectionDescription}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <DataGrid x:Name="ListaNormativ" Grid.Row="1" Margin="10" ItemsSource="{Binding Norm}" SelectedItem="{Binding SelectedNorm, Mode=TwoWay}" AutoGenerateColumns="False" MouseUp="ListaNormativ_MouseDoubleClick" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" GridLinesVisibility="None" HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" BorderBrush="{DynamicResource GlobalFontColor}" ClipToBounds="True" SelectionMode="Single">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Sastojak" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Repromaterijal}" TextWrapping="Wrap" Padding="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jed. mjere" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JedinicaMjere}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cijena" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cijena, StringFormat={}{0:F2}}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Količina" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kolicina, StringFormat={}{0:F2}}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Iznos" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Ukupno, StringFormat={}{0:F2}}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="#" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" Style="{StaticResource SecondaryButtonStyle}" BorderBrush="#FF3232" BorderThickness="1" Width="40" Height="32" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#xEA81;" FontSize="18" FontWeight="ExtraLight"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- AVAILABLE INGREDIENTS                              -->
            <!-- ================================================= -->

            <Border Grid.Column="2" Style="{StaticResource CocktailNormsCard}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,12,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Sastojci" Style="{StaticResource CocktailNormsSectionTitle}"/>
                        <TextBlock Text="Dvostrukim klikom dodaj sastojak u normativ koktela." Style="{StaticResource CocktailNormsSectionDescription}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="ListaNamirnica" Grid.Row="1" Margin="10" ItemsSource="{Binding IngredientFilter}" SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}" AutoGenerateColumns="False" SelectionChanged="ListaNamirnica_SelectionChanged" MouseUp="ListaNamirnica_MouseDoubleClick" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" GridLinesVisibility="None" HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" BorderBrush="{DynamicResource GlobalFontColor}" ClipToBounds="True" SelectionMode="Single">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Sastojak" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Artikl}" TextWrapping="Wrap" Padding="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Jed. mjere" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding JedinicaMjereName}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>