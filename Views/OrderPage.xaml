<UserControl x:Class="Caupo.Views.OrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top" MinWidth="1300">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!-- INDIKATOR OBRADE RAČUNA -->
        <!-- ====================================================== -->

        <Border x:Name="RacunIdikator"
                Grid.RowSpan="4"
                Panel.ZIndex="999"
                Background="#66323232"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="25"
                Visibility="Collapsed"/>

        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Grid Grid.Row="0" Height="55" VerticalAlignment="Center" Background="#323232">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Grid.Column="0"
                   Content="Caupo - Narudžba"
                   Foreground="#DEDEDE"
                   FontSize="25"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblSto"
                   Grid.Column="0"
                   Content="{Binding ImeStola}"
                   Foreground="#DEDEDE"
                   FontSize="25"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Grid.Column="1"
                   Content="Ime i prezime"
                   Foreground="#DEDEDE"
                   FontSize="15"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- ====================================================== -->
        <!-- KONTROLE -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Količina za podjelu računa -->

            <Viewbox x:Name="ViewKolicina"
                     Grid.Column="0"
                     MaxHeight="100"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Right"
                     Visibility="Collapsed">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label x:Name="lblKolicina"
                           Grid.Row="0"
                           Content="Količina"
                           Width="100"
                           Foreground="{DynamicResource GlobalFontColor}"
                           HorizontalContentAlignment="Center"/>

                    <TextBox x:Name="txtKolicina"
                         Grid.Row="1"
                         Text="1"
                         Width="100"
                         Style="{StaticResource TextBoxCustom}"
                         FontSize="20"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
                </Grid>
            </Viewbox>

            <!-- Plaćanje / kupac -->

    

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="cmbNacinPlacanja"
                              Grid.Row="0"
                              SelectedIndex="0"
                              Width="120"
                              Height="30"
                              Margin="1"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource GlobalFontColor}">
                        <ComboBoxItem Content="Gotovina"/>
                        <ComboBoxItem Content="Kartica"/>
                        <ComboBoxItem Content="Ček"/>
                        <ComboBoxItem Content="Virman"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbKupac"
                              Grid.Row="1"
                              ItemsSource="{Binding Kupci}"
                              SelectedItem="{Binding SelectedKupac}"
                              DisplayMemberPath="Kupac"
                              Width="180"
                              Height="30"
                              Margin="1"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource GlobalFontColor}"/>
                </Grid>
           

            <!-- Izdavanje računa -->

            <Button x:Name="BtnRacun" HorizontalAlignment="Right"
                    Grid.Column="1"
                    Width="200"
                    Height="58"
                    Margin="20"
                    BorderThickness="0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnRacun_Click">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xEC5B;"
                               FontSize="22"
                               Margin="0,0,8,0"
                               Foreground="#F5F5F5"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="IZDAJ RAČUN"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ====================================================== -->
        <!-- STAVKE NARUDŽBE -->
        <!-- ====================================================== -->

        <Grid Grid.Row="2" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Kompletna narudžba -->

            <Border Grid.Column="0"
                    Padding="3"
                    MinHeight="400"
                    Margin="30,10,30,10"
                    VerticalAlignment="Stretch"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="10">

                <DataGrid x:Name="ListaNarudzbeStavke"
                          ItemsSource="{Binding NarudzbeStavke}"
                          SelectedItem="{Binding SelectedStavka, Mode=TwoWay}"
                          PreviewMouseLeftButtonUp="ListnarudzbeStavke_PreviewMouseLeftButtonUp"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          RowHeight="35"
                          MaxWidth="950"
                          MaxHeight="800"
                          VerticalAlignment="Top"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderThickness="0"
                          BorderBrush="{DynamicResource GlobalFontColor}"
                          ClipToBounds="True">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Artikl" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Količina" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Cijena" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Iznos" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Gost račun -->

            <Border x:Name="BorderRacunStavke"
                    Grid.Column="1"
                    Padding="3"
                    MinHeight="400"
                    Margin="30,10,30,10"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="10"
                    Visibility="Collapsed">

                <DataGrid x:Name="ListGostRacunStavke"
                          ItemsSource="{Binding GostRacunStavke}"
                          SelectedItem="{Binding SelectedStavkaRacunGost, Mode=TwoWay}"
                          PreviewMouseLeftButtonUp="ListGostRacunStavke_PreviewMouseLeftButtonUp"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          RowHeight="35"
                          MaxWidth="950"
                          MaxHeight="800"
                          VerticalAlignment="Top"
                          GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderThickness="0"
                          BorderBrush="{DynamicResource GlobalFontColor}"
                          ClipToBounds="True">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Artikl" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Količina" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Cijena" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Iznos" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:F2}}"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ====================================================== -->
        <!-- UKUPNO -->
        <!-- ====================================================== -->

        <Grid Grid.Row="3" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Label x:Name="lblIznos"
                   Grid.Column="0"
                   Content="{Binding TotalSum}"
                   ContentStringFormat="{}{0:0.00}"
                   Foreground="{DynamicResource GlobalFontColor}"
                   FontSize="40"
                   HorizontalAlignment="Right"
                   Margin="0,0,50,0"/>

            <Label x:Name="lblIznosGostRacun"
                   Grid.Column="1"
                   Content="{Binding TotalSumGostRacun}"
                   ContentStringFormat="{}{0:0.00}"
                   Foreground="{DynamicResource GlobalFontColor}"
                   FontSize="40"
                   HorizontalAlignment="Right"
                   Margin="0,0,50,0"
                   Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>