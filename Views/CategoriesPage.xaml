<UserControl x:Class="Caupo.Views.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Caupo.ViewModels"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1300"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <UserControl.DataContext>
        <vm:CategoriesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <Style x:Key="CategoriesCard" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource GlobalBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CategoriesSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CategoriesSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="CategoryGridText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CategoryGridRow"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="49"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent"
          Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <uc:CaupoHeader Grid.Row="0"
                        Title="Caupo - Kategorije"
                        Close="CloseButton_Click"/>

        <!-- TOOLBAR -->
        <Grid Grid.Row="1" Margin="18,10,18,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="532"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- PRETRAGA -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <uc:CaupoSearchBar
                x:Name="CategorySearchBar"
                SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Suggestions="{Binding SearchSuggestions}"
                SuggestionSelected="CategorySearchBar_SuggestionSelected"
                FirstCommand="{Binding FirstCategoryCommand}"
                PreviousCommand="{Binding PreviousCategoryCommand}"
                NextCommand="{Binding NextCategoryCommand}"
                LastCommand="{Binding LastCategoryCommand}"/>       
            </Grid>


            <!-- DODAJ -->
            <Button x:Name="BtnAdd"
                    Grid.Column="2"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding AddCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Dodaj"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- IZMIJENI -->
            <Button x:Name="BtnEdit"
                    Grid.Column="3"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding EditCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Izmijeni"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- OBRIŠI -->
            <Button x:Name="BtnDelete"
                    Grid.Column="4"
                    Style="{DynamicResource CancelButtonStyle}"
                    Command="{Binding DeleteCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Obriši"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- SADRŽAJ -->
        <Grid Grid.Row="2" Margin="18,2,18,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA KATEGORIJA -->
            <Border Grid.Column="0"
                    Style="{StaticResource CategoriesCard}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,3,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Kategorije"
                                       Style="{StaticResource CategoriesSectionTitle}"/>
                            <TextBlock Text="Pregled kategorija artikala"
                                       Style="{StaticResource CategoriesSectionDescription}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kategorija: "
                                           FontSize="13"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                                <TextBlock Text="{Binding KategorijeFilter.Count}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="ListaKategorija"
                              Grid.Row="1"
                              Margin="0,5"
                              ItemsSource="{Binding KategorijeFilter}"
                              SelectedItem="{Binding SelectedKategorija, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="49"
                              ColumnHeaderHeight="45"
                              ClipToBounds="True"
                              RowStyle="{StaticResource CategoryGridRow}">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Kategorija"
                                                    Width="2*"
                                                    SortMemberPath="Kategorija">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kategorija}"
                                                   Style="{StaticResource CategoryGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Vrsta artikla"
                                                    Width="1*"
                                                    SortMemberPath="VrstaArtikla">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VrstaArtiklaName}"
                                                   Style="{StaticResource CategoryGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PODACI O KATEGORIJI -->
            <Border Grid.Column="2"
                    Style="{StaticResource CategoriesCard}"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Odabrana kategorija"
                                   Style="{StaticResource CategoriesSectionTitle}"/>
                        <TextBlock Text="Podaci o odabranoj kategoriji"
                                   Style="{StaticResource CategoriesSectionDescription}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,20">
                        <TextBlock Text="Naziv kategorije"
                                   FontSize="13"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource GlobalFontColor}"/>
                        <TextBlock Text="{Binding SelectedKategorija.Kategorija}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource GlobalFontColor}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Vrsta artikla"
                                   FontSize="13"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource GlobalFontColor}"/>
                        <TextBlock Text="{Binding SelectedKategorija.VrstaArtiklaName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource GlobalFontColor}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- POPUP ZA DODAVANJE I IZMJENU -->
        <Popup x:Name="EditCategoryPopup"
               IsOpen="{Binding IsPopupOpen}"
               PlacementTarget="{Binding ElementName=MainContent}"
               Placement="Center"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Width="440"
                    Background="{DynamicResource GlobalBackgroundColor}"
                    BorderBrush="#666666"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Kategorija"
                               Style="{StaticResource CategoriesSectionTitle}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Naziv kategorije"
                               Foreground="{DynamicResource GlobalFontColor}"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding EditKategorija.Kategorija, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Height="42"
                             CaretBrush="{DynamicResource GlobalFontColor}"/>

                    <TextBlock Text="Vrsta artikla"
                               Foreground="{DynamicResource GlobalFontColor}"
                               Margin="0,18,0,6"/>

                    <ComboBox SelectedIndex="{Binding EditKategorija.VrstaArtikla, Mode=TwoWay}"
                              Height="42">
                        <ComboBoxItem Content="Piće" Tag="0"/>
                        <ComboBoxItem Content="Hrana" Tag="1"/>
                        <ComboBoxItem Content="Ostalo" Tag="2"/>
                    </ComboBox>

                    <Grid Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{DynamicResource CancelButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Height="49">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Odustani"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Height="49">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Spremi"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
