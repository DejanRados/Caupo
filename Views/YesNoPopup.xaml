<Window x:Class="Caupo.Views.YesNoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>

        <!-- Dark overlay -->
        <Border Background="#33000000">

            <!-- Popup -->
            <Border Width="420"
                    Height="255"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GlobalBackgroundColor}"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="0.5"
                    CornerRadius="7">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="95"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEA6C;"
                                   FontSize="48"
                                   FontWeight="ExtraLight"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   Width="48"
                                   Height="48"
                                   Margin="15,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="MessageTitle"
                                   Text="Message Title"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <!-- Message -->
                    <TextBlock x:Name="MessageText"
                               Grid.Row="1"
                               Text="This is a custom alert message."
                               FontSize="15"
                               Foreground="{DynamicResource GlobalFontColor}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="360"
                               Margin="20,5"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Viewbox Stretch="Uniform"
                                 MinWidth="100"
                                 MaxWidth="170"
                                 Margin="5">

                            <Button x:Name="CancelButton"
                                    Style="{StaticResource CancelButtonStyle}"
                                    Click="CancelButton_Click"
                                    Width="130"
                                    Height="40"
                                    Padding="0"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                               Text="&#60039;"
                                               FontSize="20"
                                               FontWeight="ExtraLight"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               Width="20"
                                               Margin="5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="CancelButtonText"
                                               Text="Odustani"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Viewbox>

                        <Viewbox Stretch="Uniform"
                                 MinWidth="100"
                                 MaxWidth="170"
                                 Margin="5">

                            <Button x:Name="OKButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OKButton_Click"
                                    Width="130"
                                    Height="40"
                                    Padding="0"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                               Text="&#xEAB2;"
                                               FontSize="15"
                                               FontWeight="ExtraLight"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               Width="20"
                                               Margin="5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="ConfirmButtonText"
                                               Text="U redu"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Viewbox>

                    </StackPanel>

                </Grid>

            </Border>

        </Border>

    </Grid>

</Window>