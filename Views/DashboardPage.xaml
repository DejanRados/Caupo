<UserControl x:Class="Caupo.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Caupo.ViewModels"
             xmlns:loc="clr-namespace:Caupo"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             Loaded="Window_Loaded"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- DASHBOARD - COMMON STYLES                             -->
        <!-- ===================================================== -->

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="DashboardFilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent" Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <uc:CaupoHeader Grid.Row="0" Title="Caupo - Izvještaji" Close="CloseButton_Click"/>

        <!-- ===================================================== -->
        <!-- TOP TOOLBAR                                           -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1" Margin="24,8,24,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- OD DATUMA                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="{Binding PrviDatePickerLabel}" Style="{StaticResource DashboardFilterLabel}"/>

                <DatePicker x:Name="DpOdDate" CalendarStyle="{StaticResource styleCalendar}" SelectedDateChanged="DpOdDate_SelectedDateChanged" Language="bs-BA" Focusable="False" Foreground="{DynamicResource GlobalFontColor}" FontSize="16" SelectedDate="{Binding OdDatuma}" DisplayDate="{Binding OdDatuma}" SelectedDateFormat="Short" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">

                    <DatePicker.Resources>

                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>

                            <Setter Property="Text">
                                <Setter.Value>
                                    <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType=DatePicker}" StringFormat="dd.MM.yyyy"/>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </DatePicker.Resources>

                </DatePicker>

            </StackPanel>

            <!-- ================================================= -->
            <!-- DO DATUMA                                         -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="2" Visibility="{Binding DrugiDatePickerVisibility}">

                <TextBlock Text="Do datuma:" Style="{StaticResource DashboardFilterLabel}"/>

                <DatePicker x:Name="DpDoDate" SelectedDate="{Binding DoDatuma}" DisplayDate="{Binding DoDatuma}" SelectedDateFormat="Short" Focusable="False" CalendarStyle="{StaticResource styleCalendar}" Language="bs-BA" SelectedDateChanged="DpOdDate_SelectedDateChanged" FontSize="16" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center">

                    <DatePicker.Resources>

                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>

                            <Setter Property="Text">
                                <Setter.Value>
                                    <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType=DatePicker}" StringFormat="dd.MM.yyyy"/>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </DatePicker.Resources>

                </DatePicker>

            </StackPanel>

            <!-- ================================================= -->
            <!-- RADNIK                                            -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="4" Visibility="{Binding ComboRadnikVisibility}">

                <TextBlock Text="Radnik:" Style="{StaticResource DashboardFilterLabel}"/>

                <ComboBox ItemsSource="{Binding SviRadnici}" SelectedItem="{Binding OdabraniRadnik}" SelectionChanged="ComboBox_SelectionChanged" DisplayMemberPath="Radnik" Width="250" FontSize="16" FontWeight="Light" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Left"/>

            </StackPanel>

            <!-- ================================================= -->
            <!-- PRINT                                             -->
            <!-- ================================================= -->

            <Button Grid.Column="6" Style="{StaticResource PrimaryButtonStyle}" x:Name="BtnPrint" Width="120" Height="48" Click="BtnPrint_Click" HorizontalAlignment="Right" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" Foreground="{DynamicResource GlobalFontColor}" Margin="0,0,7,0" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Štampaj" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                </StackPanel>

            </Button>

        </Grid>

        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2" Margin="24,4,24,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- SIDEBAR                                           -->
            <!-- ================================================= -->

            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">

                <StackPanel x:Name="SidebarPanel" Orientation="Vertical"/>

            </Border>

            <!-- ================================================= -->
            <!-- REPORT CONTENT                                    -->
            <!-- ================================================= -->

            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="10">

                <ContentControl Content="{Binding CurrentView}"/>

            </Border>

        </Grid>

    </Grid>

</UserControl>