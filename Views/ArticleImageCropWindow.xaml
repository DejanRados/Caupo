<Window x:Class="Caupo.Views.ArticleImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izreži sliku" Width="900" Height="720" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource GlobalBackgroundColor}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Namjestite okvir slike" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
            <TextBlock x:Name="CropInfoText" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource GlobalFontColor}" Opacity="0.75"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#202124" CornerRadius="8" ClipToBounds="True">
            <Grid x:Name="PreviewHost" Margin="12" SizeChanged="PreviewHost_SizeChanged">
                <Image x:Name="SourceImage" Stretch="Uniform"/>
                <Canvas x:Name="OverlayCanvas" Background="Transparent" MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown" MouseMove="OverlayCanvas_MouseMove" MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
                    <Border x:Name="ShadeTop" Background="#99000000" IsHitTestVisible="False"/>
                    <Border x:Name="ShadeLeft" Background="#99000000" IsHitTestVisible="False"/>
                    <Border x:Name="ShadeRight" Background="#99000000" IsHitTestVisible="False"/>
                    <Border x:Name="ShadeBottom" Background="#99000000" IsHitTestVisible="False"/>
                    <Border x:Name="CropBorder" BorderBrush="White" BorderThickness="2" Background="#01FFFFFF" Cursor="SizeAll"/>
                    <Thumb x:Name="ResizeThumb" Width="32" Height="32" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="White" BorderBrush="#323232" BorderThickness="2" CornerRadius="4"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Odustani" Style="{StaticResource CancelButtonStyle}" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="U redu" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click"/>
        </Grid>
    </Grid>
</Window>
