<Window x:Class="Caupo.Views.PrinterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrinterDialog"
        Width="420"
        Height="255"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource GlobalBackgroundColor}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6">

        <Grid Margin="24,18,24,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- NASLOV -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="26" FontWeight="ExtraLight" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageTitle" Text="Izaberi printer" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
                    <TextBlock Text="Odaberite printer za ispis" FontSize="12" Opacity="0.65" Margin="0,3,0,0" Foreground="{DynamicResource GlobalFontColor}"/>
                </StackPanel>

            </Grid>

            <!-- PRINTER -->

            <ComboBox x:Name="cmbPrinters" Grid.Row="1" Width="350" Height="44" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource GlobalFontColor}"/>

            <!-- AKCIJE -->

            <Grid Grid.Row="2" VerticalAlignment="Bottom">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton" Grid.Column="0" Style="{StaticResource CancelButtonStyle}" Height="48" Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#60039;" FontSize="18" Width="22" Margin="0,0,7,0" FontWeight="ExtraLight" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Odustani" FontSize="14" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="OKButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Height="48" Click="OKButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" Text="&#xEAB2;" FontSize="18" Width="22" Margin="0,0,7,0" FontWeight="ExtraLight" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="U redu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>