<Window x:Class="Caupo.Views.PrinterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrinterDialog"
        Width="420"
        Height="255"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource ThemePopupBrush}"
            BorderBrush="{DynamicResource GlobalBorderColor}"
            BorderThickness="1" CornerRadius="12" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ZAGLAVLJE -->
            <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryBrush}"
                    CornerRadius="11,11,0,0" Padding="18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                               Text="&#xE749;" FontSize="27" FontWeight="ExtraLight"
                               Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="MessageTitle" Text="Izaberi printer"
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                        <TextBlock Text="Odaberite printer za ispis" FontSize="12"
                                   Opacity="0.8" Margin="0,3,0,0"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ODABIR PRINTERA -->
            <ComboBox x:Name="cmbPrinters" Grid.Row="1"
                      Height="44" Margin="22,14"
                      FontSize="14" VerticalAlignment="Center"
                      Foreground="{DynamicResource GlobalFontColor}"/>

            <!-- AKCIJE -->
            <Grid Grid.Row="2" Margin="22,0,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton" Grid.Column="0" Height="46"
                        Style="{StaticResource CancelButtonStyle}" Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60039;" FontSize="19" Margin="0,0,9,0"
                                   Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="Odustani" FontSize="14"
                                   Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="OKButton" Grid.Column="2" Height="46"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEAB2;" FontSize="19" Margin="0,0,9,0"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="U redu" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
