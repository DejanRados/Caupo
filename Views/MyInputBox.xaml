<Window x:Class="Caupo.Views.MyInputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        UseLayoutRounding="True">

    <Grid Background="#663A3A40">
        <Border Width="460" MinHeight="290" MaxHeight="540" CornerRadius="12"
                BorderThickness="1" Background="{DynamicResource ThemePopupBrush}"
                BorderBrush="{DynamicResource GlobalBorderColor}"
                HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="18" ShadowDepth="5" Opacity="0.28"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ZAGLAVLJE -->
                <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryBrush}"
                        CornerRadius="11,11,0,0" Padding="20,17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEA74;" FontSize="28" FontWeight="ExtraLight"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="InputTitle" Grid.Column="1" Text="Unesite vrijednost"
                                   FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemePrimaryForegroundBrush}"/>
                    </Grid>
                </Border>

                <!-- UNOS -->
                <Grid Grid.Row="1" Margin="26,24,26,18">
                    <TextBox x:Name="InputText" Height="56" MinWidth="260"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             Style="{DynamicResource TextBoxCustom}"
                             GotFocus="TextBox_GotFocus"
                             LostFocus="TextBox_LostFocus"
                             PreviewMouseLeftButtonDown="InputText_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="InputText_PreviewKeyDown"
                             Background="Transparent"
                             Foreground="{DynamicResource GlobalFontColor}"
                             CaretBrush="{DynamicResource GlobalFontColor}"
                             BorderBrush="{DynamicResource GlobalBorderColor}"
                             BorderThickness="0,0,0,1"
                             FontSize="23" TextAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextWrapping="Wrap"/>
                </Grid>

                <!-- AKCIJE -->
                <Grid Grid.Row="2" Margin="22,0,22,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton" Grid.Column="0" Height="48"
                            Style="{StaticResource CancelButtonStyle}" Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Text="&#60039;" FontSize="19" Margin="0,0,9,0"
                                       Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Odustani" FontSize="15"
                                       Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OKButton" Grid.Column="2" Height="48"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OKButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Text="&#xEAB2;" FontSize="19" Margin="0,0,9,0"
                                       Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="U redu" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemePrimaryForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="KeyboardHost" HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom" Background="Transparent"
                        Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</Window>
