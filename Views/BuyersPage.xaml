<UserControl x:Class="Caupo.Views.BuyersPage"
             x:Name="BuyersRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <UserControl.Resources>

        <Style x:Key="BuyersCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlobalBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="BuyersSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BuyersSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="BuyerDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BuyerDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BuyerGridText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BuyerGridNumber"
               TargetType="TextBlock"
               BasedOn="{StaticResource BuyerGridText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="BuyerDataGridRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="49"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent"
          Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ZAGLAVLJE -->
        <uc:CaupoHeader Grid.Row="0"
                        Title="Caupo - Kupci"
                        Close="CloseButton_Click"/>

        <!-- GORNJA KOMANDNA TRAKA -->
        <Grid Grid.Row="1" Margin="18,10,18,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="532"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- PRETRAGA I NAVIGACIJA -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <uc:CaupoSearchBar
                    x:Name="BuyerSearchBar"
                    SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Suggestions="{Binding SearchSuggestions}"
                    SuggestionSelected="BuyerSearchBar_SuggestionSelected"
                    FirstCommand="{Binding FirstBuyerCommand}"
                    PreviousCommand="{Binding PreviousBuyerCommand}"
                    NextCommand="{Binding NextBuyerCommand}"
                    LastCommand="{Binding LastBuyerCommand}"/>
            </Grid>


            <!-- DODAJ -->
            <Button x:Name="BtnAdd"
                    Grid.Column="2"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding AddBuyerCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Dodaj"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- IZMIJENI -->
            <Button x:Name="BtnEdit"
                    Grid.Column="3"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding EditBuyerCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Izmijeni"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- OBRIŠI -->
            <Button x:Name="BtnDelete"
                    Grid.Column="4"
                    Style="{DynamicResource CancelButtonStyle}"
                    Command="{Binding DeleteBuyerCommand}"
                    Height="49"
                    MinWidth="110"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Obriši"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- FAKTURA -->
            <Button x:Name="BtnFaktura"
                    Grid.Column="5"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Click="BtnFaktura_Click"
                    Height="49"
                    MinWidth="120"
                    Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Faktura"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- GLAVNI SADRŽAJ -->
        <Grid Grid.Row="2" Margin="18,2,18,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.9*" MinWidth="350"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- KARTICA: PODACI KUPCA -->
            <Border Grid.Column="0"
                    Style="{StaticResource BuyersCard}"
                    Padding="16">

                <Grid DataContext="{Binding SelectedBuyer}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Odabrani kupac"
                                   Style="{StaticResource BuyersSectionTitle}"/>
                        <TextBlock Text="Osnovni podaci kupca"
                                   Style="{StaticResource BuyersSectionDescription}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- NAZIV -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Naziv"
                                   Style="{StaticResource BuyerDetailLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kupac}"
                                   Style="{StaticResource BuyerDetailValue}"/>
                    </Grid>

                    <!-- ADRESA -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Adresa"
                                   Style="{StaticResource BuyerDetailLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Adresa}"
                                   Style="{StaticResource BuyerDetailValue}"/>
                    </Grid>

                    <!-- MJESTO -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mjesto"
                                   Style="{StaticResource BuyerDetailLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Mjesto}"
                                   Style="{StaticResource BuyerDetailValue}"/>
                    </Grid>

                    <!-- JIB -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JIB"
                                   Style="{StaticResource BuyerDetailLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding JIB}"
                                   Style="{StaticResource BuyerDetailValue}"/>
                    </Grid>

                    <!-- PDV -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PDV"
                                   Style="{StaticResource BuyerDetailLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PDV}"
                                   Style="{StaticResource BuyerDetailValue}"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- KARTICA: LISTA KUPACA -->
            <Border Grid.Column="2"
                    Style="{StaticResource BuyersCard}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,3,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Kupci"
                                       Style="{StaticResource BuyersSectionTitle}"/>
                            <TextBlock Text="Pregled evidentiranih kupaca"
                                       Style="{StaticResource BuyersSectionDescription}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kupaca: "
                                           FontSize="13"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                                <TextBlock Text="{Binding BuyersFilter.Count}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="ListaKupaca"
                              Grid.Row="1"
                              Margin="0,5"
                              ItemsSource="{Binding BuyersFilter}"
                              SelectedItem="{Binding SelectedBuyer, Mode=TwoWay}"
                              SelectionChanged="ListaKupaca_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="49"
                              ColumnHeaderHeight="45"
                              ClipToBounds="True"
                              RowStyle="{StaticResource BuyerDataGridRowStyle}">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Kupac"
                                                    Width="2*"
                                                    SortMemberPath="Kupac">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kupac}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Adresa"
                                                    Width="1.5*"
                                                    SortMemberPath="Adresa">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Adresa}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Mjesto"
                                                    Width="1.2*"
                                                    SortMemberPath="Mjesto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mjesto}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="JIB"
                                                    Width="1.2*"
                                                    SortMemberPath="JIB">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding JIB}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="PDV"
                                                    Width="1.2*"
                                                    SortMemberPath="PDV">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PDV}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- KARTICA: RAČUNI KUPCA -->
            <Border Grid.Column="4"
                    Style="{StaticResource BuyersCard}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,3,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Računi kupca"
                                       Style="{StaticResource BuyersSectionTitle}"/>
                            <TextBlock Text="Pregled računa odabranog kupca"
                                       Style="{StaticResource BuyersSectionDescription}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Računa: "
                                           FontSize="13"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                                <TextBlock Text="{Binding Receipts.Count}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlobalFontColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="ListaRacuna"
                              Grid.Row="1"
                              Margin="0,5"
                              ItemsSource="{Binding Receipts}"
                              SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}"
                              SelectionChanged="ListaRacuna_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="49"
                              ColumnHeaderHeight="45"
                              ClipToBounds="True"
                              RowStyle="{StaticResource BuyerDataGridRowStyle}">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Br. rač."
                                                    Width="0.8*"
                                                    SortMemberPath="BrojRacuna">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BrojRacuna}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Datum"
                                                    Width="1.5*"
                                                    SortMemberPath="Datum">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Datum, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Izdao"
                                                    Width="1.2*"
                                                    SortMemberPath="RadnikName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RadnikName}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="BF"
                                                    Width="1.2*"
                                                    SortMemberPath="BrojFiskalnogRacuna">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BrojFiskalnogRacuna}"
                                                   Style="{StaticResource BuyerGridText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Iznos"
                                                    Width="1*"
                                                    SortMemberPath="Iznos">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Iznos, StringFormat={}{0:N2}}"
                                                   Style="{StaticResource BuyerGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
