                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SifraWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SifraError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Sifra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransferCellTextBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

