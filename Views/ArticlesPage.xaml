                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding Vrsta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="40" Padding="5,0" Margin="0" DropDownClosed="ArticleTransferComboBox_DropDownClosed">
                                        <ComboBoxItem Content="Piće"/>
                                        <ComboBoxItem Content="Hrana"/>
                                        <ComboBoxItem Content="Ostalo"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- KATEGORIJA -->
                        <DataGridTemplateColumn Header="Kategorija" Width="1.5*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Kategorija}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KategorijaWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KategorijaError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding Kategorija, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="5,0" Margin="0" DropDownClosed="ArticleTransferComboBox_DropDownClosed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- JEDINICA MJERE -->
                        <DataGridTemplateColumn Header="Jedinica" Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Jedinica}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JedinicaWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding JedinicaError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.JediniceMjere, ElementName=ArticleTransferDataGrid}" SelectedValue="{Binding Jedinica, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="JedinicaMjere" Height="40" Padding="5,0" Margin="0" DropDownClosed="ArticleTransferComboBox_DropDownClosed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- POREZ -->
                        <DataGridTemplateColumn Header="Porez" Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Porez}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PorezWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PorezError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.PoreskeStope, ElementName=ArticleTransferDataGrid}" Tag="{Binding}" Height="40" Padding="5,0" Margin="0" SelectionChanged="ArticleTransferTaxComboBox_SelectionChanged" DropDownClosed="ArticleTransferComboBox_DropDownClosed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Postotak, StringFormat={}{0:0.##}%}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- NORMATIV -->
                        <DataGridTemplateColumn Header="Normativ" Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Normativ}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NormativWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NormativError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>

                                    <Grid>

                                        <ComboBox x:Name="NormativComboBox" ItemsSource="{Binding DataContext.Normativi, ElementName=ArticleTransferDataGrid}" SelectedValue="{Binding Normativ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Normativ" Height="40" Padding="5,0" Margin="0" Visibility="Collapsed" DropDownClosed="ArticleTransferComboBox_DropDownClosed"/>

                                        <Border x:Name="NormativFixedBorder" Height="40" Background="Transparent" Padding="8,0" Visibility="Visible">
                                            <TextBlock Text="1" VerticalAlignment="Center" Foreground="{DynamicResource GlobalFontColor}"/>
                                        </Border>

                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanEditNormativ}" Value="True">
                                            <Setter TargetName="NormativComboBox" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="NormativFixedBorder" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- POZICIJA -->
                        <DataGridTemplateColumn Header="Pozicija" Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Pozicija}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PozicijaWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PozicijaError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Pozicija, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransferCellTextBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- AKTIVAN -->
                        <DataGridTemplateColumn Header="Aktivan" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Aktivan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- POREZ NA POTROŠNJU -->
                        <DataGridTemplateColumn Header="Porez potrošnja" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding PorezNaPotrosnju, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- SLIKA -->
                        <DataGridTemplateColumn Header="Slika" Width="3*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Grid Margin="8,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Height="36" Source="{Binding SlikaZaPrikaz}" Stretch="Uniform"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Slika}" Style="{StaticResource TransferCellTextStyle}" ToolTip="{Binding Slika}"/>

                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Width="36" Height="36" Source="{Binding SlikaZaPrikaz}" Stretch="UniformToFill"/>
                                        <TextBox Grid.Column="2" Text="{Binding Slika, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransferCellTextBoxStyle}"/>

                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <!-- Dugme X -->
                        <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CloseAppButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="1" ToolTip="Izbriši red" Click="ArticleTransferDeleteRow_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- SPLITER -->
                <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource GlobalFontColor}" Opacity="0.20" Cursor="SizeNS" Margin="0,5,0,0"/>

                <!-- ERROR / OUTPUT -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource GlobalFontColor}" BorderThickness="0.5" Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ArticleTransferErrorTitle" Text="Greške (0)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
                            <TextBlock x:Name="ArticleTransferValidationSummary" Grid.Column="1" Text="Nije validirano" Opacity="0.75" Foreground="{DynamicResource GlobalFontColor}"/>

                        </Grid>

                        <DataGrid x:Name="ArticleTransferErrorGrid"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Foreground="{DynamicResource GlobalFontColor}"
                          SelectionChanged="ArticleTransferErrorGrid_SelectionChanged">

                            <DataGrid.Resources>

                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>

                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="Red" Binding="{Binding RowNumber}" Width="70"/>
                                <DataGridTextColumn Header="Polje" Binding="{Binding ColumnName}" Width="160"/>
                                <DataGridTextColumn Header="Opis" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- STATUS -->
                <TextBlock x:Name="ArticleTransferFooter" Grid.Row="6" VerticalAlignment="Center" Opacity="0.75" Foreground="{DynamicResource GlobalFontColor}"/>

            </Grid>

        </Grid>
        <!-- ================================================= -->
        <!-- FLOATINGBAR                                -->
        <!-- ================================================= -->

        <Border x:Name="ArticleTransferFloatingBar"
            Panel.ZIndex="1400"
            Width="290"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,150,45,0"
            Background="Transparent"
            BorderThickness="0"
            Visibility="Collapsed">

            <controls:FloatingMenuBar x:Name="ArticleTransferFloatingMenuBar"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"/>

        </Border>

    </Grid>

</UserControl>