        <!-- IMPORT / EXPORT EDITOR -->
        <Grid x:Name="ArticleTransferGrid" Panel.ZIndex="1200" Background="{DynamicResource GlobalBackgroundColor}" Visibility="Collapsed">

            <Button x:Name="ArticleTransferCloseButton" Grid.Column="2" Style="{StaticResource CloseButtonStyle}" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="0" Margin="1" Click="BtnTransferClose_Click"/>

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1*" MinHeight="120"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ArticleTransferTitle" Text="Import / Export artikala" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
                        <TextBlock x:Name="ArticleTransferSummary" Text="Privremeni editor — promjene još nisu upisane u bazu." Margin="0,5,0,0" Opacity="0.75" Foreground="{DynamicResource GlobalFontColor}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,10,0">

                        <Button Height="42" MinWidth="105" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTransferLoadFile_Click">
                            <TextBlock Text="Uvezi fajl" Foreground="{DynamicResource GlobalFontColor}"/>
                        </Button>

                        <Button x:Name="ArticleTransferExportButton" Height="42" MinWidth="105" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTransferSaveFile_Click">
                            <TextBlock Text="Izvezi artikle" Foreground="{DynamicResource GlobalFontColor}"/>
                        </Button>

                        <Popup x:Name="ArticleTransferExportPopup" PlacementTarget="{Binding ElementName=ArticleTransferExportButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="4" VerticalOffset="2">

                            <Border Width="150" Background="{DynamicResource GlobalBackgroundColor}" BorderBrush="{DynamicResource GlobalFontColor}" BorderThickness="1" CornerRadius="8" Padding="4">

                                <StackPanel>

                                    <Button Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTransferExportXlsx_Click">
                                        <TextBlock Text="Excel" Foreground="{DynamicResource GlobalFontColor}"/>
                                    </Button>

                                    <Button Height="40" Margin="0,4,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTransferExportCsv_Click">
                                        <TextBlock Text="CSV" Foreground="{DynamicResource GlobalFontColor}"/>
                                    </Button>

                                </StackPanel>

                            </Border>

                        </Popup>



                        <Button x:Name="BtnTransferApply" Height="42" MinWidth="135" Margin="4,0" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="BtnTransferApply_Click">
                            <TextBlock Text="Primijeni u Caupo" Foreground="#F5F5F5"/>
                        </Button>

                    </StackPanel>

                </Grid>

                <!-- GLAVNI EDITOR -->
                <DataGrid x:Name="ArticleTransferDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  SelectionUnit="CellOrRowHeader"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Foreground="{DynamicResource GlobalFontColor}"
                  PreviewKeyDown="ArticleTransferDataGrid_PreviewKeyDown"
                  PreviewMouseLeftButtonDown="ArticleTransferDataGrid_PreviewMouseLeftButtonDown"
                  BeginningEdit="ArticleTransferDataGrid_BeginningEdit"
                  CellEditEnding="ArticleTransferDataGrid_CellEditEnding">

                    <DataGrid.Resources>

                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>

                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>

                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Style.Triggers>
                                <Trigger Property="IsEditing" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GlobalBackgroundColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                                </Trigger>
                            </Style.Triggers>

                        </Style>

                        <!-- NORMALNI TEKST -->
                        <Style x:Key="TransferCellTextStyle" TargetType="TextBlock">
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>

                        <!-- TEXTBOX EDITOR -->
                        <Style x:Key="TransferCellTextBoxStyle" TargetType="TextBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource GlobalFontColor}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- CHECKBOX -->
                        <DataGridTemplateColumn Width="100" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#BB323232"/>
                                    <Setter Property="Foreground" Value="#F5F5F5"/>
                                    <Setter Property="MinHeight" Value="45"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>

                            <DataGridTemplateColumn.Header>
                                <CheckBox Width="42" Height="42" Margin="0" Style="{StaticResource ArticleTouchCheckBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Označi sve artikle za grupno uređivanje" Checked="ArticleTransferSelectAll_Checked" Unchecked="ArticleTransferSelectAll_Unchecked"/>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Left" Style="{StaticResource ArticleTouchCheckBoxStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="ArticleTransferRowCheckBox_Changed" Unchecked="ArticleTransferRowCheckBox_Changed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ŠIFRA -->
