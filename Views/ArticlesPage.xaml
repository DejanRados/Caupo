                        </DataGridTemplateColumn>

                        <!-- VRSTA -->
                        <DataGridTemplateColumn Header="Vrsta" Width="*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="{Binding Vrsta}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TransferCellTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VrstaWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="#B38B32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VrstaError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B85450"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
