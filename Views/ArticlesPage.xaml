<UserControl x:Class="Caupo.Views.ArticlesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Caupo.ViewModels"
             xmlns:loc="clr-namespace:Caupo.Helpers"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             mc:Ignorable="d"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- ARTICLES - ZAJEDNIČKI STILOVI                         -->
        <!-- ===================================================== -->

        <Style x:Key="ArticlesSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ArticlesSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="ArticlesCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ArticleDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ArticleDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent" Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0" Height="55" Background="#323232">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Content="Caupo - Artikli"
                   Foreground="#fafafa"
                   FontSize="25"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Content="Ime i prezime"
                   Foreground="#fafafa"
                   FontSize="15"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseButtonStyle}"
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>

        </Grid>

        <!-- ===================================================== -->
        <!-- GORNJA TRAKA                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1" Margin="24,12,24,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- PRETRAGA + NAVIGACIJA                             -->
            <!-- ================================================= -->

            <Grid Grid.Column="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="48"
                        Margin="0,0,8,0"
                        Padding="5"
                        BorderThickness="1"
                        BorderBrush="#3F3F46"
                        CornerRadius="6"
                        Background="Transparent">

                    <DockPanel>

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   FontSize="22"
                                   Width="34"
                                   FontWeight="ExtraLight"
                                   Text="&#60013;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource TextBoxCustom}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="TextBox_GotFocus"
                                 LostFocus="TextBox_LostFocus"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 CaretBrush="{DynamicResource GlobalFontColor}"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Padding="5,0"
                                 VerticalContentAlignment="Center"/>

                    </DockPanel>

                </Border>

                <Button x:Name="BtnFirst"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Click="BtnFirst_Click"
                        ToolTip="Prvi artikl">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="21"
                               FontWeight="ExtraLight"
                               Text="&#xE76C;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

                <Button x:Name="BtnPrevious"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Click="BtnPrevious_Click"
                        ToolTip="Prethodni artikl">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Text="&#60271;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

                <Button x:Name="BtnNext"
                        Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Click="BtnNext_Click"
                        ToolTip="Sljedeći artikl">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Text="&#60272;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

                <Button x:Name="BtnLast"
                        Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Click="BtnLast_Click"
                        ToolTip="Posljednji artikl">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="21"
                               FontWeight="ExtraLight"
                               Text="&#xE76B;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

            </Grid>

            <!-- ================================================= -->
            <!-- AKCIJE                                            -->
            <!-- ================================================= -->

            <Grid Grid.Column="2" HorizontalAlignment="Right">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnAdd"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnAdd_Click">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60000;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Dodaj"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="BtnEdit"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnEdit_Click">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60019;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Uredi"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="BtnDelete"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnDelete_Click">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60033;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Obriši"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="BtnImport"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnImport_Click">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEC26;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Uvoz"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="BtnExport"
                        Grid.Column="4"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnExport_Click">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEC28;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Izvoz"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

        <!-- ===================================================== -->
        <!-- GLAVNI SADRŽAJ                                        -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2" Margin="24,4,24,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- LIJEVI PANEL                                      -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource ArticlesCard}"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Alati"
                                   Style="{StaticResource ArticlesSectionTitle}"/>

                        <TextBlock Text="Filteri i dodatne opcije"
                                   Style="{StaticResource ArticlesSectionDescription}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Ovaj prostor je rezervisan za dodatne komande, filtere i grupne operacije nad artiklima."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Opacity="0.55"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- LISTA ARTIKALA                                    -->
            <!-- ================================================= -->

            <Border Grid.Column="2" Style="{StaticResource ArticlesCard}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,0">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Artikli"
                                       Style="{StaticResource ArticlesSectionTitle}"/>

                            <TextBlock Text="Pregled artikala"
                                       Style="{StaticResource ArticlesSectionDescription}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Grid>

                    <DataGrid x:Name="ListaArtikala"
                              Grid.Row="1"
                              ItemsSource="{Binding ArtikliFilter}"
                              SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                              SelectionChanged="ListaArtikala_SelectionChanged"
                              PreviewMouseLeftButtonDown="ListaArtikala_PreviewMouseLeftButtonDown"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="None"
                              RowHeight="35"
                              Background="Transparent"
                              BorderThickness="0"
                              BorderBrush="{DynamicResource GlobalFontColor}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              ClipToBounds="True">

                        <DataGrid.Resources>

                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Šifra" Width="0.75*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Sifra}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Artikl" Width="2.2*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding ArtiklNormativ}"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="8,0"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Cijena" Width="0.8*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}"
                                                   TextAlignment="Right"
                                                   Padding="0,0,10,0"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Vrsta" Width="1*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding VrstaArtiklaName}"
                                                   TextAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- DETALJI ARTIKLA                                   -->
            <!-- ================================================= -->

            <Border Grid.Column="4"
                    Style="{StaticResource ArticlesCard}"
                    Padding="18">

                <Grid DataContext="{Binding SelectedArticle}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="165"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Odabrani artikal"
                                   Style="{StaticResource ArticlesSectionTitle}"/>

                        <TextBlock Text="Detalji artikla"
                                   Style="{StaticResource ArticlesSectionDescription}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <!-- SLIKA -->

                    <Border Grid.Row="2"
        BorderBrush="#3F3F46"
        BorderThickness="1"
        CornerRadius="6"
        Padding="8">

                        <Grid>

                             <TextBlock Text="Nema slike"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="13"
                               Opacity="0.45"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">  

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SlikaSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                            <Image Source="{Binding SlikaSource}"
                                   Width="180"
                                   Height="145"
                                   Stretch="Uniform"
                                   StretchDirection="Both"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/> 

                        </Grid>

                    </Border>

                    <!-- NAZIV -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Naziv"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Artikl}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- ŠIFRA -->

                    <Grid Grid.Row="5">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Šifra"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Sifra}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- INTERNA ŠIFRA -->

                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Interna šifra"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding InternaSifra}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- CIJENA -->

                    <Grid Grid.Row="7">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Cijena"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                            <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}"
                                       Style="{StaticResource ArticleDetailValue}"/>

                            <TextBlock Text=" €"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                    <!-- JEDINICA MJERE -->

                    <Grid Grid.Row="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Jedinica mjere"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding JedinicaMjereName}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- POREZ -->

                    <Grid Grid.Row="9">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Porez"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PoreskaStopaPostotak}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- VRSTA -->

                    <Grid Grid.Row="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Vrsta"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VrstaArtiklaName}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- KATEGORIJA -->

                    <Grid Grid.Row="11">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Kategorija"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kategorija}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- NORMATIV -->

                    <Grid Grid.Row="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Normativ"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Normativ}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- POZICIJA -->

                    <Grid Grid.Row="13">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Pozicija"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Pozicija}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                    </Grid>

                    <!-- AKTIVAN -->

                    <Grid Grid.Row="14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Aktivan"
               Style="{StaticResource ArticleDetailLabel}"/>

                        <TextBlock Grid.Column="1">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock"
                   BasedOn="{StaticResource ArticleDetailValue}">

                                    <Setter Property="Text" Value="NE"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding Aktivan}" Value="True">
                                            <Setter Property="Text" Value="DA"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- PRIVREMENI LEGACY CONTROLS                            -->
        <!-- Potrebni dok stari inline CRUD ne zamijenimo popupima -->
        <!-- ===================================================== -->

        <Grid Visibility="Collapsed">

            <Grid x:Name="InternaSifraGrid"/>
            <Grid x:Name="SlikaGrid"/>
            <Grid x:Name="JedinicaMjereGrid"/>
            <Grid x:Name="PoreskeStopeGrid"/>
            <Grid x:Name="NormativGrid"/>
            <Grid x:Name="VrstaArtiklaGrid"/>
            <Grid x:Name="KategorijaGrid"/>
            <Grid x:Name="PozicijaGrid"/>
            <Grid x:Name="PrikazGrid"/>
            <Grid x:Name="ArtiklNormativGrid"/>
            <Grid x:Name="EditGrid"/>
            <Grid x:Name="AddGrid"/>

            <TextBox x:Name="IdArtiklaTextBox"/>
            <TextBox x:Name="SifraTextBox"/>
            <TextBox x:Name="ArtiklTextBox" TextChanged="ArtiklTextBox_TextChanged"/>
            <TextBox x:Name="CijenaTextBox"/>
            <TextBox x:Name="InternaSifraTextBox"/>
            <TextBox x:Name="SlikaTextBox"/>
            <TextBox x:Name="PozicijaTextBox"/>
            <TextBox x:Name="ArtiklNormativTextBox"/>

            <ComboBox x:Name="JediniceMjerePicker"/>
            <ComboBox x:Name="PoreskeStopePicker"/>
            <ComboBox x:Name="NormativPicker"/>
            <ComboBox x:Name="VrstaArtiklaPicker"/>
            <ComboBox x:Name="KategorijePicker"/>

            <ComboBox x:Name="PrikazatiNaDisplejuPicker">
                <system:String>DA</system:String>
                <system:String>NE</system:String>
            </ComboBox>

            <Button x:Name="btnSlika"/>
            <Button x:Name="btnKategorija"/>

            <Button x:Name="SaveEditButton"/>
            <Button x:Name="CancelEditButton"/>
            <Button x:Name="SaveAddButton"/>
            <Button x:Name="CancelAddButton"/>

            <Label x:Name="lblArtikl"/>
            <Label x:Name="lblCijena"/>

        </Grid>

    </Grid>

</UserControl>