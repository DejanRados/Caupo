        <!-- ARTICLE IMPORT MAPPER -->
        <Grid x:Name="ArticleImportMapperGrid" Panel.ZIndex="1250" Background="{DynamicResource GlobalBackgroundColor}" Visibility="Collapsed">
            <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="0" Margin="1" Click="BtnArticleImportMapperClose_Click"/>
            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ArticleImportMapperTitle" Text="Uvoz artikala" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
                        <TextBlock x:Name="ArticleImportMapperSummary" Text="Odaberite koji podatak iz fajla odgovara podatku u Caupu." Margin="0,5,0,0" Opacity="0.75" Foreground="{DynamicResource GlobalFontColor}"/>
                    </StackPanel>



                </Grid>

                <!-- SADRŽAJ -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                    </ScrollViewer.Resources>

                    <StackPanel MaxWidth="1100" HorizontalAlignment="Center">

                        <!-- OBJAŠNJENJE -->
                        <Border Padding="20" Margin="0,0,0,20" BorderBrush="{DynamicResource GlobalFontColor}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Povežite kolone" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>
                                <TextBlock Text="Za svaku Caupo kolonu odaberite odgovarajuću kolonu iz uvezenog fajla." Margin="0,6,0,0" FontSize="15" Opacity="0.75" Foreground="{DynamicResource GlobalFontColor}"/>
                            </StackPanel>
                        </Border>

                        <!-- ZAGLAVLJE -->
                        <Grid Margin="10,0,10,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Caupo kolona" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>

                            <TextBlock Grid.Column="2" Text="Kolona u fajlu" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>

                            <TextBlock Grid.Column="3" Text="Primjer podatka" FontSize="16" Margin="20,0,20,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource GlobalFontColor}"/>

                            <Button x:Name="BtnArticleImportMapperContinue" Grid.Column="4" Content="NASTAVI" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160" Margin="5" Click="BtnArticleImportMapperContinue_Click"/>
                            <Border  Grid.ColumnSpan="5" BorderBrush="{DynamicResource GlobalFontColor}" BorderThickness="0,0,0,1">

                            </Border>
                        </Grid>

                        <!-- ŠIFRA -->
                        <Grid Height="52" Margin="10,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="40"/>
