<UserControl x:Class="Caupo.Views.ArticlesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Caupo.ViewModels"
             xmlns:loc="clr-namespace:Caupo.Helpers"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             mc:Ignorable="d"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- ARTICLES - COMMON STYLES                              -->
        <!-- ===================================================== -->

        <Style x:Key="ArticlesSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ArticlesSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="ArticlesCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ArticleDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ArticleDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===================================================== -->
        <!-- LARGE TOUCH CHECKBOX                                  -->
        <!-- ===================================================== -->

        <Style x:Key="ArticleTouchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Border x:Name="CheckBorder"
                                Margin="1"
                                Background="Transparent"
                                BorderBrush="{DynamicResource GlobalFontColor}"
                                BorderThickness="2"
                                CornerRadius="4">

                            <TextBlock x:Name="CheckMark"
                                       Text="✓"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource GlobalBackgroundColor}">

        <Grid x:Name="MainContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0" Height="55" Background="#323232">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

                <Label x:Name="lblApp"
                   Content="Caupo - Artikli"
                   Foreground="#fafafa"
                   FontSize="25"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                <Label x:Name="lblUlogovaniKorisnik"
                   Content="Ime i prezime"
                   Foreground="#fafafa"
                   FontSize="15"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

                <Button x:Name="CloseButton"
                    Style="{StaticResource CloseButtonStyle}"
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>

            </Grid>

            <!-- ===================================================== -->
            <!-- TOP TOOLBAR                                           -->
            <!-- ===================================================== -->

            <Grid Grid.Row="1" Margin="24,12,24,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- SEARCH + NAVIGATION                               -->
                <!-- ================================================= -->

                <Grid Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                        Height="48"
                        Margin="0,0,8,0"
                        Padding="5"
                        BorderThickness="1"
                        BorderBrush="#3F3F46"
                        CornerRadius="6"
                        Background="Transparent">

                        <DockPanel>

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   FontSize="22"
                                   Width="34"
                                   FontWeight="ExtraLight"
                                   Text="&#60013;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource TextBoxCustom}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="TextBox_GotFocus"
                                 LostFocus="TextBox_LostFocus"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 CaretBrush="{DynamicResource GlobalFontColor}"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Padding="5,0"
                                 VerticalContentAlignment="Center"/>

                        </DockPanel>

                    </Border>

                    <Button x:Name="BtnFirst"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Command="{Binding FirstCommand}"
                        ToolTip="Prvi artikl">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="21"
                               FontWeight="ExtraLight"
                               Text="&#xE76C;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                    <Button x:Name="BtnPrevious"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Command="{Binding PreviousCommand}"
                        ToolTip="Prethodni artikl">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Text="&#60271;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                    <Button x:Name="BtnNext"
                        Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Command="{Binding NextCommand}"
                        ToolTip="Sljedeći artikl">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Text="&#60272;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                    <Button x:Name="BtnLast"
                        Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Command="{Binding LastCommand}"
                        ToolTip="Posljednji artikl">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="21"
                               FontWeight="ExtraLight"
                               Text="&#xE76B;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                </Grid>

                <!-- ================================================= -->
                <!-- ACTIONS                                           -->
                <!-- ================================================= -->

                <Grid Grid.Column="2" HorizontalAlignment="Right">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnAdd"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnAdd_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60000;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                            <TextBlock Text="Dodaj"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnEdit"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnEdit_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60019;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                            <TextBlock Text="Uredi"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnDelete"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnDelete_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#60033;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                            <TextBlock Text="Obriši"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnImport"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnImport_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEC26;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                            <TextBlock Text="Uvoz"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="BtnExport"
                        Grid.Column="4"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Margin="3"
                        Click="BtnExport_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Text="&#xEC28;"
                                   FontSize="21"
                                   Margin="0,0,7,0"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                            <TextBlock Text="Izvoz"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Grid>

            <!-- ===================================================== -->
            <!-- MAIN CONTENT                                          -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2" Margin="24,4,24,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- LEFT PANEL                                        -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                    Style="{StaticResource ArticlesCard}"
                    Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Alati"
                                   Style="{StaticResource ArticlesSectionTitle}"/>

                            <TextBlock Text="Filteri i dodatne opcije"
                                   Style="{StaticResource ArticlesSectionDescription}"
                                   Margin="0,3,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Row="2">

                            <TextBlock Text="Status artikla"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                            <ComboBox ItemsSource="{Binding ActiveFilters}"
                                  SelectedItem="{Binding SelectedActiveFilter, Mode=TwoWay}"
                                  Height="38"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"/>

                            <TextBlock Text="Vrsta artikla"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                            <ComboBox ItemsSource="{Binding ArticleTypeFilters}"
                                  SelectedItem="{Binding SelectedArticleTypeFilter, Mode=TwoWay}"
                                  Height="38"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"/>

                            <TextBlock Text="Kategorija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                            <ComboBox ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                  IsEnabled="{Binding IsCategoryFilterEnabled}"
                                  Height="38"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"/>

                            <TextBlock Text="Poreska stopa"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>

                            <ComboBox ItemsSource="{Binding TaxFilters}"
                                  SelectedItem="{Binding SelectedTaxFilter, Mode=TwoWay}"
                                  Height="38"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- ARTICLE LIST                                      -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                    Style="{StaticResource ArticlesCard}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"  VerticalAlignment="Center">

                                <TextBlock Text="Artikli"   Style="{StaticResource ArticlesSectionTitle}"/>

                                <TextBlock Text="Pregled artikala" Style="{StaticResource ArticlesSectionDescription}"  Margin="0,2,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,40,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BrojOznacenihArtikala, StringFormat=Označeno: {0}}" Foreground="{DynamicResource GlobalFontColor}" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnBatchEdit" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="12,0" Click="BtnBatchEdit_Click" IsEnabled="False" ToolTip="Grupno uređivanje označenih artikala">
                                    <TextBlock Text="Grupno uredi" Foreground="{DynamicResource GlobalFontColor}"/>
                                </Button>
                            </StackPanel>

                        </Grid>

                        <DataGrid x:Name="ListaArtikala"
                              Grid.Row="1"
                              ItemsSource="{Binding ArtikliFilter}"
                              SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                              SelectionChanged="ListaArtikala_SelectionChanged"
                              PreviewMouseLeftButtonDown="ListaArtikala_PreviewMouseLeftButtonDown"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              
                              Background="Transparent"
                              BorderThickness="0"
                              BorderBrush="{DynamicResource GlobalFontColor}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              ClipToBounds="True">

                            <DataGrid.Resources>

                                <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- ŠIFRA -->

                                <DataGridTemplateColumn Header="Šifra"
                                                    Width="0.75*"
                                                    SortMemberPath="Sifra"
                                                    CanUserSort="False">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Sifra}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- ARTIKL -->

                                <DataGridTemplateColumn Header="Artikl"
                                                    Width="2.2*"
                                                    SortMemberPath="Artikl">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding ArtiklNormativ}"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="8,0"
                                                   VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- CIJENA -->

                                <DataGridTemplateColumn Header="Cijena"
                                                    Width="0.8*"
                                                    SortMemberPath="Cijena">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}"
                                                   TextAlignment="Right"
                                                   Padding="0,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- Kategorija-->

                                <DataGridTemplateColumn Header="Kategorija"
                                      Width="1*"
                                      CanUserSort="False"
                                      SortMemberPath="Kategorija">

                                                    <DataGridTemplateColumn.CellTemplate>

                                                        <DataTemplate>

                                                        <TextBlock Text="{Binding KategorijaName}"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- VRSTA -->

                                <DataGridTemplateColumn Header="Vrsta"
                                                    Width="1*"
                                                    SortMemberPath="VrstaArtikla">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding VrstaArtiklaName}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <!-- TOUCH CHECKBOX / SELECT ALL -->

                                <DataGridTemplateColumn Width="50"
                                                    CanUserSort="False"
                                                    CanUserResize="False">

                                    <DataGridTemplateColumn.HeaderStyle>

                                        <Style TargetType="DataGridColumnHeader">

                                            <Setter Property="Background" Value="#BB323232"/>
                                            <Setter Property="Foreground" Value="#F5F5F5"/>
                                            <Setter Property="MinHeight" Value="45"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="DataGridColumnHeader">

                                                        <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="1"
                                                            SnapsToDevicePixels="True">

                                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </DataGridTemplateColumn.HeaderStyle>

                                    <DataGridTemplateColumn.Header>

                                        <CheckBox Width="42" x:Name="SelectAllArticlesCheckBox"
                                              Height="42"
                                              Margin="0"
                                              Style="{StaticResource ArticleTouchCheckBoxStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                                ToolTip="Označi sve prikazane artikle"
                                              Checked="SelectAllArticlesCheckBox_Checked"
                                              Unchecked="SelectAllArticlesCheckBox_Unchecked"/>

                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <CheckBox Style="{StaticResource ArticleTouchCheckBoxStyle}"
                                      Tag="{Binding}"
                                      Loaded="ArticleCheckBox_Loaded"
                                      Checked="ArticleCheckBox_Checked"
                                      Unchecked="ArticleCheckBox_Unchecked"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- ARTICLE DETAILS                                   -->
                <!-- ================================================= -->

                <Border Grid.Column="4"
                    Style="{StaticResource ArticlesCard}"
                    Padding="18">

                    <Grid DataContext="{Binding SelectedArticle}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="165"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Odabrani artikal"
                                   Style="{StaticResource ArticlesSectionTitle}"/>

                            <TextBlock Text="Detalji artikla"
                                   Style="{StaticResource ArticlesSectionDescription}"
                                   Margin="0,3,0,0"/>

                        </StackPanel>

                        <!-- IMAGE -->

                        <Border Grid.Row="2"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">

                            <Grid>

                                <TextBlock Text="Nema slike"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="13"
                                       Opacity="0.45"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding SlikaSource}"
                                                         Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <Image Source="{Binding SlikaSource}"
                                   Width="150"
                                   Height="145"
                                   Stretch="None"
                                   StretchDirection="Both"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- NAME -->

                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Naziv"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Artikl}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- CODE -->

                        <Grid Grid.Row="5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Šifra"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Sifra}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- INTERNAL CODE -->

                        <Grid Grid.Row="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Interna šifra"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding InternaSifra}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- PRICE -->

                        <Grid Grid.Row="7">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Cijena"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">

                                <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}"
                                       Style="{StaticResource ArticleDetailValue}"/>

                                <TextBlock Text=" €"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                        <!-- UNIT -->

                        <Grid Grid.Row="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Jedinica mjere"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding JedinicaMjereName}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- TAX -->

                        <Grid Grid.Row="9">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Porez"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding PoreskaStopaPostotak}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- TYPE -->

                        <Grid Grid.Row="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Vrsta"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding VrstaArtiklaName}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- CATEGORY -->

                        <Grid Grid.Row="11">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Kategorija"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Kategorija}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- NORM -->

                        <Grid Grid.Row="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Normativ"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Normativ}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- POSITION -->

                        <Grid Grid.Row="13">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Pozicija"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding Pozicija}"
                                   Style="{StaticResource ArticleDetailValue}"/>

                        </Grid>

                        <!-- ACTIVE -->

                        <Grid Grid.Row="14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Aktivan"
                                   Style="{StaticResource ArticleDetailLabel}"/>

                            <TextBlock Grid.Column="1">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ArticleDetailValue}">

                                        <Setter Property="Text" Value="NE"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Aktivan}" Value="True">
                                                <Setter Property="Text" Value="DA"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- TEMPORARY LEGACY CONTROLS                             -->
            <!-- ===================================================== -->

            <Grid Visibility="Collapsed">

                <Grid x:Name="InternaSifraGrid"/>
                <Grid x:Name="SlikaGrid"/>
                <Grid x:Name="JedinicaMjereGrid"/>
                <Grid x:Name="PoreskeStopeGrid"/>
                <Grid x:Name="NormativGrid"/>
                <Grid x:Name="VrstaArtiklaGrid"/>
                <Grid x:Name="KategorijaGrid"/>
                <Grid x:Name="PozicijaGrid"/>
                <Grid x:Name="PrikazGrid"/>
                <Grid x:Name="ArtiklNormativGrid"/>
                <Grid x:Name="EditGrid"/>
                <Grid x:Name="AddGrid"/>

                <TextBox x:Name="IdArtiklaTextBox"/>
                <TextBox x:Name="SifraTextBox"/>
                <TextBox x:Name="ArtiklTextBox" TextChanged="ArtiklTextBox_TextChanged"/>
                <TextBox x:Name="CijenaTextBox"/>
                <TextBox x:Name="InternaSifraTextBox"/>
                <TextBox x:Name="SlikaTextBox"/>
                <TextBox x:Name="PozicijaTextBox"/>
                <TextBox x:Name="ArtiklNormativTextBox"/>

                <ComboBox x:Name="JediniceMjerePicker"/>
                <ComboBox x:Name="PoreskeStopePicker"/>
                <ComboBox x:Name="NormativPicker"/>
                <ComboBox x:Name="VrstaArtiklaPicker"/>
                <ComboBox x:Name="KategorijePicker"/>

                <ComboBox x:Name="PrikazatiNaDisplejuPicker">
                    <system:String>DA</system:String>
                    <system:String>NE</system:String>
                </ComboBox>

                <Button x:Name="btnSlika"/>
                <Button x:Name="btnKategorija"/>

                <Button x:Name="SaveEditButton"/>
                <Button x:Name="CancelEditButton"/>
                <Button x:Name="SaveAddButton"/>
                <Button x:Name="CancelAddButton"/>

                <Label x:Name="lblArtikl"/>
                <Label x:Name="lblCijena"/>

            </Grid>

        </Grid>

        <Grid x:Name="BatchEditGrid"
      Panel.ZIndex="999"
      Background="#77000000"
      Visibility="Collapsed">

            <Border Width="460"
            Height="720"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Background="{DynamicResource GlobalBackgroundColor}"
            BorderBrush="{DynamicResource GlobalFontColor}"
            BorderThickness="0.5"
            CornerRadius="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <!-- NASLOV -->
                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Grupno uređivanje artikala"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                        <TextBlock x:Name="BatchEditSelectedCountText"
                           Text="Označeno: 0 artikala"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="12"
                           Opacity="0.65"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- CIJENA -->
                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Promjena cijene"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchPriceOperationComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="BatchPriceOperationComboBox_SelectionChanged">

                            <ComboBoxItem Content="Postavi cijenu"/>
                            <ComboBoxItem Content="Povećaj za %"/>
                            <ComboBoxItem Content="Smanji za %"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- VRIJEDNOST CIJENE / POSTOTAK -->
                    <StackPanel Grid.Row="4">

                        <TextBlock x:Name="BatchValueLabel"
                           Text="Nova cijena"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <TextBox x:Name="BatchValueTextBox"
                         Height="38"
                         Style="{DynamicResource TextBoxCustom}"
                         Background="Transparent"
                         Foreground="{DynamicResource GlobalFontColor}"
                         CaretBrush="{DynamicResource GlobalFontColor}"
                         BorderThickness="0,0,0,1"
                         FontSize="17"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Grid.Row="6">

                        <TextBlock Text="Status artikla"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchActiveComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">

                            <ComboBoxItem Content="Ne mijenjaj"/>
                            <ComboBoxItem Content="Aktivan"/>
                            <ComboBoxItem Content="Neaktivan"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- KATEGORIJA -->
                    <StackPanel Grid.Row="8">

                        <TextBlock Text="Kategorija"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchCategoryComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- PORESKA STOPA -->
                    <StackPanel Grid.Row="10">

                        <TextBlock Text="Poreska stopa"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchTaxComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- POREZ NA POTROŠNJU - SAMO HRVATSKA -->
                    <StackPanel x:Name="BatchConsumptionTaxPanel"
                        Grid.Row="12"
                        Visibility="Collapsed">

                        <TextBlock Text="Porez na potrošnju"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchConsumptionTaxComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">

                            <ComboBoxItem Content="Ne mijenjaj"/>
                            <ComboBoxItem Content="DA"/>
                            <ComboBoxItem Content="NE"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- JEDINICA MJERE -->
                    <StackPanel Grid.Row="14">

                        <TextBlock Text="Jedinica mjere"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchUnitComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- DUGMAD -->
                    <Grid Grid.Row="16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                        Height="44"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnBatchEditCancel_Click">

                            <TextBlock Text="Odustani"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                        </Button>

                        <Button Grid.Column="2"
                        Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnBatchEditApply_Click">

                            <TextBlock Text="Primijeni"
                               Foreground="#F5F5F5"/>

                        </Button>

                    </Grid>

                </Grid>

            </Border>

        </Grid>
    </Grid>

</UserControl>