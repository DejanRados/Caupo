                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Grid.Row="6">

                        <TextBlock Text="Status artikla"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchActiveComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">

                            <ComboBoxItem Content="Ne mijenjaj"/>
                            <ComboBoxItem Content="Aktivan"/>
                            <ComboBoxItem Content="Neaktivan"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- KATEGORIJA -->
                    <StackPanel Grid.Row="8">

                        <TextBlock Text="Kategorija"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchCategoryComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- PORESKA STOPA -->
                    <StackPanel Grid.Row="10">

                        <TextBlock Text="Poreska stopa"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchTaxComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- POREZ NA POTROŠNJU - SAMO HRVATSKA -->
                    <StackPanel x:Name="BatchConsumptionTaxPanel"
                        Grid.Row="12"
                        Visibility="Collapsed">

                        <TextBlock Text="Porez na potrošnju"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchConsumptionTaxComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">

                            <ComboBoxItem Content="Ne mijenjaj"/>
                            <ComboBoxItem Content="DA"/>
                            <ComboBoxItem Content="NE"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- JEDINICA MJERE -->
                    <StackPanel Grid.Row="14">

                        <TextBlock Text="Jedinica mjere"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                        <ComboBox x:Name="BatchUnitComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- DUGMAD -->
                    <Grid Grid.Row="16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                        Height="44"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="BtnBatchEditCancel_Click">

                            <TextBlock Text="Odustani"
                               Foreground="{DynamicResource GlobalFontColor}"/>

                        </Button>

                        <Button Grid.Column="2"
                        Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnBatchEditApply_Click">

                            <TextBlock Text="Primijeni"
                               Foreground="#F5F5F5"/>

                        </Button>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

