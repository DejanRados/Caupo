<UserControl x:Class="Caupo.Views.NormsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             mc:Ignorable="d"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <Style x:Key="NormsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NormsSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="NormsCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="NormsDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NormsDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource GlobalBackgroundColor}">

        <Grid x:Name="MainContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <uc:CaupoHeader Grid.Row="0" Title="Caupo - Normativi" Close="CloseButton_Click"/>

            <Grid Grid.Row="1" Margin="24,12,24,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <uc:CaupoSearchBar
                        x:Name="NormSearchBar"
                        SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Suggestions="{Binding SearchSuggestions}"
                        SuggestionSelected="NormSearchBar_SuggestionSelected"
                        FirstCommand="{Binding FirstJeloCommand}"
                        PreviousCommand="{Binding PreviousJeloCommand}"
                        NextCommand="{Binding NextJeloCommand}"
                        LastCommand="{Binding LastJeloCommand}"/>


                    <Popup IsOpen="{Binding IsSuggestionsOpen}"
                            PlacementTarget="{Binding ElementName=NormSearchBar}"
                            Placement="Bottom" VerticalOffset="8"
                            StaysOpen="False" AllowsTransparency="True"
                            PopupAnimation="Fade">
                        <Border Width="330" MaxHeight="350"
                                Background="{DynamicResource GlobalBackgroundColor}"
                                BorderBrush="#666666" BorderThickness="1"
                                 CornerRadius="8" Padding="5">
                            <ListBox x:Name="IngredientSearchResults"
                                  ItemsSource="{Binding Suggestions}"
                                  Background="Transparent"
                                  Foreground="{DynamicResource GlobalFontColor}"
                                  BorderThickness="0" MaxHeight="330"
                                  >      
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Artikl}"
                                            Foreground="{DynamicResource GlobalFontColor}"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="8,7"/>  
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>






                </Grid>

                <Grid Grid.Column="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="48" Margin="0,0,8,0" Padding="5" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Background="Transparent">
                        <DockPanel>

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       FontSize="22"
                                       Width="34"
                                       FontWeight="ExtraLight"
                                       Text="&#60013;"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       Opacity="0.65"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="SearchIngredientTextBox"
                                     Style="{StaticResource TextBoxCustom}"
                                     Text="{Binding SearchTextIngredient, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="TextBox_GotFocus"
                                     LostFocus="TextBox_LostFocus"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     CaretBrush="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Padding="5,0"
                                     VerticalContentAlignment="Center"/>

                        </DockPanel>
                    </Border>

                </Grid>

            </Grid>

            <Grid Grid.Row="2" Margin="24,4,24,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LIJEVA STRANA -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ODABRANI ARTIKAL -->

                    <Border Grid.Row="0" Style="{StaticResource NormsCard}" Padding="18">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Odabrani artikal" Style="{StaticResource NormsSectionTitle}"/>

                                <TextBlock Text="Podaci za obračun normativa" Style="{StaticResource NormsSectionDescription}" Margin="0,3,0,0"/>

                            </StackPanel>

                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Artikal" Style="{StaticResource NormsDetailLabel}"/>
                                <TextBlock x:Name="lblJelo" Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJelo.Artikl}" Style="{StaticResource NormsDetailValue}" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Text="Proizvodna cijena" Style="{StaticResource NormsDetailLabel}"/>
                                <TextBlock x:Name="lblProizvodnaCijena" Grid.Row="1" Grid.Column="1" Text="{Binding ProizvodnaCijena, StringFormat={}{0:F2} KM}" Style="{StaticResource NormsDetailValue}"/>

                                <TextBlock Grid.Row="2" Text="Prodajna cijena" Style="{StaticResource NormsDetailLabel}"/>
                                <TextBlock x:Name="lblProdajnaCijena" Grid.Row="2" Grid.Column="1" Text="{Binding ProdajnaCijena, StringFormat={}{0:F2} KM}" Style="{StaticResource NormsDetailValue}"/>

                                <TextBlock Grid.Row="3" Text="Marža" Style="{StaticResource NormsDetailLabel}"/>
                                <TextBlock x:Name="lblMarža" Grid.Row="3" Grid.Column="1" Text="{Binding Marza}" Style="{StaticResource NormsDetailValue}"/>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- NORMATIV -->

                    <Border Grid.Row="2" Style="{StaticResource NormsCard}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,0">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Normativ" Style="{StaticResource NormsSectionTitle}"/>

                                    <TextBlock Text="Sastav odabranog artikla" Style="{StaticResource NormsSectionDescription}" Margin="0,2,0,0"/>

                                </StackPanel>

                            </Grid>

                            <DataGrid x:Name="ListaNormativ"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Norm}"
                                      SelectedItem="{Binding SelectedNorm, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      MouseUp="ListaNormativ_MouseDoubleClick"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      BorderBrush="{DynamicResource GlobalFontColor}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      SelectionMode="Single"
                                      ClipToBounds="True">

                                <DataGrid.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Namirnica" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Repromaterijal}" TextWrapping="Wrap" TextAlignment="Left" TextTrimming="CharacterEllipsis" Padding="8,0" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Jed.mjere" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding JedinicaMjere}" TextAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Cijena" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Cijena, StringFormat={}{0:F2}}" TextAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Količina" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Kolicina, StringFormat={}{0:F2}}" TextAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Iznos" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Ukupno, StringFormat={}{0:F2}}" TextAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="#" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        BorderBrush="#ff3232"
                                                        BorderThickness="1"
                                                        Width="38"
                                                        Height="32"
                                                        Margin="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                               FontSize="18"
                                                               FontWeight="ExtraLight"
                                                               Text="&#xEA81;"
                                                               Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                </Button>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                </Grid>

                <!-- NAMIRNICE -->

                <Border Grid.Column="2" Style="{StaticResource NormsCard}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Namirnice" Style="{StaticResource NormsSectionTitle}"/>

                                <TextBlock Text="Pregled raspoloživih namirnica" Style="{StaticResource NormsSectionDescription}" Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>

                        <DataGrid x:Name="ListaNamirnica"
                                  Grid.Row="1"
                                  ItemsSource="{Binding IngredientFilter}"
                                  SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                                  SelectionChanged="ListaNamirnica_SelectionChanged"
                                  AutoGenerateColumns="False"
                                  MouseUp="ListaNamirnica_MouseDoubleClick"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  BorderBrush="{DynamicResource GlobalFontColor}"
                                  Foreground="{DynamicResource GlobalFontColor}"
                                  SelectionMode="Single"
                                  ClipToBounds="True">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Namirnica" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Repromaterijal}" TextWrapping="Wrap" TextAlignment="Left" TextTrimming="CharacterEllipsis" Padding="8,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jed.mjere" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JedinicaMjere}" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nab. cijena" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NabavnaCijena, StringFormat={}{0:F2}}" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>