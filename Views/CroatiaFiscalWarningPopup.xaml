<Window x:Class="Caupo.Views.CroatiaFiscalWarningPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caupo - fiskalno upozorenje"
        Width="560"
        Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#323232">

    <Border Margin="2"
            Padding="30"
            BorderBrush="#D9534F"
            BorderThickness="3"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="VAŽNO FISKALNO UPOZORENJE"
                       Foreground="#F5F5F5"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding WarningText}"
                       Foreground="#F5F5F5"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>

            <StackPanel Grid.Row="3"
                        Margin="0,25,0,0">

                <TextBlock Text="Unesite šifru ovlaštenog radnika za potvrdu:"
                           Foreground="#F5F5F5"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="txtPassword" Style="{DynamicResource PasswordBoxCustom}"
                             Height="42"
                             FontSize="20"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtPassword_KeyDown"/>
            </StackPanel>

            <Grid Grid.Row="4"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtError"
                           Foreground="#FF6B6B"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"  Style="{StaticResource PrimaryButtonStyle}"
                        Content="POTVRDI"
                        Height="44"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="BtnConfirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>