<UserControl x:Class="Caupo.Views.OrdersPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Caupo.ViewModels"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        mc:Ignorable="d"
        Loaded="Window_Loaded">

    <Grid x:Name="MainContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="#323232">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Grid.Column="0"
                   Content="Caupo - Stolovi"
                   Foreground="#fafafa"
                   FontSize="25"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Grid.Column="1"
                   Content="Ime i prezime"
                   Foreground="#fafafa"
                   FontSize="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- SADRŽAJ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <!-- SALE I STOLOVI -->
            <TabControl x:Name="tabControl"
                        Grid.Column="0"
                        
                        SelectionChanged="tabControl_SelectionChanged"
                        Background="#11000000"
                        Foreground="{DynamicResource GlobalFontColor}"
                        Margin="5">

                <!-- Sve stvarne sale kreiraju se dinamički -->
                <TabItem x:Name="TabAdd"
                         Header="&#xE710;"
                         FontFamily="Segoe MDL2 Assets"
                         Width="65"
                         Height="65"
                         FontSize="18"
                         Foreground="{DynamicResource GlobalFontColor}"/>
            </TabControl>

            <!-- DESNI TOOLBAR -->
            <StackPanel Grid.Column="1"
            Background="#323232"
            Margin="-1"
            VerticalAlignment="Stretch">

                <!-- NORMALNI REŽIM -->
                <Button x:Name="EditLayoutButton"
            Style="{StaticResource PrimaryButtonStyle}"
            Height="65"
            Margin="10,15,10,5"
            Padding="5"
            Click="EditLayoutButton_Click">

                    <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE70F;"
                       FontSize="20"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"/>

                        <TextBlock Text="Uredi" FontSize="18"
                       Foreground="{DynamicResource GlobalFontColor}"
                       VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- REŽIM UREĐIVANJA -->
                <StackPanel x:Name="LayoutEditPanel"
                Visibility="Collapsed">

                    <Button x:Name="AddTableButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="65"
                Margin="10,15,10,5"
                Padding="5"
                Click="AddTableButton_Click">

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE710;"
                           FontSize="20"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"/>

                            <TextBlock Text="Dodaj sto" FontSize="18"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteLayoutButton"
                Style="{StaticResource DestructiveButtonStyle}"
                Height="65"
                Margin="10,5"
                Padding="5"
                Click="DeleteButton_Click">

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                           Text="&#60039;"
                           FontSize="20"
                           Margin="0,0,10,0"
                           Foreground="#F5F5F5"
                           VerticalAlignment="Center"/>

                            <TextBlock Text="Obriši" FontSize="18"
                           Foreground="#F5F5F5"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveAddButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="65"
                Margin="10,5"
                Padding="5"
                Click="SaveButton_Click">

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                           Text="&#xEB4B;"
                           FontSize="20"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"/>

                            <TextBlock Text="Spremi" FontSize="18"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>