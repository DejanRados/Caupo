<UserControl x:Class="Caupo.Views.KnjigaSankaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="Window_Loaded">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- DATAGRID CELL                                         -->
        <!-- ===================================================== -->

        <Style x:Key="LedgerCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
        </Style>

        <!-- ===================================================== -->
        <!-- TEKST U ĆELIJAMA                                      -->
        <!-- ===================================================== -->

        <Style x:Key="LedgerTextLeftStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="LedgerTextCenterStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="LedgerTextRightStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- ===================================================== -->
        <!-- RED DATAGRIDA                                         -->
        <!-- ===================================================== -->

        <Style x:Key="LedgerRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">

                        <Border x:Name="Border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="2"
                                SnapsToDevicePixels="True"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Stretch">

                            <DataGridCellsPresenter x:Name="DataGridCellsPresenter"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <DataTrigger Binding="{Binding IsPromet}" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#302FA4A9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF2FA4A9"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                            </DataTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#555FB7B7"/>
                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF5FB7B7"/>
                                <Setter Property="Foreground" Value="#2D2D30"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================== -->
        <!-- DATE PICKER TEXTBOX                                   -->
        <!-- ===================================================== -->

        <Style x:Key="LedgerDatePickerTextBoxStyle" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Text">
                <Setter.Value>
                    <Binding Path="SelectedDate"
                             RelativeSource="{RelativeSource AncestorType=DatePicker}"
                             StringFormat="dd.MM.yyyy"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ========================================================= -->
    <!-- GLAVNI GRID                                               -->
    <!-- ========================================================= -->

    <Grid Background="{DynamicResource GlobalBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0" Background="{DynamicResource HeaderBackgroundColor}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Grid.Column="0"
                   Content="Caupo - Knjiga šanka"
                   Foreground="#FAFAFA"
                   FontSize="25"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Grid.Column="1"
                   Content="Ime i prezime"
                   Foreground="#FAFAFA"
                   FontSize="15"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"/>

        </Grid>

        <!-- ===================================================== -->
        <!-- TOOLBAR                                               -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1" Margin="24,12,24,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DATUM -->

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="BtnPreviousDay"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PreviousDayCommand}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Margin="0,0,8,0"
                        ToolTip="Prethodni dan">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="24"
                               FontWeight="ExtraLight"
                               Text="&#xEB6F;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

                <Border Width="190"
                        Height="48"
                        Margin="0,0,8,0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource GlobalFontColor}"
                        CornerRadius="6"
                        Background="Transparent">

                    <DatePicker x:Name="DpDate"
                                CalendarStyle="{StaticResource styleCalendar}"
                                Language="bs-BA"
                                
                                SelectedDate="{Binding OdabraniDatum, Mode=TwoWay}"
                                SelectedDateFormat="Short"
                                Focusable="False"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource GlobalFontColor}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="15">

                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox"
                                   BasedOn="{StaticResource LedgerDatePickerTextBoxStyle}"/>
                        </DatePicker.Resources>

                    </DatePicker>

                </Border>

                <Button x:Name="BtnNextDay"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding NextDayCommand}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        ToolTip="Sljedeći dan">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="24"
                               FontWeight="ExtraLight"
                               Text="&#xEB70;"
                               Foreground="{DynamicResource GlobalFontColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

            </StackPanel>

            <!-- ŠTAMPA -->

            <Button x:Name="BtnPrint"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PrintCommand}"
                    Width="130"
                    Height="48"
                    HorizontalAlignment="Right">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               FontSize="22"
                               FontWeight="ExtraLight"
                               Text="&#xE749;"
                               Foreground="White"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Štampaj"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

        <!-- ===================================================== -->
        <!-- SADRŽAJ                                               -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2" Margin="24,0,24,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- SEKCIJA KNJIGE ŠANKA                              -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Width="1200"
                    MaxWidth="1200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource GlobalFontColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ========================================= -->
                    <!-- ZAGLAVLJE SEKCIJE                         -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="0" Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- FIRMA -->

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">

                            <TextBlock Text="{Binding Firma.NazivFirme}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,3"/>

                            <TextBlock Text="{Binding Firma.Adresa}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="12"
                                       Opacity="0.75"
                                       Margin="0,0,0,2"/>

                            <TextBlock Text="{Binding Firma.Grad}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="12"
                                       Opacity="0.75"
                                       Margin="0,0,0,2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="JIB: "
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"
                                           Opacity="0.60"/>
                                <TextBlock Text="{Binding Firma.JIB}"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="PDV: "
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"
                                           Opacity="0.60"/>
                                <TextBlock Text="{Binding Firma.PDV}"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- NASLOV -->

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Dnevni list šanka"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>

                            <TextBlock Text="{Binding OdabraniDatum, StringFormat='Pregled zaliha i prometa za {0:dd.MM.yyyy}'}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       Margin="0,4,0,0"
                                       TextAlignment="Center"/>

                        </StackPanel>

                        <!-- UKUPNO -->

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0">

                            <TextBlock Text="UKUPNO:"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Opacity="0.70"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="{Binding Total, StringFormat={}{0:F2}}"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                    <!-- ========================================= -->
                    <!-- SEPARATOR                                 -->
                    <!-- ========================================= -->

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{DynamicResource GlobalFontColor}"
                            Opacity="0.25"/>

                    <!-- ========================================= -->
                    <!-- DATAGRID                                  -->
                    <!-- ========================================= -->

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Knjiga}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              Foreground="{DynamicResource GlobalFontColor}"
                              BorderThickness="0"
                              FontSize="12"
                              Margin="0,12,0,0"
                              ColumnHeaderHeight="58"
                              RowStyle="{StaticResource LedgerRowStyle}"
                              CellStyle="{StaticResource LedgerCellStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding RedniBroj}"
                                                Width="42"
                                                ElementStyle="{StaticResource LedgerTextCenterStyle}"/>

                            <DataGridTextColumn Header="Naziv robe"
                                                Binding="{Binding Naziv}"
                                                Width="2*"
                                                MinWidth="180"
                                                ElementStyle="{StaticResource LedgerTextLeftStyle}"/>

                            <DataGridTextColumn Header="JM"
                                                Binding="{Binding JedinicaMjere}"
                                                Width="55"
                                                ElementStyle="{StaticResource LedgerTextCenterStyle}"/>

                            <DataGridTextColumn Header="Prenesene zalihe iz prethodnog dana"
                                                Binding="{Binding OstatakOdJuce, StringFormat={}{0:0.00#}}"
                                                Width="1.15*"
                                                MinWidth="105"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Nabavke u toku dana"
                                                Binding="{Binding NabavljenoDanas, StringFormat={}{0:0.00#}}"
                                                Width="1*"
                                                MinWidth="95"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Ukupno zaduženje"
                                                Binding="{Binding NaStanju, StringFormat={}{0:0.00#}}"
                                                Width="1*"
                                                MinWidth="95"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Utrošak u toku dana"
                                                Binding="{Binding UtrosenoDanas, StringFormat={}{0:0.00#}}"
                                                Width="1*"
                                                MinWidth="95"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Cijena"
                                                Binding="{Binding Cijena, StringFormat={}{0:F2}}"
                                                Width="0.8*"
                                                MinWidth="80"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Iznos"
                                                Binding="{Binding Promet, StringFormat={}{0:F2}}"
                                                Width="0.9*"
                                                MinWidth="85"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                            <DataGridTextColumn Header="Ostatak robe - Prenos za naredni dan"
                                                Binding="{Binding OstatakZaSutra, StringFormat={}{0:0.00#}}"
                                                Width="1.2*"
                                                MinWidth="110"
                                                ElementStyle="{StaticResource LedgerTextRightStyle}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>