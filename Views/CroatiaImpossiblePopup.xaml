<Window x:Class="Caupo.Views.CroatiaImpossiblePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Caupo.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Title="Fiskalizacija računa">

    <Border HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#44000000">

        <Border Width="500"
                Height="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource GlobalFontColor}"
                Background="{DynamicResource GlobalBackgroundColor}"
                CornerRadius="20">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="105"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <!-- Naslov -->
                <Grid Grid.Row="0">

                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="32"
                               FontWeight="ExtraLight"
                               Text="&#xEA74;"
                               Width="40"
                               Height="40"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Prekini pokušaje fiskalizacije"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>

                <!-- Upozorenje -->
                <TextBlock Grid.Row="1"
                           Margin="20,15"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="15"
                           FontWeight="ExtraLight"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Text="Caupo više neće pokušavati fiskalizovati ovaj račun. Ovu opciju koristite samo ako je račun riješen na drugi način i više ga nije potrebno slati Poreznoj upravi."/>

                <!-- Admin šifra -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center">

                    <Label Content="Administratorska šifra"
                           Foreground="{DynamicResource GlobalFontColor}"
                           HorizontalContentAlignment="Center"/>

                    <PasswordBox x:Name="txtPassword"
                                 Width="300"
                                 Height="40"
                                 Margin="0,5,0,5"
                                 HorizontalAlignment="Center"
                                 BorderBrush="{DynamicResource GlobalFontColor}"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 CaretBrush="{DynamicResource GlobalFontColor}"
                                 KeyDown="TxtPassword_KeyDown"/>

                    <TextBlock x:Name="txtError"
                               Margin="10,5,10,0"
                               Foreground="{DynamicResource GlobalFontColor}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>

                </StackPanel>

                <!-- Dugmad -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="CancelButton"
                            Style="{StaticResource CancelButtonStyle}"
                            Width="150"
                            Height="50"
                            Margin="5"
                            Click="BtnCancel_Click"
                            Foreground="{DynamicResource GlobalFontColor}">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="5">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Margin="5"
                                       FontSize="20"
                                       Width="20"
                                       FontWeight="ExtraLight"
                                       Text="&#60039;"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Odustani"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlobalFontColor}"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="190"
                            Height="50"
                            Margin="5"
                            Click="BtnConfirm_Click">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Margin="5"
                                       FontSize="20"
                                       Width="20"
                                       FontWeight="ExtraLight"
                                       Text="&#xE73E;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Prekini pokušaje"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Border>

</Window>