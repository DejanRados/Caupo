<UserControl x:Class="Caupo.Views.BeverageInPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             Background="{DynamicResource GlobalBackgroundColor}">

    <UserControl.Resources>

        <!-- KARTICE -->
        <Style x:Key="UlazCard" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource GlobalBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

       
      

        <!-- TEKST U DATAGRIDU -->
        <Style x:Key="UlazGridText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="UlazGridNumber"
               TargetType="TextBlock"
               BasedOn="{StaticResource UlazGridText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContent">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- ZAGLAVLJE -->
        <uc:CaupoHeader Grid.Row="0"
                        Title="Caupo - Ulaz pića"
                        Close="CloseButton_Click"/>

        <!-- KOMANDNA TRAKA -->
        <Grid Grid.Row="1" Margin="18,10,18,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- PRETRAGA ULAZA -->
            <Grid Grid.Column="0" Margin="0,0,12,0">

                <Border Height="49"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8,0">

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="19"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   Opacity="0.65"
                                   VerticalAlignment="Center"
                                   Margin="3,0,10,0"/>

                        <TextBox x:Name="SearchTextBox"
                                 Style="{DynamicResource TextBoxCustom}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pretraži broj, datum ili dobavljača"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 GotFocus="SearchTextBox_GotFocus"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </DockPanel>

                </Border>

                <!-- REZULTATI PRETRAGE -->
                <Popup x:Name="StockInSearchPopup"
                       PlacementTarget="{Binding ElementName=SearchTextBox}"
                       Placement="Bottom"
                       VerticalOffset="8"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Width="330"
                            MaxHeight="350"
                            Background="{DynamicResource GlobalBackgroundColor}"
                            BorderBrush="#666666"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5">

                        <ListBox x:Name="StockInSearchResults"
                                 ItemsSource="{Binding StockInFilter}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 BorderThickness="0"
                                 MaxHeight="330"
                                 SelectionChanged="StockInSearchResults_SelectionChanged">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding BrojUlaza}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlobalFontColor}"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Dobavljac}"
                                                       Foreground="{DynamicResource GlobalFontColor}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding Datum, StringFormat={}{0:dd.MM.yyyy}}"
                                                       Foreground="{DynamicResource GlobalFontColor}"
                                                       Opacity="0.65"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>
                </Popup>

            </Grid>

            <!-- PRETHODNI -->
            <Button Grid.Column="1"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding PreviousStockInCommand}"
                    Width="49" Height="49" Margin="3"
                    ToolTip="Prethodni ulaz">
                <TextBlock Text="&#xE76B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"/>
            </Button>

            <!-- NAREDNI -->
            <Button Grid.Column="2"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding NextStockInCommand}"
                    Width="49" Height="49" Margin="3"
                    ToolTip="Naredni ulaz">
                <TextBlock Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"/>
            </Button>

            <!-- NOVI -->
            <Button Grid.Column="3"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding AddNewStockInCommand}"
                    Width="49" Height="49" Margin="3"
                    ToolTip="Novi ulaz">
                <TextBlock Text="&#xE710;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"/>
            </Button>

            <!-- ODBACI -->
            <Button Grid.Column="4"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding DiscardChangesCommand}"
                    Width="49" Height="49" Margin="3"
                    ToolTip="Odbaci nespremljene promjene">
                <TextBlock Text="&#xE72B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"/>
            </Button>

            <!-- ŠTAMPAJ -->
            <Button Grid.Column="6"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding PrintStockInCommand}"
                    Height="49" MinWidth="115" Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                    <TextBlock Text="Štampaj"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- SPREMI -->
            <Button Grid.Column="7"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding SaveStockInCommand}"
                    Height="49" MinWidth="125" Margin="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="19"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                    <TextBlock Text="Spremi"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- GLAVNI RADNI PROSTOR -->
        <Grid Grid.Row="2" Margin="18,2,18,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="570"/>
            </Grid.ColumnDefinitions>

            <!-- LIJEVO -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PODACI O ULAZU -->
                <Border Grid.Row="0"
                        Style="{DynamicResource UlazCard}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Podaci o ulazu"
                                       Style="{DynamicResource UlazSectionTitle}"/>
                            <TextBlock Text="Osnovni podaci dokumenta"
                                       FontSize="12"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <!-- BROJ ULAZA -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Broj ulaza:"
                                       Style="{DynamicResource UlazLabel}"/>

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Content="{Binding SelectedStockIn.BrojUlaza}"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Padding="6,0"/>

                            <!-- DATUM -->
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Datum:"
                                       Style="{DynamicResource UlazLabel}"/>



                                <DatePicker x:Name="DpDate" Grid.Row="1"
                                    Grid.Column="1"
                                            CalendarStyle="{DynamicResource styleCalendar}"
                                            Language="bs-BA"
                                            SelectedDate="{Binding SelectedStockIn.Datum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Short"
                                            Focusable="False"
                                           
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="{DynamicResource GlobalFontColor}"
                                            HorizontalContentAlignment="Center"
                                            HorizontalAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            FontSize="15">

                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource LedgerDatePickerTextBoxStyle}"/>
                                </DatePicker.Resources>

                            </DatePicker>

                           

                            <!-- DOBAVLJAČ -->
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Dobavljač:"
                                       Style="{DynamicResource UlazLabel}"/>

                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Suppliers}"
                                      DisplayMemberPath="Dobavljac"
                                      SelectedValuePath="Dobavljac"
                                      SelectedValue="{Binding SelectedStockIn.Dobavljac, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="36"
                                      FontSize="14"  MinWidth="350"
                                      HorizontalAlignment="Left"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,5"/>

                            <!-- BROJ FAKTURE -->
                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Broj fakture:"
                                       Style="{DynamicResource UlazLabel}"/>

                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     MinWidth="350"
                                     HorizontalAlignment="Left"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Text="{Binding SelectedStockIn.BrojFakture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,5"/>

                            <!-- RADNIK -->
                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Radnik:"
                                       Style="{DynamicResource UlazLabel}"/>

                            <Label Grid.Row="4"
                                   Grid.Column="1"
                                   Content="{Binding SelectedStockIn.RadnikName}"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Padding="6,0"/>

                        </Grid>

                    </Grid>
                </Border>

                <!-- ARTIKLI -->
                <Border Grid.Row="2"
                        Style="{DynamicResource UlazCard}"
                        Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Artikli"
                                       Style="{DynamicResource UlazSectionTitle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Tap za dodavanje"
                                       FontSize="12"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- PRETRAGA ARTIKALA -->
                        <Border Grid.Row="1"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="7"
                                Height="43"
                                Margin="3,0,3,8"
                                Padding="8,0">

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           Opacity="0.65"
                                           VerticalAlignment="Center"
                                           Margin="3,0,9,0"/>

                                <TextBox x:Name="SearchArticleTextBox"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Text="{Binding SearchArticleText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         ToolTip="Pretraži artikle"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- DATAGRID ARTIKALA -->
                        <DataGrid x:Name="ListaArikala"
                                  Grid.Row="2"
                                  ItemsSource="{Binding ArtikliFilter}"
                                  SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                                  Margin="0,3"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  BorderBrush="{DynamicResource GlobalFontColor}"
                                  Foreground="{DynamicResource GlobalFontColor}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeight="49"
                                  ColumnHeaderHeight="45"
                                  ClipToBounds="True">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar"  BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"  BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="MinHeight" Value="49"/>
                                    <EventSetter Event="MouseLeftButtonUp"
                                                 Handler="Artikl_MouseLeftButtonUp"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Naziv"
                                                        Width="2.5*"
                                                        SortMemberPath="Artikl">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Artikl}"
                                                       Style="{DynamicResource UlazGridText}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Šifra"
                                                        Width="*"
                                                        SortMemberPath="Sifra">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Sifra}"
                                                       Style="{DynamicResource UlazGridText}"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="JM"
                                                        Width="65"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JedinicaMjereName}"
                                                       Style="{DynamicResource UlazGridText}"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>

            </Grid>

            <!-- DESNO: STAVKE ULAZA -->
            <Border Grid.Column="2"
                    Style="{DynamicResource UlazCard}"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5,3,5,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Stavke ulaza"
                                       Style="{DynamicResource UlazSectionTitle}"/>

                            <TextBlock Text="Tap na stavku za izmjenu cijene, količine i rabata"
                                       FontSize="12"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#555555"
                                Padding="12,6"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Stavki: "
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="13"/>

                                <TextBlock Text="{Binding StockInItems.Count}"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- DATAGRID STAVKI -->
                    <DataGrid x:Name="ListaStavki"
                              Grid.Row="2"
                              ItemsSource="{Binding StockInItems}"
                              SelectedItem="{Binding SelectedStockInItem, Mode=TwoWay}"
                              Margin="0,5"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              BorderBrush="{DynamicResource GlobalFontColor}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="49"
                              ColumnHeaderHeight="45"
                              ClipToBounds="True">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="MinHeight" Value="49"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="Stavka_MouseLeftButtonUp"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- ARTIKL -->
                            <DataGridTemplateColumn Header="Artikl"
                                                    Width="2.2*"
                                                    MinWidth="130"
                                                    SortMemberPath="Artikl">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Artikl}"
                                                   Style="{DynamicResource UlazGridText}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- KOLIČINA -->
                            <DataGridTemplateColumn Header="Količina"
                                                    Width="0.85*"
                                                    MinWidth="75"
                                                    SortMemberPath="Kolicina">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kolicina, StringFormat={}{0:N2}}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- NABAVNA BEZ PDV -->
                            <DataGridTemplateColumn Header="Nab. bez PDV"
                                                    Width="1*"
                                                    MinWidth="100"
                                                    SortMemberPath="CijenaBezUPDV">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CijenaBezUPDV, StringFormat={}{0:N2}}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- NABAVNA SA PDV -->
                            <DataGridTemplateColumn Header="Nab. sa PDV"
                                                    Width="1*"
                                                    MinWidth="100"
                                                    SortMemberPath="CijenaSaUPDV">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CijenaSaUPDV, StringFormat={}{0:N2}}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- PRODAJNA CIJENA -->
                            <DataGridTemplateColumn Header="Cijena"
                                                    Width="0.9*"
                                                    MinWidth="80"
                                                    SortMemberPath="Cijena">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Cijena, StringFormat={}{0:N2}}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- PDV -->
                            <DataGridTemplateColumn Header="PDV"
                                                    Width="0.8*"
                                                    MinWidth="70"
                                                    SortMemberPath="IznosUPDVa">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IznosUPDVa, StringFormat={}{0:N2}}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STOPA -->
                            <DataGridTemplateColumn Header="Stopa %"
                                                    Width="0.8*"
                                                    MinWidth="70"
                                                    SortMemberPath="PoreskaStopaPostotak">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PoreskaStopaPostotak}"
                                                   Style="{DynamicResource UlazGridNumber}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- BRISANJE -->
                            <DataGridTemplateColumn Header=""
                                                    Width="65"
                                                    MinWidth="65"
                                                    CanUserSort="False"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource CancelButtonStyle}"
                                                Command="{Binding DataContext.DeleteArticleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="42"
                                                Height="40"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip="Ukloni stavku">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="19"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>

        </Grid>

        <!-- DONJA TRAKA -->
        <Border Grid.Row="3"
                BorderBrush="#555555"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource GlobalBackgroundColor}"
                Padding="24,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- STATUS -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,10,0">

                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#49A86E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="Fill" Value="#E7A33E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>

                    </Ellipse>

                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="Nema nespremljenih promjena"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Nespremljene promjene"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

                <!-- UKUPNO -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="UKUPNO BEZ PDV"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="{Binding IznosRacuna, StringFormat={}{0:N2}}"
                               Foreground="{DynamicResource GlobalFontColor}"
                               FontSize="27"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>
