<UserControl x:Class="Caupo.Views.BeverageInPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Caupo.ViewModels"
             xmlns:loc="clr-namespace:Caupo"
             xmlns:uc="clr-namespace:Caupo.UserControls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:Caupo="clr-namespace:Caupo"
             mc:Ignorable="d"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- BEVERAGE IN - COMMON STYLES                           -->
        <!-- ===================================================== -->

        <Style x:Key="BeverageInCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="BeverageInSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BeverageInSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource GlobalBackgroundColor}">

        <Grid x:Name="MainContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- HEADER                                                -->
            <!-- ===================================================== -->

            <uc:CaupoHeader Grid.Row="0" Title="Caupo - Ulaz pića" Close="CloseButton_Click"/>

            <!-- ===================================================== -->
            <!-- TOP TOOLBAR                                           -->
            <!-- ===================================================== -->

            <Grid Grid.Row="1" Margin="24,12,24,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- SEARCH + NAVIGATION                               -->
                <!-- ================================================= -->

                <Grid Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="48" Margin="0,0,8,0" Padding="5" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Background="Transparent">
                        <DockPanel>
                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="22" Width="34" FontWeight="ExtraLight" Text="&#60013;" Foreground="{DynamicResource GlobalFontColor}" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchTextBox" Style="{StaticResource TextBoxCustom}" CaretBrush="{DynamicResource GlobalFontColor}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource GlobalFontColor}" FontSize="15" VerticalContentAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="5,0"/>
                        </DockPanel>
                    </Border>

                    <Button x:Name="BtnFirst" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Width="48" Height="48" Padding="0" Click="BtnFirst_Click" ToolTip="Prvi artikl">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="22" FontWeight="ExtraLight" Text="&#60271;" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnLast" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Width="48" Height="48" Padding="0" Click="BtnLast_Click" ToolTip="Naredni artikl">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="22" FontWeight="ExtraLight" Text="&#60272;" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnNew" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Width="48" Height="48" Padding="0" Command="{Binding AddNewStockInCommand}" ToolTip="Novi ulaz">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="22" FontWeight="ExtraLight" Text="&#60000;" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnSave" Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Width="48" Height="48" Padding="0" Command="{Binding SaveStockInCommand}" ToolTip="Sačuvaj">
                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="22" FontWeight="ExtraLight" Text="&#xEB4B;" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                </Grid>

                <!-- ================================================= -->
                <!-- ACTIONS                                           -->
                <!-- ================================================= -->

                <Grid Grid.Column="2" HorizontalAlignment="Right">

                    <Button x:Name="BtnPrint" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="48" Margin="3" Click="BtnPrint_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,7,0" FontWeight="ExtraLight" Text="&#xE749;" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Štampaj" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </Grid>

            <!-- ===================================================== -->
            <!-- MAIN CONTENT                                          -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2" Margin="24,4,24,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- STOCK IN DETAILS                                  -->
                <!-- ================================================= -->

                <Border Grid.Column="0" Style="{StaticResource BeverageInCard}" Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Podaci o ulazu" Style="{StaticResource BeverageInSectionTitle}"/>
                            <TextBlock Text="Osnovni podaci dokumenta" Style="{StaticResource BeverageInSectionDescription}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2" VerticalAlignment="Top">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BROJ ULAZA -->

                            <Label Grid.Row="0" Grid.Column="0" Content="Broj ulaza:" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource TextBoxCustom}" Foreground="{DynamicResource GlobalFontColor}" Text="{Binding SelectedStockIn.BrojUlaza, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,5" BorderThickness="0,0,0,1"/>

                            <!-- DATUM -->

                            <Label Grid.Row="1" Grid.Column="0" Content="Datum:" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>

                            <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,0,1" CornerRadius="0" Height="35" VerticalAlignment="Center" Width="150" HorizontalAlignment="Left" Padding="0" Margin="1">

                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource GlobalFontColor}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="Gray"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DatePicker x:Name="DpDate" Focusable="False" CalendarStyle="{StaticResource styleCalendar}" SelectedDate="{Binding SelectedStockIn.Datum, Mode=TwoWay}" HorizontalAlignment="Left" Width="150" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource GlobalFontColor}" HorizontalContentAlignment="Left" VerticalAlignment="Center" Padding="5">

                                    <DatePicker.Resources>

                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType=DatePicker}" StringFormat="dd.MM.yyyy"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style TargetType="DatePicker">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Style>

                                    </DatePicker.Resources>

                                </DatePicker>

                            </Border>

                            <!-- DOBAVLJAČ -->

                            <Label Grid.Row="2" Grid.Column="0" Content="Dobavljač:" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,5" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Dobavljac" SelectedValuePath="Dobavljac" SelectedValue="{Binding SelectedStockIn.Dobavljac, Mode=TwoWay}"/>

                            <!-- BROJ FAKTURE -->

                            <Label Grid.Row="3" Grid.Column="0" Content="Broj fakture:" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{DynamicResource TextBoxCustom}" Foreground="{DynamicResource GlobalFontColor}" Text="{Binding SelectedStockIn.BrojFakture, Mode=TwoWay}" Width="150" HorizontalAlignment="Left" Margin="0,0,0,5" BorderThickness="0,0,0,1"/>

                            <!-- RADNIK -->

                            <Label Grid.Row="4" Grid.Column="0" Content="Radnik:" Foreground="{DynamicResource GlobalFontColor}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{DynamicResource TextBoxCustom}" Foreground="{DynamicResource GlobalFontColor}" Text="{Binding SelectedStockIn.RadnikName, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,5" BorderThickness="0,0,0,1"/>

                        </Grid>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- ARTICLES                                          -->
                <!-- ================================================= -->

                <Border Grid.Column="2" Style="{StaticResource BeverageInCard}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,12,16,0">
                            <TextBlock Text="Artikli" Style="{StaticResource BeverageInSectionTitle}"/>
                            <TextBlock Text="Odabir artikla za ulaz" Style="{StaticResource BeverageInSectionDescription}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Padding="5" Height="44" Margin="16,0" BorderThickness="1" Background="Transparent" BorderBrush="#3F3F46" CornerRadius="6">

                            <DockPanel>

                                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="21" Width="32" FontWeight="ExtraLight" Text="&#60013;" Foreground="{DynamicResource GlobalFontColor}" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBox x:Name="SearchArticleTextBox" CaretBrush="{DynamicResource GlobalFontColor}" Text="{Binding SearchArticleText, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource GlobalFontColor}" FontSize="15" VerticalContentAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="5,0">

                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>

                                </TextBox>

                            </DockPanel>

                        </Border>

                        <DataGrid x:Name="ListaArikala" Grid.Row="2" Margin="10" ItemsSource="{Binding ArtikliFilter}" SelectedItem="{Binding SelectedArticle, Mode=TwoWay}" MouseUp="ListaArikala_MouseDoubleClick" Foreground="{DynamicResource GlobalFontColor}" Padding="2" GridLinesVisibility="None" AutoGenerateColumns="False" Background="Transparent" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" ClipToBounds="True" BorderBrush="{DynamicResource GlobalFontColor}" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Naziv" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Artikl}" Height="60" TextAlignment="Left" TextWrapping="Wrap" Padding="10"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Sifra" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Sifra}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cijena" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jed.mjere" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JedinicaMjereName}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- STOCK IN ITEMS                                    -->
                <!-- ================================================= -->

                <Border Grid.Column="4" Style="{StaticResource BeverageInCard}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,12,16,0">
                            <TextBlock Text="Stavke ulaza" Style="{StaticResource BeverageInSectionTitle}"/>
                            <TextBlock Text="Lista stavki trenutnog ulaza" Style="{StaticResource BeverageInSectionDescription}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <DataGrid x:Name="ListaStavki" Grid.Row="1" Focusable="False" Margin="10" ItemsSource="{Binding StockInItems}" SelectedItem="{Binding SelectedStockInItem, Mode=TwoWay}" Foreground="{DynamicResource GlobalFontColor}" MouseUp="ListaStavki_MouseDoubleClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="2" GridLinesVisibility="None" AutoGenerateColumns="False" Background="Transparent" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" ClipToBounds="True" BorderBrush="{DynamicResource GlobalFontColor}" SelectionMode="Single">

                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource WideVerticalScrollBar}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Naziv" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Artikl}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Količina" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kolicina, StringFormat={}{0:0.00}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nab.cijena bez PDV" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CijenaBezUPDV, StringFormat={}{0:0.00}}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Nab.cijena sa PDV" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CijenaSaUPDV, StringFormat={}{0:0.00}}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cijena" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cijena, StringFormat={}{0:0.00}}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Iznos PDV" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IznosUPDVa, StringFormat={}{0:0.00}}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Stopa %" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PoreskaStopaPostotak}" HorizontalAlignment="Stretch" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Namirnica" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="BtnDelete" Style="{StaticResource CancelButtonStyle}" BorderBrush="Transparent" Command="{Binding DataContext.DeleteArticleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Width="30" Height="30" Padding="0" VerticalAlignment="Center" ToolTip="Obriši stavku">
                                                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon" FontSize="24" FontWeight="ExtraLight" Text="&#60033;" Foreground="{DynamicResource GlobalFontColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>