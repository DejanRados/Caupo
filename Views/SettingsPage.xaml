<UserControl x:Class="Caupo.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:viewmodels="clr-namespace:Caupo.ViewModels"
        xmlns:local="clr-namespace:Caupo.ViewModels"
        xmlns:loc="clr-namespace:Caupo.Helpers"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d">

    <Grid x:Name="MainContent"  >

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="55"
              Background="#323232">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Content="Caupo - Postavke"
                   Foreground="#fafafa"
                   FontSize="25"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Content="Ime i prezime"
                   Foreground="#fafafa"
                   FontSize="15"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"
                    Grid.Column="2"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- SPREMI                                                -->
        <!-- ===================================================== -->

        <Button VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Panel.ZIndex="999"
                Margin="0,70,50,100"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                BorderBrush="#65ff65"
                Width="140"
                Height="50"
                Foreground="{DynamicResource GlobalFontColor}">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                           Margin="6"
                           FontSize="24"
                           Width="35"
                           FontWeight="ExtraLight"
                           Text="&#xEB4B;"
                           Foreground="{DynamicResource GlobalFontColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Spremi"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource GlobalFontColor}"/>

            </StackPanel>

        </Button>


        <!-- ===================================================== -->
        <!-- TAB CONTROL                                           -->
        <!-- ===================================================== -->

        <TabControl x:Name="TabControl"
                    TabStripPlacement="Bottom"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Stretch"
                    
                    VerticalAlignment="Stretch"
                    Margin="0,56,0,0">

            <TabControl.Resources>

                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>
                </Style>

            </TabControl.Resources>


            <!-- ================================================= -->
            <!-- REGION                                            -->
            <!-- ================================================= -->

            <TabItem x:Name="CountryTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     HorizontalContentAlignment="Center"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     RenderOptions.EdgeMode="Aliased">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   FontWeight="ExtraLight"
                                   Text="&#xE774;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Region"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <Grid HorizontalAlignment="Center"
                      Width="500">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Foreground="{DynamicResource GlobalFontColor}"
                           Content="Izaberi region"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="16"/>

                    <ComboBox x:Name="cmbRegion"
                              ItemsSource="{Binding Drzave}"
                              SelectedItem="{Binding OdabranaDrzava,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="9"
                              Width="200"
                              FontSize="16"
                              HorizontalAlignment="Left"/>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- FIRMA                                             -->
            <!-- ================================================= -->

            <TabItem x:Name="FirmaTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     RenderOptions.EdgeMode="Aliased">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEB06;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Firma"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <Grid HorizontalAlignment="Center"
                      Width="800">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="Naziv firme"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0"/>

                    <Label Content="Adresa"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0"/>

                    <Label Content="Mjesto"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0"/>

                    <Label Content="JIB"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="3"
                           Grid.Column="0"/>

                    <Label Content="PDV"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="4"
                           Grid.Column="0"/>

                    <Label Content="Email"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="5"
                           Grid.Column="0"/>

                    <Label Content="Žiroračun"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="6"
                           Grid.Column="0"/>

                    <Label Content="PDV obveznik"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="7"
                           Grid.Column="0"/>


                    <TextBox x:Name="txtFrima"
                             Text="{Binding Firma,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtAdresa"
                             Text="{Binding Adresa,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtMjesto"
                             Text="{Binding Mjesto,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtJIB"
                             Text="{Binding JIB,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtPDV"
                             Text="{Binding PDV,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="4"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtEmail"
                             Text="{Binding Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="5"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtZR"
                             Text="{Binding ZR,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="6"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <ComboBox x:Name="cmbPDV"
                              SelectedIndex="{Binding PDVKorisnik,
                                                      Mode=TwoWay}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              Grid.Row="7"
                              Grid.Column="1"
                              Margin="9"
                              Width="150"
                              HorizontalAlignment="Left">

                        <ComboBoxItem Content="NE"/>
                        <ComboBoxItem Content="DA"/>

                    </ComboBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- FBiH                                              -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaFBiHTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowFBIH,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <Grid HorizontalAlignment="Center"
                      Width="800">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="IP adresa servera"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0"/>

                    <TextBox x:Name="txtIpAddressTring"
                             Text="{Binding TringServerIpAddress,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- REPUBLIKA SRPSKA                                  -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaRSTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowRS,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <Grid HorizontalAlignment="Center"
                      Width="800">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="LPFR IP adresa"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="0"
                           Grid.Column="0"/>

                    <Label Content="LPFR API ključ"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0"/>

                    <Label Content="LPFR PIN"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="2"
                           Grid.Column="0"/>

                    <Label Content="LPFR eksterni printer"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="3"
                           Grid.Column="0"/>

                    <Label Content="Širina trake"
                           Foreground="{DynamicResource GlobalFontColor}"
                           VerticalAlignment="Center"
                           Grid.Row="4"
                           Grid.Column="0"/>


                    <TextBox x:Name="txtLPFRIP"
                             Text="{Binding LPFRIP,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtLPFRAPI"
                             Text="{Binding LPFRKey,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <TextBox x:Name="txtLPFRPIN"
                             Text="{Binding LPFRPin,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBoxCustom}"
                             Foreground="{DynamicResource GlobalFontColor}"
                             Background="Transparent"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="9"
                             Height="30"
                             BorderThickness="0,0,0,1"/>

                    <ComboBox x:Name="cmbExterniPrinter"
                              SelectedIndex="{Binding ExterniPrinter,
                                                      Mode=TwoWay}"
                              Foreground="{DynamicResource GlobalFontColor}"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="9"
                              Width="150"
                              HorizontalAlignment="Left">

                        <ComboBoxItem Content="NE"/>
                        <ComboBoxItem Content="DA"/>

                    </ComboBox>

                    <ComboBox x:Name="cmbSirinaTrake"
                              SelectedValue="{Binding SirinaTrake,
                                                      Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Foreground="{DynamicResource GlobalFontColor}"
                              Grid.Row="4"
                              Grid.Column="1"
                              Margin="9"
                              Width="150"
                              HorizontalAlignment="Left">

                        <ComboBoxItem Content="57"/>
                        <ComboBoxItem Content="80"/>

                    </ComboBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- HRVATSKA                                          -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaHrTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowHR,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,25,0,25">


                        <!-- ============================================= -->
                        <!-- HR - SERVER                                   -->
                        <!-- ============================================= -->

                        <TextBlock Text="Porezna uprava"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="Demo Server URL"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtDemoUrl"
                                     Text="{Binding DemoServerUrl,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                            <Label Content="Production Server URL"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtProdUrl"
                                     Text="{Binding ProductionServerUrl,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- HR - POSLOVNI PROSTOR                         -->
                        <!-- ============================================= -->

                        <TextBlock Text="Naplatni uređaj"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="Poslovni prostor"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPoslovniProstor"
                                     Text="{Binding PoslovniProstor,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                            <Label Content="Naplatni uređaj"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtNaplatniUredjaj"
                                     Text="{Binding NaplatniUredjaj,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                            <Label Content="Oznaka slijednosti"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="2"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbOznakaSlijednosti"
                                      SelectedIndex="{Binding OznakaSlijednosti,
                                                              Mode=TwoWay}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="9"
                                      Width="250"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="Na nivou naplatnog uređaja"/>
                                <ComboBoxItem Content="Na nivou poslovnog prostora"/>

                            </ComboBox>

                            <Label Content="Verzija aplikacije"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="3"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbVerzijaAplikacije"
                                      SelectedIndex="{Binding VerzijaAplikacije,
                                                              Mode=TwoWay}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="9"
                                      Width="150"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="Demo"/>
                                <ComboBoxItem Content="Produkcijska"/>

                            </ComboBox>

                            <Label Content="Porez na potrošnju %"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="4"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPnpStopa"
                                     Text="{Binding PnpStopa,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     Width="100"
                                     HorizontalAlignment="Left"
                                     BorderThickness="0,0,0,1"/>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- HR - CERTIFIKAT                               -->
                        <!-- ============================================= -->

                        <TextBlock Text="Certifikat"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="Certifikat"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtCertifikat"
                                     Text="{Binding CertificateName,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"
                                     IsReadOnly="True"/>

                            <Button x:Name="CertifikatButton"
                                    Command="{Binding SelectCroatiaCertificateCommand}"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Margin="5"
                                               Text="&#xEC50;"
                                               FontSize="20"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                            <Label Content="Certifikat zaporka"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtCertifikatPassword"
                                     Text="{Binding CertificatePassword,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- SRBIJA                                            -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaSrTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowSR,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>


                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">


                        <!-- ============================================= -->
                        <!-- SRBIJA - PFR KONFIGURACIJA                     -->
                        <!-- ============================================= -->

                        <TextBlock Text="PFR konfiguracija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Odaberite tip fiskalnog procesora i radno okruženje."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Tip PFR-a"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaPfrType"
                                          SelectedValue="{Binding SrbijaPfrType,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="VPFR"/>
                                    <ComboBoxItem Content="LPFR"/>

                                </ComboBox>

                                <Label Content="Okruženje"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaEnvironment"
                                          SelectedValue="{Binding SrbijaEnvironment,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Sandbox"/>
                                    <ComboBoxItem Content="Produkcija"/>

                                </ComboBox>

                            </Grid>

                        </Border>


                        <Separator Margin="9,18"/>


                        <!-- ============================================= -->
                        <!-- SRBIJA - VPFR                                 -->
                        <!-- ============================================= -->

                        <TextBlock Text="V-PFR"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Podešavanja za direktnu komunikaciju sa virtuelnim PFR servisom."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="V-PFR URL"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaVPFRUrl"
                                         Text="{Binding SrbijaVPFRUrl,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Certifikat"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaCertificate"
                                         Text="{Binding SrbijaCertificateName,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         IsReadOnly="True"
                                         BorderThickness="0,0,0,1"/>

                                <Button Command="{Binding SelectSrbijaCertificateCommand}"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi certifikat"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Foreground="{DynamicResource GlobalFontColor}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC50;"
                                               FontSize="19"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <Label Content="Certifikat zaporka"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="2"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaCertificatePassword"
                                         Text="{Binding SrbijaCertificatePassword,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PAC"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="3"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaPAC"
                                         Text="{Binding SrbijaPAC,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Jezik komunikacije"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="4"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaLanguage"
                                          SelectedValue="{Binding SrbijaAcceptLanguage,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="sr-Cyrl-RS"/>
                                    <ComboBoxItem Content="en-US"/>

                                </ComboBox>

                            </Grid>

                        </Border>


                        <Separator Margin="9,18"/>


                        <!-- ============================================= -->
                        <!-- SRBIJA - LPFR                                 -->
                        <!-- ============================================= -->

                        <TextBlock Text="L-PFR"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Podešavanja za komunikaciju sa lokalnim PFR servisom."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Token"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRToken"
                                         Text="{Binding SrbijaLPFRToken,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="L-PFR URL"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRUrl"
                                         Text="{Binding SrbijaLPFRUrl,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PIN"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="2"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRPin"
                                         Text="{Binding SrbijaLPFRPin,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="JID"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="3"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRJid"
                                         Text="{Binding SrbijaLPFRJid,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>


                        <Separator Margin="9,18"/>


                        <!-- ============================================= -->
                        <!-- SRBIJA - PROVJERA KOMUNIKACIJE                 -->
                        <!-- ============================================= -->

                        <TextBlock Text="Provjera komunikacije"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Provjerite da li je odabrani PFR dostupan i ispravno konfigurisan."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Status"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Grid.Column="0"/>

                                <TextBlock Text="{Binding SrbijaConnectionStatus}"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="9,0,15,0"
                                           Grid.Column="1"/>

                                <Button Command="{Binding TestSrbijaPfrCommand}"
                                        Grid.Column="2"
                                        Height="40"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        BorderBrush="#65ff65"
                                        Foreground="{DynamicResource GlobalFontColor}">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                   Text="&#xEB50;"
                                                   FontSize="18"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource GlobalFontColor}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="Testiraj"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GlobalFontColor}"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>


                        <Separator Margin="9,18"/>


                        <!-- ============================================= -->
                        <!-- SRBIJA - PORESKE STOPE                         -->
                        <!-- ============================================= -->

                        <Grid Margin="9,5,9,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Poreske stope"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Aktivne poreske stope preuzete direktno sa PFR-a."
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <Button Command="{Binding DobaviSrbijaPoreskeStopeCommand}"
                                    Grid.Column="1"
                                    Width="205"
                                    Height="40"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    BorderBrush="#65ff65"
                                    Foreground="{DynamicResource GlobalFontColor}"
                                    ToolTip="Preuzmi trenutno aktivne poreske stope sa PFR-a">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                               Text="&#xE895;"
                                               FontSize="18"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource GlobalFontColor}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="Dobavi poreske stope"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GlobalFontColor}"/>

                                </StackPanel>

                            </Button>

                        </Grid>


                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="1"
                                Margin="9,0,9,10">

                            <DataGrid ItemsSource="{Binding PoreskeStope}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#303036"
                                      VerticalGridLinesBrush="Transparent"
                                      Background="Transparent"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      BorderThickness="0"
                                      RowHeight="38"
                                      ColumnHeaderHeight="40"
                                      Height="300">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding IdStope}"
                                                        Width="70">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Opis"
                                                        Binding="{Binding Opis}"
                                                        Width="*">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="Margin"
                                                        Value="8,0,0,0"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Postotak"
                                                        Binding="{Binding Postotak,
                                                                          StringFormat={}{0:0.##}%}"
                                                        Width="130">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Right"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="Margin"
                                                        Value="0,0,15,0"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Oznaka"
                                                        Binding="{Binding Oznaka}"
                                                        Width="110">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- APLIKACIJA                                        -->
            <!-- ================================================= -->

            <TabItem x:Name="AplikacijaTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal"  >

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEA7A;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Aplikacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel HorizontalAlignment="Stretch"
                                MaxWidth="800"
                               >


                        <!-- ============================================= -->
                        <!-- DATOTEKE I BAZA                               -->
                        <!-- ============================================= -->

                        <TextBlock Text="Datoteke i baza podataka"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <Label Content="Logo"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtLogo"
                                     Text="{Binding LogoUrl,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="LogoButton"
                                    Command="{Binding SelectLogoCommand}"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xEB9F;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>


                            <Label Content="Lokacija rezervne kopije"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtBackup"
                                     Text="{Binding BackupUrl,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="BackupButton"
                                    Command="{Binding SelectBackupCommand}"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xF12B;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>


                            <!-- ===================================================== -->
                            <!-- TIP KASE -->
                            <!-- ===================================================== -->

                            <Label Content="Tip kase"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="2"
                                       Grid.Column="0"/>

                            <ComboBox x:Name="cmbCashRegisterType"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Margin="5"
                                       Width="300"
                                      Height="35"
                                      VerticalContentAlignment="Center"
                                      HorizontalAlignment="Left"
                                        SelectionChanged="CashRegisterType_SelectionChanged">
                                <ComboBoxItem Content="Glavna kasa"    Tag="Main"/>
                                <ComboBoxItem Content="Dodatna kasa"  Tag="Secondary"/>
                            </ComboBox>


                            <!-- ===================================================== -->
                            <!-- BAZA PODATAKA -->
                            <!-- ===================================================== -->

                            <Label Content="Baza podataka"
                               Foreground="{DynamicResource GlobalFontColor}"
                               VerticalAlignment="Center"
                               Grid.Row="3"
                               Grid.Column="0"/>

                            <TextBox x:Name="txtDBPath"
                                 Text="{Binding DbPath}"
                                 IsReadOnly="True"
                                 Style="{DynamicResource TextBoxCustom}"
                                 Foreground="{DynamicResource GlobalFontColor}"
                                 Background="Transparent"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="5"
                                 BorderThickness="0,0,0,1"/>

                            <Button x:Name="DbPathButton"
                                    Click="DbPathButton_Click"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}"
                                    Content="Pronađi"
                                    ToolTip="Pronađi glavnu kasu na mreži"/>

                            <TextBlock x:Name="txtCashRegisterStatus"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="5,2,5,0"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Top"
                                           Text="Glavna kasa - lokalna baza podataka."/>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- PRINTERI                                      -->
                        <!-- ============================================= -->

                        <TextBlock Text="Printeri"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>


                            <Label Content="Printer Šank"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPrinterSank"
                                     Text="{Binding SankPrinter,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="SankButton"
                                    Command="{Binding SelectSankPrinterCommand}"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xEC5B;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>


                            <Label Content="Printer Kuhinja"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPrinterKuhinja"
                                     Text="{Binding KuhinjaPrinter,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="KuhinjaButton"
                                    Command="{Binding SelectKuhinjaPrinterCommand}"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xEC5B;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>


                            <Label Content="Printer Računi"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="2"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPrinterRacuni"
                                     Text="{Binding POSPrinter,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="RacuniButton"
                                    Command="{Binding SelectPOSPrinterCommand}"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xEC5B;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>


                            <Label Content="Printer A4"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="3"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtPrinterA4"
                                     Text="{Binding A4Printer,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="5"
                                     BorderThickness="0,0,0,1"/>

                            <Button x:Name="A4Button"
                                    Command="{Binding SelectA4PrinterCommand}"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="2"
                                    Width="75"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource GlobalFontColor}">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Margin="5"
                                           Text="&#xE749;"
                                           FontSize="20"
                                           Foreground="{DynamicResource GlobalFontColor}"/>

                            </Button>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- PRODAJA                                       -->
                        <!-- ============================================= -->

                        <TextBlock Text="Prodaja"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="Broj kopija blokova"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbBrojKopijaBloka"
                                      SelectedValue="{Binding BrojKopijaBloka,
                                                              Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="5"
                                      Width="150"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>

                            </ComboBox>

                            <Label Content="Dozvoli prodaju u minus"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbProdajaMinus"
                                      SelectedIndex="{Binding ProdajaMinus,
                                                              Mode=TwoWay}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="5"
                                      Width="150"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="NE"/>
                                <ComboBoxItem Content="DA"/>

                            </ComboBox>

                            <Label Content="Višekorisničko okruženje"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="2"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbMultiUser"
                                      SelectedIndex="{Binding MultiUser,
                                                              Mode=TwoWay}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="5"
                                      Width="150"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="NE"/>
                                <ComboBoxItem Content="DA"/>

                            </ComboBox>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- PRIKAZ                                        -->
                        <!-- ============================================= -->

                        <TextBlock Text="Prikaz"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="Displej u kuhinji"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbDisplejKuhinja"
                                      ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="5"
                                      Width="250"
                                      HorizontalAlignment="Left"/>

                            <Label Content="Tema aplikacije"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbTema"
                                      SelectedIndex="{Binding Tema,
                                                              Mode=TwoWay}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="5"
                                      Width="150"
                                      HorizontalAlignment="Left">

                                <ComboBoxItem Content="Tamna"/>
                                <ComboBoxItem Content="Svijetla"/>

                            </ComboBox>

                        </Grid>


                        <Separator Margin="9,15"/>


                        <!-- ============================================= -->
                        <!-- MREŽA                                         -->
                        <!-- ============================================= -->

                        <TextBlock Text="Mreža"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,15"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <Label Content="IP adresa servera"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtIPServer"
                                     Text="{Binding ServerIP,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Width="200"
                                     HorizontalAlignment="Left"
                                     Margin="5"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- RADNICI                                           -->
            <!-- ================================================= -->

            <TabItem x:Name="RadniciTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEA7E;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Radnici"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <Grid HorizontalAlignment="Center"
                      Width="800"
                      VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="myListView"
                              Grid.Row="1"
                              Padding="2"
                              GridLinesVisibility="None"
                              Foreground="{DynamicResource GlobalFontColor}"
                              ItemsSource="{Binding Radnici}"
                              SelectedItem="{Binding SelectedRadnik,
                                                    Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              ClipToBounds="True"
                              BorderBrush="{DynamicResource GlobalFontColor}"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Resources>

                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource WideVerticalScrollBar}"/>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Radnik"
                                                    Width="2*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Radnik}"
                                                   Height="60"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   Padding="10"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="Dozvole"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Dozvole}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="Lozinka"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Lozinka}"
                                                   TextAlignment="Center"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="#"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0">

                                            <Button Command="{Binding DataContext.UpdateCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="35"
                                                    Height="35"
                                                    Margin="1">

                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Margin="5"
                                                           Text="&#xE70F;"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource GlobalFontColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Button>

                                            <Button Command="{Binding DataContext.DeleteCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    BorderBrush="#C93A3A"
                                                    MinWidth="35"
                                                    Height="35"
                                                    Margin="1">

                                                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                           Margin="2"
                                                           FontSize="19"
                                                           FontWeight="ExtraLight"
                                                           Text="&#xEA81;"
                                                           Foreground="{DynamicResource GlobalFontColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Button>

                                        </StackPanel>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>


                    <Button x:Name="NoviRadnikButton"
                            Command="{Binding NewRadnikCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="150"
                            Height="50"
                            Foreground="{DynamicResource GlobalFontColor}"
                            Margin="2"
                            Grid.Row="2">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                       Margin="6"
                                       FontSize="32"
                                       Width="35"
                                       FontWeight="ExtraLight"
                                       Text="&#xEBCD;"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Novi radnik"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlobalFontColor}"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>