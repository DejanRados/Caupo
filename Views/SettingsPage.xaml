                                          Grid.Column="1"
                                          Margin="9"
                                          Width="250"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Na nivou naplatnog uređaja"/>
                                    <ComboBoxItem Content="Na nivou poslovnog prostora"/>

                                </ComboBox>

                                <Label Content="Verzija aplikacije" Style="{StaticResource SettingsLabel}" Grid.Row="3" Grid.Column="0"/>

                                <ComboBox x:Name="cmbVerzijaAplikacije"
                                          SelectedIndex="{Binding VerzijaAplikacije, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Demo"/>
                                    <ComboBoxItem Content="Produkcijska"/>

                                </ComboBox>

                                <Label Content="Porez na potrošnju %" Style="{StaticResource SettingsLabel}" Grid.Row="4" Grid.Column="0"/>

                                <TextBox x:Name="txtPnpStopa"
                                         Text="{Binding PnpStopa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- CERTIFIKAT -->

                        <TextBlock Text="Certifikat" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Aplikacijski certifikat koji Caupo koristi za elektronsko potpisivanje i fiskalizaciju računa."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Certifikat" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtCertifikat"
                                         Text="{Binding CertificateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"
                                         IsReadOnly="True"/>

                                <Button x:Name="CertifikatButton"
                                        Command="{Binding SelectCroatiaCertificateCommand}"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi certifikat"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC50;"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <Label Content="Certifikat zaporka" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtCertifikatPassword"
                                         Text="{Binding CertificatePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>


                        <!-- PORESKE STOPE -->

                        <TextBlock Text="Poreske stope"
                                   Style="{StaticResource SettingsSectionTitle}"
                                   Margin="9,20,9,4"/>

                        <TextBlock Text="Poreske stope koje se koriste prilikom fiskalizacije računa."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <DataGrid ItemsSource="{Binding PoreskeStope}"
                                          SelectedItem="{Binding SelectedPoreskaStopa, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          RowHeight="42"
                                          ColumnHeaderHeight="38"
                                          MinHeight="160"
                                          MaxHeight="280"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource GlobalFontColor}">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="ID" Binding="{Binding IdStope}" Width="60"/>
                                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                                        <DataGridTextColumn Header="Postotak" Binding="{Binding Postotak, StringFormat={}{0:0.##}%}" Width="110"/>
                                        <DataGridTextColumn Header="Oznaka" Binding="{Binding Oznaka}" Width="100"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,15,0,0">

                                    <Button Command="{Binding NewPoreskaStopaCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Dodaj"/>
                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding UpdatePoreskaStopaCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Izmijeni"/>
                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding DeletePoreskaStopaCommand}"
                                            Style="{StaticResource DestructiveButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Obriši"/>
                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- SRBIJA                                            -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaSrTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowSR, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <!-- PFR KONFIGURACIJA -->

                        <TextBlock Text="PFR konfiguracija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Odaberite tip fiskalnog procesora i radno okruženje."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Tip PFR-a"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaPfrType"
                                          SelectedValue="{Binding SrbijaPfrType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="VPFR"/>
                                    <ComboBoxItem Content="LPFR"/>

                                </ComboBox>

                                <Label Content="Okruženje"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaEnvironment"
                                          SelectedValue="{Binding SrbijaEnvironment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Sandbox"/>
                                    <ComboBoxItem Content="Produkcija"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- VPFR -->

                        <TextBlock Text="V-PFR"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Podešavanja za direktnu komunikaciju sa virtuelnim PFR servisom."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="V-PFR URL"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaVPFRUrl"
                                         Text="{Binding SrbijaVPFRUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Certifikat"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaCertificate"
                                         Text="{Binding SrbijaCertificateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         IsReadOnly="True"
                                         BorderThickness="0,0,0,1"/>

                                <Button Command="{Binding SelectSrbijaCertificateCommand}"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi certifikat"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC50;"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <Label Content="Certifikat zaporka"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="2"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaCertificatePassword"
                                         Text="{Binding SrbijaCertificatePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PAC"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="3"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaPAC"
                                         Text="{Binding SrbijaPAC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Jezik komunikacije"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="4"
                                       Grid.Column="0"/>

                                <ComboBox x:Name="cmbSrbijaLanguage"
                                          SelectedValue="{Binding SrbijaAcceptLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="180"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="sr-Cyrl-RS"/>
                                    <ComboBoxItem Content="en-US"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- LPFR -->

                        <TextBlock Text="L-PFR"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Podešavanja za komunikaciju sa lokalnim PFR servisom."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Token"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="0"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRToken"
                                         Text="{Binding SrbijaLPFRToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="L-PFR URL"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRUrl"
                                         Text="{Binding SrbijaLPFRUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PIN"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="2"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRPin"
                                         Text="{Binding SrbijaLPFRPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="JID"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       VerticalAlignment="Center"
                                       Grid.Row="3"
                                       Grid.Column="0"/>

                                <TextBox x:Name="txtSrbijaLPFRJid"
                                         Text="{Binding SrbijaLPFRJid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- PROVJERA KOMUNIKACIJE -->

                        <TextBlock Text="Provjera komunikacije"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="9,5,9,4"/>

                        <TextBlock Text="Provjerite da li je odabrani PFR dostupan i ispravno konfigurisan."
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   Margin="9,0,9,12"/>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="9,0,9,5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Status"
                                       Foreground="{DynamicResource GlobalFontColor}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Grid.Column="0"/>

                                <TextBlock Text="{Binding SrbijaConnectionStatus}"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="9,0,15,0"
                                           Grid.Column="1"/>

                                <Button Command="{Binding TestSrbijaPfrCommand}"
                                        Grid.Column="2"
                                        Height="40"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                   Text="&#xEB50;"
                                                   FontSize="18"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="Testiraj"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- PORESKE STOPE -->

                        <Grid Margin="9,5,9,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Poreske stope"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Aktivne poreske stope preuzete direktno sa PFR-a."
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <Button Command="{Binding DobaviSrbijaPoreskeStopeCommand}"
                                    Grid.Column="1"
                                    Width="205"
                                    Height="40"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Preuzmi trenutno aktivne poreske stope sa PFR-a">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                               Text="&#xE895;"
                                               FontSize="18"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="Dobavi poreske stope"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                        <Border BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="1"
                                Margin="9,0,9,10">

                            <DataGrid ItemsSource="{Binding PoreskeStope}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#303036"
                                      VerticalGridLinesBrush="Transparent"
                                      Background="Transparent"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      BorderThickness="0"
                                      RowHeight="38"
                                      ColumnHeaderHeight="40"
                                      Height="300">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding IdStope}"
                                                        Width="70">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Opis"
                                                        Binding="{Binding Opis}"
                                                        Width="*">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="8,0,0,0"/>
                                                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Postotak"
                                                        Binding="{Binding Postotak, StringFormat={}{0:0.##}%}"
                                                        Width="130">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,15,0"/>
                                                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Oznaka"
                                                        Binding="{Binding Oznaka}"
                                                        Width="110">

                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- APLIKACIJA                                        -->
            <!-- ================================================= -->

            <TabItem x:Name="AplikacijaTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEA7A;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Aplikacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <!-- DATOTEKE I BAZA -->

                        <TextBlock Text="Datoteke i baza podataka" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Lokacije datoteka aplikacije, rezervne kopije i konfiguracija glavne ili dodatne kase."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <Label Content="Logo" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtLogo"
                                         Text="{Binding LogoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="LogoButton"
                                        Command="{Binding SelectLogoCommand}"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi logo"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEB9F;"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <Label Content="Lokacija rezervne kopije" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtBackup"
                                         Text="{Binding BackupUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="BackupButton"
                                        Command="{Binding SelectBackupCommand}"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi direktorij za rezervnu kopiju"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xF12B;"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <Label Content="Tip kase" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <ComboBox x:Name="cmbCashRegisterType"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Margin="9"
                                          Width="260"
                                          Height="32"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="CashRegisterType_SelectionChanged">

                                    <ComboBoxItem Content="Glavna kasa" Tag="Main"/>
                                    <ComboBoxItem Content="Dodatna kasa" Tag="Secondary"/>

                                </ComboBox>

                                <Label Content="Baza podataka" Style="{StaticResource SettingsLabel}" Grid.Row="3" Grid.Column="0"/>

                                <TextBox x:Name="txtDBPath"
                                         Text="{Binding DbPath}"
                                         IsReadOnly="True"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="DbPathButton"
                                        Click="DbPathButton_Click"
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Pronađi glavnu kasu na mreži">

                                    <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                               Text="&#xEA6D;"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Button>

                                <TextBlock x:Name="txtCashRegisterStatus"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Margin="9,2,9,0"
                                           FontSize="12"
                                           Opacity="0.70"
                                           Foreground="{DynamicResource GlobalFontColor}"
                                           VerticalAlignment="Top"
                                           TextWrapping="Wrap"
                                           Text="Glavna kasa - lokalna baza podataka."/>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- PRINTERI -->

                        <TextBlock Text="Printeri" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Odaberite printere koji se koriste za račune, šank, kuhinju i A4 dokumente."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Printer Šank" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtPrinterSank"
                                         Text="{Binding SankPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="SankButton"
                                        Command="{Binding SelectSankPrinterCommand}"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi printer za šank"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC5B;"
                                               FontSize="19"/>

                                </Button>

                                <Label Content="Printer Kuhinja" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtPrinterKuhinja"
                                         Text="{Binding KuhinjaPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="KuhinjaButton"
                                        Command="{Binding SelectKuhinjaPrinterCommand}"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi printer za kuhinju"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC5B;"
                                               FontSize="19"/>

                                </Button>

                                <Label Content="Printer Računi" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <TextBox x:Name="txtPrinterRacuni"
                                         Text="{Binding POSPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="RacuniButton"
                                        Command="{Binding SelectPOSPrinterCommand}"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi printer računa"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xEC5B;"
                                               FontSize="19"/>

                                </Button>

                                <Label Content="Printer A4" Style="{StaticResource SettingsLabel}" Grid.Row="3" Grid.Column="0"/>

                                <TextBox x:Name="txtPrinterA4"
                                         Text="{Binding A4Printer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Button x:Name="A4Button"
                                        Command="{Binding SelectA4PrinterCommand}"
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="4"
                                        Width="70"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Odaberi A4 printer"
                                        Style="{StaticResource SecondaryButtonStyle}">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE749;"
                                               FontSize="19"/>

                                </Button>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- PRODAJA -->

                        <TextBlock Text="Prodaja" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Opšta pravila rada kase i prodaje."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Broj kopija blokova" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <ComboBox x:Name="cmbBrojKopijaBloka"
                                          SelectedValue="{Binding BrojKopijaBloka, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>

                                </ComboBox>

                                <Label Content="Dozvoli prodaju u minus" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <ComboBox x:Name="cmbProdajaMinus"
                                          SelectedIndex="{Binding ProdajaMinus, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="NE"/>
                                    <ComboBoxItem Content="DA"/>

                                </ComboBox>

                                <Label Content="Višekorisničko okruženje" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <ComboBox x:Name="cmbMultiUser"
                                          SelectedIndex="{Binding MultiUser, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="NE"/>
                                    <ComboBoxItem Content="DA"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- PRIKAZ -->

                        <TextBlock Text="Prikaz" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Podešavanja monitora i izgleda aplikacije."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Displej u kuhinji" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <ComboBox x:Name="cmbDisplejKuhinja"
                                          ItemsSource="{Binding Monitors}"
                                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="300"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center"/>

                                <Label Content="Tema aplikacije" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <ComboBox x:Name="cmbTema"
                                          SelectedIndex="{Binding Tema, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Tamna"/>
                                    <ComboBoxItem Content="Svijetla"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- MREŽA -->

                        <TextBlock Text="Mreža" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Mrežna podešavanja koja Caupo koristi za komunikaciju sa drugim servisima i uređajima."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="IP adresa servera" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtIPServer"
                                         Text="{Binding ServerIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Width="220"
                                         Height="30"
                                         HorizontalAlignment="Left"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- RADNICI                                           -->
            <!-- ================================================= -->

            <TabItem x:Name="RadniciTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEA7E;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Radnici"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <TextBlock Text="Radnici" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Upravljanje korisnicima aplikacije, njihovim lozinkama i dozvolama."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}"
                                Padding="1">

                            <DataGrid x:Name="myListView"
                                      Padding="2"
                                      GridLinesVisibility="None"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      ItemsSource="{Binding Radnici}"
                                      SelectedItem="{Binding SelectedRadnik, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      RowHeight="55"
                                     
                                      ColumnHeaderHeight="40"
                                      MinHeight="280"
                                      MaxHeight="550"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Resources>

                                    <Style TargetType="ScrollBar"
                                           BasedOn="{StaticResource WideVerticalScrollBar}"/>
                                    
                                   

                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Radnik" Width="2*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>
                                               
                                                    <TextBlock Text="{Binding Radnik}" 
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           Padding="10,0"
                                                           Foreground="{DynamicResource GlobalFontColor}"/>
                                              
                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Dozvole" Width="*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Dozvole}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource GlobalFontColor}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Lozinka" Width="*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Lozinka}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource GlobalFontColor}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Akcije" Width="120">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">

                                                    <Button Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="55"
                                                            Height="36"
                                                            Margin="2"
                                                            ToolTip="Izmijeni radnika">

                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE70F;"
                                                                   FontSize="17"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                    </Button>

                                                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DestructiveButtonStyle}"
                                                            Width="55"
                                                            Height="36"
                                                            Margin="2"
                                                            ToolTip="Obriši radnika">

                                                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                                                   Text="&#xEA81;"
                                                                   FontSize="19"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                    </Button>

                                                </StackPanel>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>


                        <!-- NOVI RADNIK -->

