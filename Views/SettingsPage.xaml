<UserControl x:Class="Caupo.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             xmlns:viewmodels="clr-namespace:Caupo.ViewModels"
             xmlns:local="clr-namespace:Caupo.ViewModels"
             xmlns:loc="clr-namespace:Caupo.Helpers"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- SETTINGS - ZAJEDNIČKI STILOVI                         -->
        <!-- ===================================================== -->

        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="9,5,9,4"/>
        </Style>

        <Style x:Key="SettingsSectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="9,0,9,12"/>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="9,0,9,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="SettingsLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource GlobalFontColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>


    <Grid x:Name="MainContent">

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="55"
              Background="#323232">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/Images/dsoftlogosmall.png"
                   Width="50"
                   Height="50"
                   Grid.Column="0"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"/>

            <Label x:Name="lblApp"
                   Content="Caupo - Postavke"
                   Foreground="#fafafa"
                   FontSize="25"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Label x:Name="lblUlogovaniKorisnik"
                   Content="Ime i prezime"
                   Foreground="#fafafa"
                   FontSize="15"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>

            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseButtonStyle}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Margin="1"
                    Click="CloseButton_Click"
                    Grid.Column="2"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- SPREMI                                                -->
        <!-- ===================================================== -->

        <Button VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Panel.ZIndex="999"
                Margin="0,70,50,100"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="140"
                Height="50">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                           Margin="6"
                           FontSize="24"
                           Width="35"
                           FontWeight="ExtraLight"
                           Text="&#xEB4B;"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Spremi"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Button>


        <!-- ===================================================== -->
        <!-- TAB CONTROL                                           -->
        <!-- ===================================================== -->

        <TabControl x:Name="TabControl"
                    TabStripPlacement="Bottom"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="0,56,0,0">

            <TabControl.Resources>

                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>

            </TabControl.Resources>


            <!-- ================================================= -->
            <!-- REGION                                            -->
            <!-- ================================================= -->

            <TabItem x:Name="CountryTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     HorizontalContentAlignment="Center"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     RenderOptions.EdgeMode="Aliased">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   FontWeight="ExtraLight"
                                   Text="&#xE774;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Region"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <StackPanel HorizontalAlignment="Center"
                            Width="800"
                            Margin="0,20,0,35">

                    <TextBlock Text="Region aplikacije"
                               Style="{StaticResource SettingsSectionTitle}"/>

                    <TextBlock Text="Odaberite državu u kojoj se Caupo koristi. Fiskalna podešavanja biće prilagođena odabranom regionu."
                               Style="{StaticResource SettingsSectionDescription}"/>

                    <Border Style="{StaticResource SettingsCard}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <Label Content="Region"
                                   Style="{StaticResource SettingsLabel}"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <ComboBox x:Name="cmbRegion"
                                      ItemsSource="{Binding Drzave}"
                                      SelectedItem="{Binding OdabranaDrzava, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{DynamicResource GlobalFontColor}"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="9"
                                      Width="220"
                                      Height="32"
                                      HorizontalAlignment="Left"
                                      VerticalContentAlignment="Center"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </TabItem>


            <!-- ================================================= -->
            <!-- FIRMA                                             -->
            <!-- ================================================= -->

            <TabItem x:Name="FirmaTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     RenderOptions.EdgeMode="Aliased">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock FontFamily="pack://application:,,,/Assets/Fonts/#codicon"
                                   Margin="6"
                                   FontSize="32"
                                   Height="35"
                                   FontWeight="ExtraLight"
                                   Text="&#xEB06;"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Firma"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <TextBlock Text="Podaci firme"
                                   Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Osnovni podaci koji se koriste na računima, dokumentima i u fiskalizaciji."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Naziv firme" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtFrima"
                                         Text="{Binding Firma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Adresa" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtAdresa"
                                         Text="{Binding Adresa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Mjesto" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <TextBox x:Name="txtMjesto"
                                         Text="{Binding Mjesto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="JIB" Style="{StaticResource SettingsLabel}" Grid.Row="3" Grid.Column="0"/>

                                <TextBox x:Name="txtJIB"
                                         Text="{Binding JIB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PDV" Style="{StaticResource SettingsLabel}" Grid.Row="4" Grid.Column="0"/>

                                <TextBox x:Name="txtPDV"
                                         Text="{Binding PDV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Email" Style="{StaticResource SettingsLabel}" Grid.Row="5" Grid.Column="0"/>

                                <TextBox x:Name="txtEmail"
                                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="5"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Žiroračun" Style="{StaticResource SettingsLabel}" Grid.Row="6" Grid.Column="0"/>

                                <TextBox x:Name="txtZR"
                                         Text="{Binding ZR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="6"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="PDV obveznik" Style="{StaticResource SettingsLabel}" Grid.Row="7" Grid.Column="0"/>

                                <ComboBox x:Name="cmbPDV"
                                          SelectedIndex="{Binding PDVKorisnik, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="7"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="NE"/>
                                    <ComboBoxItem Content="DA"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- FBiH                                              -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaFBiHTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowFBIH, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <StackPanel HorizontalAlignment="Center"
                            Width="800"
                            Margin="0,20,0,35">

                    <TextBlock Text="Fiskalni server" Style="{StaticResource SettingsSectionTitle}"/>

                    <TextBlock Text="Podešavanja komunikacije sa Tring fiskalnim servisom."
                               Style="{StaticResource SettingsSectionDescription}"/>

                    <Border Style="{StaticResource SettingsCard}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <Label Content="IP adresa servera"
                                   Style="{StaticResource SettingsLabel}"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <TextBox x:Name="txtIpAddressTring"
                                     Text="{Binding TringServerIpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TextBoxCustom}"
                                     Foreground="{DynamicResource GlobalFontColor}"
                                     Background="Transparent"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="9"
                                     Height="30"
                                     BorderThickness="0,0,0,1"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- PORESKE STOPE                                     -->
                    <!-- ================================================= -->

                    <TextBlock Text="Poreske stope"
                               Style="{StaticResource SettingsSectionTitle}"
                               Margin="9,20,9,4"/>

                    <TextBlock Text="Poreske stope koje se koriste prilikom fiskalizacije računa."
                               Style="{StaticResource SettingsSectionDescription}"/>

                    <Border Style="{StaticResource SettingsCard}">

                        <StackPanel>

                            <DataGrid ItemsSource="{Binding PoreskeStope}"
                                      SelectedItem="{Binding SelectedPoreskaStopa, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      RowHeight="42"
                                      ColumnHeaderHeight="38"
                                      MinHeight="160"
                                      MaxHeight="280"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource GlobalFontColor}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="ID" Binding="{Binding IdStope}" Width="60"/>
                                    <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                                    <DataGridTextColumn Header="Postotak" Binding="{Binding Postotak, StringFormat={}{0:0.##}%}" Width="110"/>
                                    <DataGridTextColumn Header="Oznaka" Binding="{Binding Oznaka}" Width="100"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,15,0,0">

                                <Button Command="{Binding NewPoreskaStopaCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="120"
                                        Height="42"
                                        Margin="5">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE710;"
                                                   FontSize="16"
                                                   Margin="0,0,7,0"/>

                                        <TextBlock Text="Dodaj"/>

                                    </StackPanel>

                                </Button>

                                <Button Command="{Binding UpdatePoreskaStopaCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="120"
                                        Height="42"
                                        Margin="5">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE70F;"
                                                   FontSize="16"
                                                   Margin="0,0,7,0"/>

                                        <TextBlock Text="Izmijeni"/>

                                    </StackPanel>

                                </Button>

                                <Button Command="{Binding DeletePoreskaStopaCommand}"
                                        Style="{StaticResource DestructiveButtonStyle}"
                                        Width="120"
                                        Height="42"
                                        Margin="5">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE74D;"
                                                   FontSize="16"
                                                   Margin="0,0,7,0"/>

                                        <TextBlock Text="Obriši"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </TabItem>


            <!-- ================================================= -->
            <!-- REPUBLIKA SRPSKA                                  -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaRSTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowRS, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <!-- LPFR -->

                        <TextBlock Text="L-PFR" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Podešavanja komunikacije sa lokalnim fiskalnim procesorom."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="LPFR IP adresa" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtLPFRIP"
                                         Text="{Binding LPFRIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="LPFR API ključ" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtLPFRAPI"
                                         Text="{Binding LPFRKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="LPFR PIN" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <TextBox x:Name="txtLPFRPIN"
                                         Text="{Binding LPFRPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- ISPIS RAČUNA -->

                        <TextBlock Text="Ispis fiskalnog računa" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Podešavanja eksternog printera i širine termalne trake."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="LPFR eksterni printer" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <ComboBox x:Name="cmbExterniPrinter"
                                          SelectedIndex="{Binding ExterniPrinter, Mode=TwoWay}"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="NE"/>
                                    <ComboBoxItem Content="DA"/>

                                </ComboBox>

                                <Label Content="Širina trake" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <ComboBox x:Name="cmbSirinaTrake"
                                          SelectedValue="{Binding SirinaTrake, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          Foreground="{DynamicResource GlobalFontColor}"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="9"
                                          Width="150"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="57"/>
                                    <ComboBoxItem Content="80"/>

                                </ComboBox>

                            </Grid>

                        </Border>


                        <!-- PORESKE STOPE -->

                        <TextBlock Text="Poreske stope"
                                   Style="{StaticResource SettingsSectionTitle}"
                                   Margin="9,20,9,4"/>

                        <TextBlock Text="Poreske stope koje se koriste prilikom fiskalizacije računa."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <StackPanel>

                                <DataGrid ItemsSource="{Binding PoreskeStope}"
                                          SelectedItem="{Binding SelectedPoreskaStopa, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          RowHeight="42"
                                          ColumnHeaderHeight="38"
                                          MinHeight="160"
                                          MaxHeight="280"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource GlobalFontColor}">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="ID" Binding="{Binding IdStope}" Width="60"/>
                                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                                        <DataGridTextColumn Header="Postotak" Binding="{Binding Postotak, StringFormat={}{0:0.##}%}" Width="110"/>
                                        <DataGridTextColumn Header="Oznaka" Binding="{Binding Oznaka}" Width="100"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,15,0,0">

                                    <Button Command="{Binding NewPoreskaStopaCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Dodaj"/>
                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding UpdatePoreskaStopaCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Izmijeni"/>
                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding DeletePoreskaStopaCommand}"
                                            Style="{StaticResource DestructiveButtonStyle}"
                                            Width="120"
                                            Height="42"
                                            Margin="5">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" Margin="0,0,7,0"/>
                                            <TextBlock Text="Obriši"/>
                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>


            <!-- ================================================= -->
            <!-- HRVATSKA                                          -->
            <!-- ================================================= -->

            <TabItem x:Name="FiskalizacijaHrTab"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     Width="190"
                     BorderBrush="Transparent"
                     Visibility="{Binding ShowHR, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TabItem.Header>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Margin="6"
                                   FontSize="24"
                                   Width="30"
                                   Text="&#xEC5B;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Fiskalizacija"
                                   Foreground="{DynamicResource GlobalFontColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel HorizontalAlignment="Center"
                                Width="800"
                                Margin="0,20,0,35">

                        <!-- POREZNA UPRAVA -->

                        <TextBlock Text="Porezna uprava" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Adrese fiskalnih servisa Porezne uprave za demo i produkcijsko okruženje."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Demo Server URL" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtDemoUrl"
                                         Text="{Binding DemoServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Production Server URL" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtProdUrl"
                                         Text="{Binding ProductionServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                            </Grid>

                        </Border>

                        <Separator Margin="9,18"/>


                        <!-- NAPLATNI UREĐAJ -->

                        <TextBlock Text="Naplatni uređaj" Style="{StaticResource SettingsSectionTitle}"/>

                        <TextBlock Text="Oznake poslovnog prostora i naplatnog uređaja, način slijednosti računa i porez na potrošnju."
                                   Style="{StaticResource SettingsSectionDescription}"/>

                        <Border Style="{StaticResource SettingsCard}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Label Content="Poslovni prostor" Style="{StaticResource SettingsLabel}" Grid.Row="0" Grid.Column="0"/>

                                <TextBox x:Name="txtPoslovniProstor"
                                         Text="{Binding PoslovniProstor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource TextBoxCustom}"
                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Naplatni uređaj" Style="{StaticResource SettingsLabel}" Grid.Row="1" Grid.Column="0"/>

                                <TextBox x:Name="txtNaplatniUredjaj"
                                         Text="{Binding NaplatniUredjaj, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
