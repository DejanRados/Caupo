                                         Foreground="{DynamicResource GlobalFontColor}"
                                         Background="Transparent"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="9"
                                         Height="30"
                                         BorderThickness="0,0,0,1"/>

                                <Label Content="Oznaka slijednosti" Style="{StaticResource SettingsLabel}" Grid.Row="2" Grid.Column="0"/>

                                <ComboBox x:Name="cmbOznakaSlijednosti"
