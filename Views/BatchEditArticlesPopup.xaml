<Window x:Class="Caupo.Views.BatchEditArticlesPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grupno uređivanje artikala"
        Width="460"
        Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource GlobalBackgroundColor}"
        UseLayoutRounding="True">

    <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Background="Transparent" Padding="22">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Grupno uređivanje artikala"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="19"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="SelectedCountTextBlock"
                           Text="Označeno: 0 artikala"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="12"
                           Opacity="0.65"
                           Margin="0,3,0,0"/>

            </StackPanel>

            <StackPanel Grid.Row="2">

                <TextBlock Text="Promjena cijene"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <ComboBox x:Name="PriceOperationComboBox"
                          Height="38"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="PriceOperationComboBox_SelectionChanged">

                    <ComboBoxItem Content="Postavi cijenu"/>
                    <ComboBoxItem Content="Povećaj za %"/>
                    <ComboBoxItem Content="Smanji za %"/>

                </ComboBox>

            </StackPanel>

            <StackPanel Grid.Row="4">

                <TextBlock x:Name="ValueLabel"
                           Text="Nova cijena"
                           Foreground="{DynamicResource GlobalFontColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="ValueTextBox"  Style="{StaticResource TextBoxCustom}"
                         Height="38"
                         Foreground="{DynamicResource GlobalFontColor}"
                         CaretBrush="{DynamicResource GlobalFontColor}"
                         BorderThickness="0,0,0,1"
                         FontSize="16"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         Padding="6,0"/>

            </StackPanel>

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="42"
                        Content="Odustani"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        Height="42"
                        Content="Primijeni"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>